{
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "security-audit@security-audit": true,
    "superpowers@superpowers-marketplace": true,
    "impeccable@impeccable": true,
    "claude-mem@thedotmack": true,
    "task-observer@one-skill-to-rule-them-all": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      },
      "autoUpdate": true
    },
    "security-audit": {
      "source": {
        "source": "settings",
        "name": "security-audit",
        "plugins": [
          {
            "name": "security-audit",
            "source": {
              "source": "github",
              "repo": "cloudflare/security-audit-skill"
            }
          }
        ]
      },
      "autoUpdate": true
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      },
      "autoUpdate": true
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      },
      "autoUpdate": true
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      },
      "autoUpdate": true
    },
    "one-skill-to-rule-them-all": {
      "source": {
        "source": "github",
        "repo": "rebelytics/one-skill-to-rule-them-all"
      },
      "autoUpdate": true
    }
  }
}
