---
// One message and its thread, after Solaris' PostCard: who and what it is across the top, the words full width, a
// footer with when on the left and what you can do on the right, then the answers and (admin) a box to answer.
// Three views: the public list, the sender's private page ("owner"), and the admin's inbox.
// Behaviour (edit in place, ⌘/Ctrl+Enter, confirm, copy link): src/scripts/post.ts.
import type { Message } from '../lib/store';
import { REPLY_MAX, ago, day, linkify, plural } from '../lib/core';

interface Props {
  message: Message;
  mode: 'public' | 'owner' | 'admin';
  answerer: { name: string; photo: string | null };
  /** Admin forms come back here after posting. */
  back?: string;
  /** Unread when the inbox was opened (admin). */
  fresh?: boolean;
}
const { message: m, mode, answerer, back = '/admin', fresh = false } = Astro.props;
const admin = mode === 'admin';
const published = m.published_at !== null;
const permalink = `/p/${m.id}`;
const words = (text: string) => linkify(text);

// The one badge: what state it's in, told from the reader's side.
const badge = mode === 'public' ? null
  : published ? { text: 'Public', on: false, icon: 'eye' }
  : m.wants_public ? { text: admin ? 'Asks to be public' : 'Waiting to be published', on: admin, icon: 'clock' }
  : { text: 'Private', on: false, icon: 'lock' };
const icons: Record<string, string> = {
  eye: 'M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178ZM15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z',
  clock: 'M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  lock: 'M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z',
};
const act = 'inline-flex items-center gap-1.5 rounded-full px-2.5 h-8 text-sm text-zinc-500 hover:bg-(--well) hover:text-zinc-900 dark:hover:text-white transition-colors';
const field = 'w-full rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950/40 px-3.5 py-2.5 text-zinc-900 dark:text-white leading-relaxed focus:outline-none focus:border-blue-violet-500 transition-colors resize-none [field-sizing:content] min-h-11';
const primary = 'shrink-0 bg-blue-violet-600 dark:bg-blue-violet-400 text-white dark:text-zinc-950 text-sm font-semibold px-4 h-9 rounded-full hover:bg-blue-violet-700 dark:hover:bg-blue-violet-300 disabled:opacity-40 disabled:cursor-not-allowed transition-colors';
---
<article id={`m-${m.id}`} class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-night-surface p-5 sm:p-6" data-post>
  <header class="flex items-center gap-3">
    <span class="w-10 h-10 shrink-0 rounded-full bg-(--well) text-zinc-500 dark:text-zinc-400 grid place-items-center" aria-hidden="true">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.27-1 .86-1 1.52V14m0 3h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
    </span>
    <div class="min-w-0 flex-1">
      <p class="font-medium text-zinc-900 dark:text-white leading-tight">Anonymous</p>
      <p class="text-xs text-zinc-500 mt-0.5">
        {admin ? <time datetime={new Date(m.created_at * 1000).toISOString()} title={day(m.created_at)}>{ago(m.created_at)}</time> : <>wrote on {day(m.created_at)}</>}
      </p>
    </div>
    <div class="flex shrink-0 items-center gap-2">
      {fresh && <span class="text-[11px] font-medium uppercase tracking-widest">New</span>}
      {badge && (
        <span class:list={['inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium', badge.on ? 'bg-(--on-bg) text-(--on-text)' : 'bg-(--well) text-zinc-600 dark:text-zinc-300']}>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[badge.icon]} /></svg>
          {badge.text}
        </span>
      )}
    </div>
  </header>

  <p class="mt-4 text-[17px] leading-relaxed text-zinc-800 dark:text-zinc-200 whitespace-pre-line break-words">{words(m.body).map((part) => 'url' in part
    ? <a href={part.url} target="_blank" rel="nofollow ugc noopener noreferrer" class="text-blue-violet-600 dark:text-blue-violet-400 underline decoration-blue-violet-500/30 hover:decoration-blue-violet-500 underline-offset-4 break-all">{part.url}</a>
    : part.text)}</p>

  <!-- When on the left, what you can do on the right. -->
  <footer class="mt-3 flex items-center justify-between gap-3 -mx-2.5">
    <div class="flex items-center gap-1">
      {admin && (
        <>
          {m.wants_public && !published && (
            <form method="post" action="/admin">
              <input type="hidden" name="action" value="publish" /><input type="hidden" name="id" value={m.id} /><input type="hidden" name="back" value={back} />
              <button class={`${act} !text-blue-violet-600 dark:!text-blue-violet-400 hover:!bg-(--on-bg)`}>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                Publish
              </button>
            </form>
          )}
          {published && (
            <form method="post" action="/admin">
              <input type="hidden" name="action" value="unpublish" /><input type="hidden" name="id" value={m.id} /><input type="hidden" name="back" value={back} />
              <button class={act}>Unpublish</button>
            </form>
          )}
          <form method="post" action="/admin">
            <input type="hidden" name="action" value="delete" /><input type="hidden" name="id" value={m.id} /><input type="hidden" name="back" value={back} />
            <button class={`${act} hover:!text-red-600 dark:hover:!text-red-400`} data-confirm="Delete this message and its answers for good? The sender’s private link stops working.">Delete</button>
          </form>
        </>
      )}
      {!admin && (published
        ? <a href={permalink} class="px-2.5 text-xs text-zinc-500 hover:text-blue-violet-600 dark:hover:text-blue-violet-400 transition-colors">{mode === 'owner' ? 'See it on the public page' : `Published ${day(m.published_at!)}`}</a>
        : <span class="px-2.5 text-xs text-zinc-500">Only you and {answerer.name} can see this</span>)}
    </div>
    <div class="flex items-center gap-1">
      <span class={`${act} hover:!bg-transparent hover:!text-zinc-500 cursor-default`} title={plural(m.replies.length, 'answer')}>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.501 48.172 48.172 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" /></svg>
        <span class="tabular-nums">{m.replies.length}</span>
        <span class="sr-only">{m.replies.length === 1 ? 'answer' : 'answers'}</span>
      </span>
      {published && (
        <button type="button" class={act} data-copy={permalink} aria-label="Copy a link to this message" title="Copy link">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" /></svg>
        </button>
      )}
    </div>
  </footer>

  {(m.replies.length > 0 || admin) && (
    <div class:list={['mt-4', { 'border-t border-zinc-100 dark:border-zinc-800 pt-4': m.replies.length > 0 }]}>
      {m.replies.length > 0 && (
        <ul class="flex flex-col gap-4" id={`answers-${m.id}`}>
          {m.replies.map((r) => (
            <li id={`r-${r.id}`} class="flex gap-3" data-reply>
              {answerer.photo
                ? <img src={answerer.photo} alt="" width="32" height="32" loading="lazy" referrerpolicy="no-referrer" class="w-8 h-8 rounded-full object-cover shrink-0" />
                : <span class="w-8 h-8 rounded-full bg-(--on-bg) text-(--on-text) text-xs font-semibold grid place-items-center shrink-0" aria-hidden="true">{answerer.name.charAt(0)}</span>}
              <div class="min-w-0 flex-1">
                <p class="text-sm flex flex-wrap items-baseline gap-x-2">
                  <span class="font-medium text-zinc-900 dark:text-white">{answerer.name}</span>
                  <time class="text-xs text-zinc-500" datetime={new Date(r.created_at * 1000).toISOString()}>{admin ? ago(r.created_at) : day(r.created_at)}</time>
                  {r.edited_at && <span class="text-xs text-zinc-400 dark:text-zinc-500">· edited</span>}
                </p>
                <div data-view>
                  <p class="mt-0.5 text-zinc-700 dark:text-zinc-300 leading-relaxed whitespace-pre-line break-words">{words(r.body).map((part) => 'url' in part
                    ? <a href={part.url} target="_blank" rel="nofollow ugc noopener noreferrer" class="text-blue-violet-600 dark:text-blue-violet-400 underline decoration-blue-violet-500/30 hover:decoration-blue-violet-500 underline-offset-4 break-all">{part.url}</a>
                    : part.text)}</p>
                  {admin && (
                    <div class="mt-1 flex items-center gap-4 text-sm">
                      <button type="button" class="text-zinc-500 hover:text-zinc-900 dark:hover:text-white transition-colors" data-edit>Edit</button>
                      <form method="post" action="/admin" class="inline-flex">
                        <input type="hidden" name="action" value="delete-reply" /><input type="hidden" name="id" value={r.id} /><input type="hidden" name="back" value={back} />
                        <button class="text-zinc-500 hover:text-red-600 dark:hover:text-red-400 transition-colors" data-confirm="Delete this answer?">Delete</button>
                      </form>
                    </div>
                  )}
                </div>
                {admin && (
                  <form method="post" action="/admin" data-editor hidden class="mt-1.5 flex flex-col gap-2">
                    <input type="hidden" name="action" value="edit-reply" /><input type="hidden" name="id" value={r.id} /><input type="hidden" name="back" value={back} />
                    <textarea name="body" required maxlength={REPLY_MAX} aria-label="Edit your answer" class={field}>{r.body}</textarea>
                    <div class="flex items-center gap-1">
                      <button class={primary} data-submit="Saving…">Save</button>
                      <button type="button" class="text-sm font-medium text-zinc-500 hover:text-zinc-900 dark:hover:text-white px-3 h-9 rounded-full transition-colors" data-cancel>Cancel</button>
                    </div>
                  </form>
                )}
              </div>
            </li>
          ))}
        </ul>
      )}

      {admin && (
        <form method="post" action="/admin" class:list={['flex items-end gap-2.5', { 'mt-4': m.replies.length > 0 }]}>
          <input type="hidden" name="action" value="reply" /><input type="hidden" name="id" value={m.id} /><input type="hidden" name="back" value={`${back}#m-${m.id}`} />
          {answerer.photo
            ? <img src={answerer.photo} alt="" width="32" height="32" referrerpolicy="no-referrer" class="w-8 h-8 mb-1.5 rounded-full object-cover shrink-0" />
            : <span class="w-8 h-8 mb-1.5 rounded-full bg-(--on-bg) text-(--on-text) text-xs font-semibold grid place-items-center shrink-0" aria-hidden="true">{answerer.name.charAt(0)}</span>}
          <textarea name="body" rows="1" required maxlength={REPLY_MAX} aria-label="Write an answer"
            placeholder={published ? 'Answer publicly…' : m.wants_public ? 'Answer (public once you publish)…' : 'Answer privately…'}
            class={`${field} min-w-0 flex-1`}></textarea>
          <button class={`${primary} mb-1`} data-submit="Sending…">Send</button>
        </form>
      )}
    </div>
  )}
</article>
