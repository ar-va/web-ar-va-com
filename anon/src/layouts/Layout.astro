---
// anon's pages on the shared ARVA layout (shared/layouts/Layout.astro), with what anon adds: a minimal header (no
// account link: nobody logs in here) labelled "anon", the Inbox link for the admin, a same-origin referrer policy on every
// page (private links carry their secret in the address), noindex where asked and a <main> landmark.
import Base from '@shared/layouts/Layout.astro';
import '../styles/anon.css';

interface Props {
  title: string;
  description?: string;
  /** Private links and the inbox: kept out of search engines. */
  noindex?: boolean;
  admin?: boolean;
}
const { title, description, noindex = false, admin = false } = Astro.props;
const path = Astro.url.pathname;
---
<Base title={title} description={description} noindex={noindex} header={{ label: 'anon', home: '/', minimal: true }}>
  <!-- Private links carry their secret in the address: never pass it on to another site. "same-origin", not
       "no-referrer": with no-referrer browsers send form posts with `Origin: null`, which Astro refuses as cross-site
       (403), so nobody could send a message (found 2026-11-20). -->
  <meta slot="head" name="referrer" content="same-origin" />
  {admin && (
    <a slot="header-actions" href="/admin" aria-current={path.startsWith('/admin') ? 'page' : undefined}
      class="flex items-center gap-1.5 h-8 text-zinc-600 dark:text-zinc-300 hover:text-kikyo-600 dark:hover:text-kikyo-400 aria-[current=page]:text-kikyo-600 dark:aria-[current=page]:text-kikyo-400 transition-colors">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859M2.25 13.5V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.5M2.25 13.5l2.4-7.2A2.25 2.25 0 0 1 6.784 4.5h10.432a2.25 2.25 0 0 1 2.134 1.8l2.4 7.2" /></svg>
      Inbox
    </a>
  )}
  <main class="flex-grow flex flex-col">
    <slot />
  </main>
</Base>
