---
import Layout from '../layouts/Layout.astro';
Astro.response.status = 404;
---
<Layout title="Not found · anon.ar-va.com" noindex>
  <div class="max-w-3xl mx-auto px-6 w-full py-20 text-center flex flex-col items-center gap-3">
    <p class="text-xs font-medium tracking-widest uppercase">Not found</p>
    <h1 class="text-4xl font-bold text-zinc-900 dark:text-white">Nothing here</h1>
    <p class="text-zinc-600 dark:text-zinc-400 max-w-md text-pretty">If this was your private link, the message may have been deleted, or the link was copied only in part.</p>
    <a href="/" class="mt-3 inline-flex items-center bg-blue-violet-600 dark:bg-blue-violet-400 text-white dark:text-zinc-950 text-sm font-semibold px-5 h-10 rounded-full hover:bg-blue-violet-700 dark:hover:bg-blue-violet-300 transition-colors">Write a message</a>
  </div>
</Layout>
