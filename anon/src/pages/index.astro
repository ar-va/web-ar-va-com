---
// The hero is one line to write in, like a search page, opening into the whole form when you start: anyone can send a
// message with no name and no account. Below it, the messages their senders asked to make public and the admin
// published, with the answers (masonry), then the promises and the privacy FAQ.
// Why it looks and reads this way: docs/trust-principles.md (keep the page consistent with it).
//
// Sending reads nothing about the sender: not cookies, not the browser. The connection's address is handed to
// Cloudflare's rate limiter (in memory, not stored) and dropped.
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import Post from '../components/Post.astro';
import { BODY_MAX, cleanText, plural } from '../lib/core';
import { PAGE_SIZE, answerStats, createMessage, publishedPage, recentCount } from '../lib/store';
import { SOURCE_URL } from '../site';
import { answerer as getAnswerer, currentAdmin } from '../lib/admin';
import { newMessageNotice } from '../lib/notify';

/** Everyone together, per hour: beyond this the site asks people to come back later (a flood, not a person). */
const HOURLY_CEILING = 120;

let error: string | null = null;
let draft = { body: '', visibility: 'private' };

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  draft = {
    body: String(form.get('body') ?? ''),
    visibility: form.get('visibility') === 'public' ? 'public' : 'private',
  };
  const body = cleanText(draft.body);
  const ip = Astro.request.headers.get('cf-connecting-ip') ?? 'local';
  if (String(form.get('website') ?? '') !== '') {
    // The hidden field people never see: only form-filling robots type into it. Pretend it worked.
    return Astro.redirect('/', 303);
  } else if (!body) {
    error = 'Write something first.';
  } else if (body.length > BODY_MAX) {
    error = `That’s ${body.length} characters; the limit is ${BODY_MAX}. Could you shorten it, or send it in two parts?`;
  } else if (!(await env.SEND_LIMIT.limit({ key: ip })).success || (await recentCount()) >= HOURLY_CEILING) {
    error = 'Too many messages at once. Please wait a minute and send it again.';
    Astro.response.status = 429;
  } else {
    const { id, token } = await createMessage(body, draft.visibility === 'public');
    Astro.locals.cfContext.waitUntil(newMessageNotice({ id, body, wantsPublic: draft.visibility === 'public' }, Astro.url.origin));
    return Astro.redirect(`/m/${token}?sent`, 303);
  }
  if (Astro.response.status === 200) Astro.response.status = 400;
}

const page = Math.max(1, Math.min(10_000, Number(Astro.url.searchParams.get('page')) || 1));
const [{ messages, total }, admin, answerer, stats] = await Promise.all([publishedPage(page), currentAdmin(Astro.cookies), getAnswerer(), answerStats()]);
const pages = Math.max(1, Math.ceil(total / PAGE_SIZE));
const deleted = Astro.url.searchParams.has('deleted');

/** "within a few hours", "within a day", "within 3 days": the real median, rounded up, in plain words. */
const within = (s: number) => s < 6 * 3600 ? 'within a few hours' : s < 36 * 3600 ? 'within a day' : `within ${Math.ceil(s / 86400)} days`;

const promises = [
  { title: 'I won’t try to find out who you are', text: 'No tracking, no guessing out loud, no asking around.' },
  { title: 'I won’t share what you sent privately', text: 'Not as a screenshot, not as a quote. Only what you asked to make public, and only if I publish it.' },
  { title: 'No tricks', text: 'No made-up messages, no “see who sent this”, no notifications to pull you back, nothing to pay for.' },
  { title: 'Some things I won’t publish', text: 'Anything that names or exposes someone else, threatens or demeans, or was written to hurt. I still read it; it stays private.' },
];
const faq = [
  { q: 'What does the site keep?', a: [
    'Your words, the date, whether you asked to make it public, and a scrambled form of your private link’s code (so not even the database can rebuild your link).',
    'Nothing else: no name, no email, no account, no IP address, no browser or device details, no tracking cookies.',
  ] },
  { q: `Can ${answerer.name} find out who I am?`, a: [
    'Not from anything the site stores. Your words are the one thing that can: if you mention details only you would know, or write the way you always write, I might recognize you. Leave those out if it matters.',
    'To stop floods, your connection’s address is checked against a limit of five messages a minute, in memory, and never written down. If you are logged in on music.ar-va.com, your browser sends that login here too, as it does to every ar-va.com page; this page ignores it and stores nothing from it.',
  ] },
  { q: 'Can I check any of this?', a: [
    'Yes. The site’s code is public on GitHub, and the site is built and deployed from it automatically, so what you read there is what runs here.',
  ], link: { href: SOURCE_URL, text: 'See the code →' } },
  { q: 'How will I know you answered?', a: [
    'Come back to your private link. There’s no email or notification on purpose: any contact detail would be a thread back to you.',
  ] },
  { q: 'What gets published?', a: [
    'Only messages whose writer asked for it, and only after I have read them. They appear exactly as written, with my answer underneath. I can’t edit your words, only publish them or not.',
  ] },
  { q: 'Can I take it back?', a: [
    'Yes. Your private link lets you make it private again (it leaves this page at once) or delete it and my answers for good.',
  ] },
];
---
<Layout title="anon.ar-va.com: tell me anything" description="Write to me, or about me, with no name and no account. Something you want to get off your chest, something personal, or just something to share." admin={!!admin}>
  <!-- Like a search page: the title, one line to write in, then one sentence on what reaches me and where the answer
       comes back. The line opens as soon as you start (anon.css: focus or text), so who can see it and what publishing
       means come exactly when they matter; the helpline is on the private page (docs/trust-principles.md). -->
  <section class="max-w-2xl mx-auto px-6 w-full pt-16 sm:pt-28 pb-16 sm:pb-20 text-center">
    <h1 class="text-5xl sm:text-7xl font-bold tracking-tight text-zinc-900 dark:text-white leading-[1.05] text-balance">Tell me anything</h1>

    <form method="post" id="write" tabindex="-1" class="compose-form mt-8 sm:mt-10 text-left outline-none" data-compose>
      {deleted && <p class="mb-4 rounded-xl bg-(--well) px-4 py-3 text-sm text-zinc-700 dark:text-zinc-300" role="status">Your message and its answers are deleted.</p>}
      <label for="body" class="sr-only">Your message</label>
      <!-- One line that grows with what's written, Send inside it (like a chat box). -->
      <div class="compose flex items-end gap-2 pr-2">
        <textarea id="body" name="body" required maxlength={BODY_MAX} rows="1" autofocus={!!error}
          placeholder="Write freely"
          aria-describedby={error ? 'send-error body-count' : 'body-count'}
          class="block flex-1 min-w-0 bg-transparent pl-5 py-3.5 text-[17px] leading-relaxed text-zinc-900 dark:text-white placeholder:text-zinc-400 dark:placeholder:text-zinc-500 focus:outline-none resize-none max-h-[60vh]">{draft.body}</textarea>
        <button aria-label="Send anonymously" title="Send anonymously" data-send
          class="shrink-0 mb-2 w-10 h-10 rounded-full grid place-items-center bg-blue-violet-600 dark:bg-blue-violet-400 text-white dark:text-zinc-950 hover:bg-blue-violet-700 dark:hover:bg-blue-violet-300 disabled:opacity-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-violet-500 transition-colors">
          <svg class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" /></svg>
        </button>
      </div>

      <!-- Shown once someone starts (anon.css): who sees it, and what publishing means. -->
      <div class="open-only">
        <div class="mt-3 px-2 flex flex-col gap-3">
          {error && <p id="send-error" class="text-sm text-red-600 dark:text-red-400" role="alert">{error}</p>}
          <fieldset class="visibility">
            <legend class="sr-only">Who can see it</legend>
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex flex-wrap gap-1.5">
                <label class="choice rounded-full h-8 px-3 inline-flex items-center gap-1.5 text-sm cursor-pointer">
                  <input type="radio" name="visibility" value="private" checked={draft.visibility !== 'public'} class="sr-only" />
                  <svg class="w-4 h-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" /></svg>
                  <span class="choice-title text-zinc-700 dark:text-zinc-300">Only me</span>
                </label>
                <label class="choice rounded-full h-8 px-3 inline-flex items-center gap-1.5 text-sm cursor-pointer">
                  <input type="radio" name="visibility" value="public" checked={draft.visibility === 'public'} class="sr-only" />
                  <svg class="w-4 h-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" /></svg>
                  <span class="choice-title text-zinc-700 dark:text-zinc-300">Ask to make it public</span>
                </label>
              </div>
              <p id="body-count" class="text-xs text-zinc-400 dark:text-zinc-500 tabular-nums" aria-live="polite" data-count={BODY_MAX}>{BODY_MAX} left</p>
            </div>
            <!-- What publishing means, said at the moment of choosing it (works without script). -->
            <p class="public-note mt-2 rounded-xl bg-(--well) px-4 py-3 text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed text-pretty">
              I read it first; if I publish it, it appears below with my answer. Then anyone can read it word for word, and
              people who know you might recognize how you write. You can make it private again from your private link.
            </p>
          </fieldset>
        </div>
      </div>

      <!-- Only robots fill this in. -->
      <div class="hidden" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>
    </form>

    <!-- What reaches me and where the answer comes back, said once and plainly (no "fully anonymous": the words
         themselves can give someone away, which the FAQ says). -->
    <p class="mt-6 text-zinc-600 dark:text-zinc-400 text-pretty">No name, no account, no tracking.<br />Read my answer through your private link, or below if you choose to make it public.</p>
    <p class="mt-2 text-sm">
      <a href="#how-anonymous" class="font-medium text-blue-violet-600 dark:text-blue-violet-400 hover:text-zinc-900 dark:hover:text-white transition-colors">How anonymous is this?</a>
      <span class="text-zinc-400 dark:text-zinc-600" aria-hidden="true"> · </span>
      <a href={SOURCE_URL} class="font-medium text-blue-violet-600 dark:text-blue-violet-400 hover:text-zinc-900 dark:hover:text-white transition-colors">Read the code</a>
    </p>
  </section>

  <section id="answered" class="w-full border-t border-zinc-200/70 dark:border-zinc-800/70 bg-zinc-100/60 dark:bg-zinc-950">
    <div class="max-w-5xl mx-auto px-6 w-full py-14 sm:py-16">
      <div class="mb-6">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h2 class="text-3xl font-bold text-zinc-900 dark:text-white">Answered in public</h2>
          {total > 0 && <p class="text-sm text-zinc-500">{plural(total, 'message')}{pages > 1 && ` · page ${page} of ${pages}`}</p>}
        </div>
        <p class="mt-2 max-w-3xl text-zinc-600 dark:text-zinc-400 text-pretty">
          Shared by the people who wrote them and published word for word after I read them.
          {stats.medianSeconds !== null && <> I’ve answered {plural(stats.answered, 'message')} so far, usually {within(stats.medianSeconds)}.</>}
        </p>
      </div>
      <!-- Masonry: CSS columns, newest first down each column. -->
      {messages.length > 0 ? (
        <div class="columns-1 md:columns-2 lg:columns-3 gap-5">
          {messages.map((m) => <div class="break-inside-avoid mb-5"><Post message={m} mode={admin ? 'admin' : 'public'} answerer={answerer} back={`/?page=${page}`} /></div>)}
        </div>
      ) : (
        <div class="rounded-2xl border border-dashed border-zinc-300 dark:border-zinc-700 px-6 py-12 text-center">
          <p class="font-medium text-zinc-900 dark:text-white">{page > 1 ? 'Nothing on this page.' : 'Nothing public yet.'}</p>
          <p class="mt-1 text-zinc-600 dark:text-zinc-400 text-pretty">When someone asks to share their message and I answer it, it appears here. No made-up examples in the meantime.</p>
        </div>
      )}
      {pages > 1 && (
        <nav class="mt-8 flex items-center justify-between text-sm font-medium" aria-label="More messages">
          {page > 1 ? <a href={page === 2 ? '/#answered' : `/?page=${page - 1}#answered`} class="ctl">← Newer</a> : <span />}
          {page < pages ? <a href={`/?page=${page + 1}#answered`} class="ctl">Older →</a> : <span />}
        </nav>
      )}
    </div>
  </section>

  <section id="promises" class="max-w-3xl mx-auto px-6 w-full pt-14 sm:pt-16">
    <p class="text-xs font-medium tracking-widest uppercase mb-3">House rules</p>
    <h2 class="text-3xl font-bold text-zinc-900 dark:text-white mb-6">What I promise</h2>
    <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-6" role="list">
      {promises.map((p, i) => (
        <li class="flex gap-3.5">
          <span class="shrink-0 font-mono text-sm text-zinc-400 dark:text-zinc-500 pt-0.5 tabular-nums" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span>
            <span class="block font-medium text-zinc-900 dark:text-white">{p.title}</span>
            <span class="block mt-1 text-zinc-600 dark:text-zinc-400 leading-relaxed text-pretty">{p.text}</span>
          </span>
        </li>
      ))}
    </ul>
  </section>

  <section id="how-anonymous" class="max-w-3xl mx-auto px-6 w-full py-14 sm:py-16">
    <p class="text-xs font-medium tracking-widest uppercase mb-3">Privacy</p>
    <h2 class="text-3xl font-bold text-zinc-900 dark:text-white mb-6">How anonymous is this?</h2>
    <div class="flex flex-col gap-2.5">
      {faq.map((f) => (
        <details class="group rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-night-surface px-5 py-4">
          <summary class="cursor-pointer list-none flex items-center justify-between gap-3 font-medium text-zinc-900 dark:text-white [&::-webkit-details-marker]:hidden">
            {f.q}
            <svg class="w-4 h-4 shrink-0 text-zinc-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
          </summary>
          <div class="mt-3 flex flex-col gap-2.5 text-zinc-600 dark:text-zinc-400 leading-relaxed text-pretty">
            {f.a.map((p) => <p>{p}</p>)}
            {f.link && <a href={f.link.href} class="self-start font-medium text-blue-violet-600 dark:text-blue-violet-400 hover:text-zinc-900 dark:hover:text-white transition-colors">{f.link.text}</a>}
          </div>
        </details>
      ))}
    </div>
  </section>
</Layout>

<style>
  /* The note about publishing shows only while "Ask to make it public" is picked (no script needed). */
  .visibility:not(:has(input[value='public']:checked)) .public-note { display: none; }
</style>

<script>
  import '../scripts/post.ts';
  const box = document.querySelector<HTMLTextAreaElement>('#body');
  const count = document.querySelector<HTMLElement>('#body-count');
  if (box && count) {
    // Characters left, counted the way the server counts them (after trimming). Calm until it matters.
    const max = Number(count.dataset.count);
    const show = () => {
      const left = max - box.value.trim().length;
      count.textContent = left >= 0 ? `${left} left` : `${-left} over`;
      count.classList.toggle('!text-red-600', left < 0);
    };
    box.addEventListener('input', show);
    show();


    // Browsers without `field-sizing: content` (anon.css) grow the box by script.
    if (!CSS.supports('field-sizing', 'content')) {
      const grow = () => { box.style.height = 'auto'; box.style.height = `${box.scrollHeight}px`; };
      box.addEventListener('input', grow);
      grow();
    }
    // One send per press: the button turns off once the form goes.
    const send = document.querySelector<HTMLButtonElement>('[data-send]');
    box.form?.addEventListener('submit', () => setTimeout(() => { if (send) send.disabled = true; }));
  }
</script>
