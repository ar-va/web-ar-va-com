---
// One joint of the leaf, zoomed in (story page): the tip lobe and the notch before it touch at one point, where both
// curves head the same way, so the outline has no corner there. Drawn from the logo file's own circles.
import { contact, type Leaf } from '../lib/leaf';

interface Props {
  leaf: Leaf;
  label: string;
}
const { leaf, label } = Astro.props;
const i = leaf.circles.reduce((best, c, n, all) => (c.r > all[best].r ? n : best), 0);
const lobe = leaf.circles[i];
const notch = leaf.circles[(i - 1 + leaf.circles.length) % leaf.circles.length];
const [px, py] = contact(lobe, notch);
// The shared tangent: at right angles to the line through both centres.
const d = Math.hypot(lobe.cx - notch.cx, lobe.cy - notch.cy);
const tx = -(lobe.cy - notch.cy) / d, ty = (lobe.cx - notch.cx) / d, reach = 13;
const pad = 4;
const x0 = Math.min(notch.cx - notch.r, lobe.cx - lobe.r) - pad, x1 = Math.max(notch.cx + notch.r, lobe.cx + lobe.r) + pad;
const y0 = Math.min(notch.cy - notch.r, lobe.cy - lobe.r) - pad, y1 = Math.max(notch.cy + notch.r, lobe.cy + lobe.r) + pad;
const ns = { 'vector-effect': 'non-scaling-stroke', fill: 'none' };
---
<svg viewBox={`${x0} ${y0} ${x1 - x0} ${y1 - y0}`} role="img" aria-label={label} class="block w-full h-auto">
  <path d={leaf.path} class="fill-kashiwa/10 dark:fill-kashiwa-light/10" />
  <circle cx={lobe.cx} cy={lobe.cy} r={lobe.r} class="stroke-kashiwa dark:stroke-kashiwa-light" stroke-width="1.75" {...ns} />
  <circle cx={notch.cx} cy={notch.cy} r={notch.r} class="stroke-zinc-900 dark:stroke-zinc-100" stroke-width="1.25" stroke-dasharray="4 3" {...ns} />
  <path d={`M${notch.cx} ${notch.cy}L${lobe.cx} ${lobe.cy}`} class="stroke-zinc-500" stroke-width="1" {...ns} />
  <path d={`M${px - tx * reach} ${py - ty * reach}L${px + tx * reach} ${py + ty * reach}`} class="stroke-kashiwa dark:stroke-kashiwa-light" stroke-width="1.25" {...ns} />
  <circle cx={notch.cx} cy={notch.cy} r="0.6" class="fill-zinc-900 dark:fill-zinc-100" />
  <circle cx={lobe.cx} cy={lobe.cy} r="0.6" class="fill-kashiwa dark:fill-kashiwa-light" />
  <circle cx={px} cy={py} r="1" class="fill-zinc-50 dark:fill-zinc-950 stroke-kashiwa dark:stroke-kashiwa-light" stroke-width="1.5" vector-effect="non-scaling-stroke" />
</svg>
