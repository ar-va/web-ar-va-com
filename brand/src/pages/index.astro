---
// brand.ar-va.com: ARVA's design language for people and AI tools. Everything on it comes from the brand kit beside
// this site (the rules, the tokens, the logo and avatar files), so the page can't disagree with them.
import Layout from '@shared/layouts/Layout.astro';
import BrandNav from '../components/BrandNav.astro';
import { Content as Rules } from '../../ARVA-brand-rules.md';
import tokensCss from '../../arva-tokens.css?raw';
import { SITE, colourTokens, kitFiles } from '../lib/files';

const tokens = colourTokens(tokensCss);
const named = ['kikyo', 'kashiwa', 'bengara'].map((n) => tokens.find((t) => t.name === n)!);
const others = tokens.filter((t) => !named.includes(t));
const title = { kikyo: 'Kikyō', kashiwa: 'Kashiwa', bengara: 'Bengara' } as Record<string, string>;
const logos = kitFiles('logo');
const avatars = kitFiles('avatars');
// Ink files are drawn for light grounds, washi files for dark ones.
const ground = (f: string) => (f.includes('washi') ? 'bg-zinc-950' : 'bg-zinc-50');
const prompt = `Follow ARVA's design language. Read ${SITE}/ARVA-brand-rules.md and treat every rule as a requirement; use the CSS variables in ${SITE}/arva-tokens.css; take logo files from ${SITE}/llms.txt.`;
---
<Layout title="ARVA design language" description="The rules every ARVA product follows: the oak-leaf logo, three colours, the type and the voice, as a page for people and plain files for AI tools." header={{ label: 'brand', home: '/', minimal: true }}>
  <BrandNav slot="header-actions" />
  <main class="max-w-5xl mx-auto px-6 w-full pt-12 pb-24">
    <h1 class="font-bold text-3xl sm:text-4xl text-zinc-900 dark:text-white">ARVA design language</h1>
    <p class="mt-4 max-w-3xl text-lg text-zinc-600 dark:text-zinc-400 text-pretty">
      The rules every ARVA product follows: the oak-leaf logo, three colours with one job each, the type and the voice.
      Designers and AI tools work from the same files, so a page built by either looks like ARVA. <a class="text-kikyo-600 dark:text-kikyo-400 underline underline-offset-3 hover:text-zinc-900 dark:hover:text-white" href="/story">Read what ARVA makes and what the leaf stands for</a>.
    </p>

    <section class="mt-12 max-w-3xl rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-night-surface p-6" aria-labelledby="for-ai">
      <h2 id="for-ai" class="font-bold text-xl text-zinc-900 dark:text-white">For AI tools</h2>
      <p class="mt-2 text-zinc-600 dark:text-zinc-400">Give an AI this instruction, or the links below. They are plain text, so any tool that reads the web can use them.</p>
      <pre class="mt-4 p-4 rounded-lg bg-zinc-100 dark:bg-zinc-900 text-sm font-mono whitespace-pre-wrap text-zinc-800 dark:text-zinc-200">{prompt}</pre>
      <ul class="mt-4 space-y-1.5">
        <li><a class="text-kikyo-600 dark:text-kikyo-400 underline underline-offset-3 hover:text-zinc-900 dark:hover:text-white" href="/ARVA-brand-rules.md">ARVA-brand-rules.md</a> <span class="text-zinc-500">every rule, as Markdown</span></li>
        <li><a class="text-kikyo-600 dark:text-kikyo-400 underline underline-offset-3 hover:text-zinc-900 dark:hover:text-white" href="/arva-tokens.css">arva-tokens.css</a> <span class="text-zinc-500">colours, fonts and spacing as CSS variables</span></li>
        <li><a class="text-kikyo-600 dark:text-kikyo-400 underline underline-offset-3 hover:text-zinc-900 dark:hover:text-white" href="/llms.txt">llms.txt</a> <span class="text-zinc-500">the index, with every logo file</span></li>
      </ul>
    </section>

    <section class="mt-16" aria-labelledby="colour">
      <h2 id="colour" class="font-bold text-2xl text-zinc-900 dark:text-white">Colour</h2>
      <p class="mt-2 max-w-3xl text-zinc-600 dark:text-zinc-400">Three named colours, each with one job. Every token has a light and a dark value.</p>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {named.map((t) => (
          <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 overflow-hidden">
            <div class="grid grid-cols-2 h-24">
              <span style={`background:${t.light}`}></span>
              <span style={`background:${t.dark}`}></span>
            </div>
            <div class="p-4">
              <h3 class="font-bold text-xl text-zinc-900 dark:text-white">{title[t.name]}</h3>
              <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{t.note.replace(/^[^:]*:\s*(.)/, (_, c) => c.toUpperCase())}</p>
              <p class="mt-2 text-sm font-mono text-zinc-500">--{t.name} {t.light} / {t.dark}</p>
            </div>
          </div>
        ))}
      </div>
      <ul class="mt-6 grid gap-x-6 gap-y-3 sm:grid-cols-2">
        {others.map((t) => (
          <li class="flex items-center gap-3">
            <span class="shrink-0 grid grid-cols-2 w-14 h-8 rounded-md overflow-hidden border border-zinc-200 dark:border-zinc-800" aria-hidden="true">
              <span style={`background:${t.light}`}></span><span style={`background:${t.dark}`}></span>
            </span>
            <span class="min-w-0 text-sm">
              <span class="font-mono text-zinc-900 dark:text-zinc-200">--{t.name}</span>
              <span class="font-mono text-zinc-500"> {t.light} / {t.dark}</span>
              {t.note && <span class="block text-zinc-500 truncate" title={t.note}>{t.note}</span>}
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-16" aria-labelledby="type">
      <h2 id="type" class="font-bold text-2xl text-zinc-900 dark:text-white">Type</h2>
      <div class="mt-6 divide-y divide-zinc-200 dark:divide-zinc-800 border-y border-zinc-200 dark:border-zinc-800">
        <div class="py-6 grid gap-2 sm:grid-cols-[12rem_1fr] sm:items-baseline">
          <p class="text-sm text-zinc-500">Brygada 1918, 600<br />titles</p>
          <p class="font-heading font-semibold text-4xl text-zinc-900 dark:text-white text-balance">Chet Baker Sings<br />Группа крови</p>
        </div>
        <div class="py-6 grid gap-2 sm:grid-cols-[12rem_1fr] sm:items-baseline">
          <p class="text-sm text-zinc-500">IBM Plex Sans, 400 and 500<br />text, controls, labels</p>
          <p class="text-lg max-w-2xl text-zinc-800 dark:text-zinc-200">Short, plain sentences. Concrete nouns. <span class="font-medium">Medium for emphasis</span>, never bold body text. Кириллица тоже.</p>
        </div>
        <div class="py-6 grid gap-2 sm:grid-cols-[12rem_1fr] sm:items-baseline">
          <p class="text-sm text-zinc-500">IBM Plex Mono, 400<br />aligned numbers, code</p>
          <p class="font-mono text-zinc-800 dark:text-zinc-200">A1 4:52 &nbsp; B2 11:06 &nbsp; --kikyo</p>
        </div>
      </div>
    </section>

    <section class="mt-16" aria-labelledby="logos">
      <h2 id="logos" class="font-bold text-2xl text-zinc-900 dark:text-white">Logo files</h2>
      <p class="mt-2 max-w-3xl text-zinc-600 dark:text-zinc-400">Never redraw the logo: use these files. Ink is for light grounds, washi for dark ones; the two-tone files (green leaf) are the default on screen.</p>
      <ul class="mt-6 grid gap-3 grid-cols-2 sm:grid-cols-3 lg:grid-cols-4">
        {logos.map((f) => (
          <li>
            <a href={`/logo/${f}`} class="group block rounded-xl border border-zinc-200 dark:border-zinc-800 overflow-hidden hover:border-zinc-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-kikyo-500">
              <span class={`grid place-items-center h-28 p-5 ${ground(f)}`}><img src={`/logo/${f}`} alt="" class="h-16 w-full object-contain" loading="lazy" /></span>
              <span class="block px-3 py-2 text-xs font-mono text-zinc-600 dark:text-zinc-400 group-hover:text-zinc-900 dark:group-hover:text-white truncate" title={f}>{f}</span>
            </a>
          </li>
        ))}
      </ul>
      <h3 class="mt-10 font-bold text-xl text-zinc-900 dark:text-white">Avatars</h3>
      <p class="mt-2 text-zinc-600 dark:text-zinc-400">Profile pictures, each also as a 1024 px PNG (same name, <span class="font-mono">.png</span>). The leaf is the default; the full logo and the name only where the picture shows at 128 px or more.</p>
      <ul class="mt-4 flex flex-wrap gap-3">
        {avatars.map((f) => (
          <li><a href={`/avatars/${f}`} title={f} class="block rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-kikyo-500"><img src={`/avatars/${f}`} alt={f} width="64" height="64" class="w-16 h-16 rounded-xl ring-1 ring-zinc-200 dark:ring-zinc-800" loading="lazy" /></a></li>
        ))}
      </ul>
    </section>

    <section class="mt-16" aria-labelledby="rules">
      <h2 id="rules" class="font-bold text-2xl text-zinc-900 dark:text-white">The rules</h2>
      <p class="mt-2 max-w-3xl text-zinc-600 dark:text-zinc-400">The whole of <a class="text-kikyo-600 dark:text-kikyo-400 underline underline-offset-3 hover:text-zinc-900 dark:hover:text-white" href="/ARVA-brand-rules.md">ARVA-brand-rules.md</a>.</p>
      <!-- The file's own title is hidden: this page has one. Wide tables scroll inside themselves on phones. -->
      <article class="mt-6 prose prose-zinc dark:prose-invert max-w-3xl [&>h1:first-child]:hidden prose-headings:font-semibold
                      prose-a:text-kikyo-600 dark:prose-a:text-kikyo-400 [&_table]:block [&_table]:overflow-x-auto prose-code:before:content-none prose-code:after:content-none">
        <Rules />
      </article>
    </section>
  </main>
</Layout>
