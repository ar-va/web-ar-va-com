---
// brand.ar-va.com/story: what ARVA makes and how, what its leaf stands for, and how the leaf is drawn. Every drawing
// and number comes from the logo files beside this site (src/lib/leaf.ts), and the build fails if the leaf stops
// adding up. Facts checked 2026-11-26: the kashiwa oak's winter leaves (RHS), kamon drawn with compass and ruler (Tokyo
// Metropolitan Government, Sydney University Library), kikyō as a Heian court colour, bengara on Kyoto's teahouse
// lattices (nippon.com), Brygada 1918's revival (Google Design). Positioning: .agents/product-marketing.md.
import { readFileSync } from 'node:fs';
import Layout from '@shared/layouts/Layout.astro';
import Disclosure from '@shared/components/Disclosure.astro';
import BrandNav from '../components/BrandNav.astro';
import LeafStep from '../components/LeafStep.astro';
import LeafJoint from '../components/LeafJoint.astro';
import tokensCss from '../../arva-tokens.css?raw';
import { readLeaf } from '../lib/leaf';
import { colourTokens } from '../lib/files';

const leaf = readLeaf(readFileSync('logo/arva-mark-ink.svg', 'utf8'));
const small = readLeaf(readFileSync('logo/arva-mark-small-ink.svg', 'utf8'));
const lobes = leaf.circles.filter((c) => c.kind === 'lobe').map((c) => c.r);
const n = (x: number) => x.toFixed(2);

// ARVA's own products: the proof of everything else on this page.
const products = [
  {
    name: 'music.ar-va.com', href: 'https://music.ar-va.com', status: '', line: 'A record shelf anyone can browse',
    text: 'Collectors keep their vinyl on Discogs, a catalogue written for other collectors. Here the same collection stands on a shelf as covers, and every album page plays the album, so a friend who has never heard of a record can hear it first.',
  },
  {
    name: 'vincent.ar-va.com', href: 'https://vincent.ar-va.com', status: '', line: 'Nextcloud in your colours',
    text: 'Nextcloud’s own settings start from one colour. Vincent turns the colours you like into a whole light and dark theme, checks every text colour against its background, and hands you the exact settings to paste in.',
  },
  {
    name: 'anon.ar-va.com', href: 'https://anon.ar-va.com', status: '', line: 'Room to say the hard thing',
    text: 'One text box for what is hard to say out loud. It never asks who you are, and a private link brings back the answer.',
  },
  {
    name: 'Solaris', href: '', status: 'In progress', line: 'A tattoo studio in one system',
    text: 'Artists, the manager and the front desk each keep their own part of a studio running. Solaris joins those parts and takes on the routine work, and every decision stays with the people who run the studio.',
  },
];

const habits = [
  { title: 'Start with what’s missing', text: 'Each product begins with something people already want and can’t get, or get only in a form they give up on.' },
  { title: 'Build for the person who isn’t an expert', text: 'The friend who doesn’t collect records, the admin who isn’t a designer, the person who is afraid to speak, the artist who would rather tattoo than do paperwork.' },
  { title: 'Put the effort underneath', text: 'The details are over-built on purpose. On music.ar-va.com the record turns at 33⅓ revolutions a minute and drops the needle with a sound made in the browser. Vincent’s tests run about a thousand generated themes through every contrast check. None of it asks for attention: it is there so the part people touch can stay simple and feel good to use.' },
  { title: 'Leave people the last word', text: 'The software does the routine work and people make the calls: their colours, whether their message goes public, how their studio runs.' },
];

const steps = [
  { title: 'Axis', text: 'One line at 45°. Everything else hangs from it, with the base at the bottom left and the tip at the top right.' },
  { title: 'Lobes', text: `Nine circles, four on each side and one at the tip, growing from a radius of ${n(Math.min(...lobes))} to ${n(Math.max(...lobes))}.` },
  { title: 'Notches', text: 'Between every two lobes, a circle that touches both. Each one carves a notch, and the ninth leaves room for the stem.' },
  { title: 'Trace', text: `Follow the outside of each lobe and the inside of each notch. That makes ${leaf.circles.length} arcs; the dots mark where one hands over to the next.` },
  { title: 'Fill and stem', text: 'Fill the outline. The stem is a straight bar on the same line, cut flat at the end like a pen nib.' },
  { title: 'Midrib', text: 'The stem carries on into the leaf as a thin cut that narrows to a point.' },
] as const;

const tokens = colourTokens(tokensCss);
const colours = [
  { name: 'kikyo', title: 'Kikyō', origin: 'The blue-violet of the Japanese bellflower, a court colour in the Heian period.', job: 'Act', use: 'everything you can press, follow or choose.' },
  { name: 'kashiwa', title: 'Kashiwa', origin: 'The green of the oak leaf.', job: 'Belong', use: 'the leaf, and the people who make and own things.' },
  { name: 'bengara', title: 'Bengara', origin: 'The iron-oxide red on the lattices of Kyoto’s old teahouse districts.', job: 'Notice', use: 'the few things worth a second look.' },
].map((c) => ({ ...c, ...tokens.find((t) => t.name === c.name)! }));

const link = 'text-kikyo-600 dark:text-kikyo-400 underline underline-offset-3 hover:text-zinc-900 dark:hover:text-white';
const body = 'text-lg text-zinc-700 dark:text-zinc-300 text-pretty';
const h2 = 'font-bold text-2xl sm:text-3xl text-zinc-900 dark:text-white';
---
<Layout title="ARVA: what was missing, made well" description="ARVA builds its own software for what people want but can’t find: music.ar-va.com, Vincent, anon and Solaris. What the oak leaf stands for, and how it is drawn from 18 circles." header={{ label: 'brand', home: '/', minimal: true }}>
  <BrandNav slot="header-actions" />
  <main class="max-w-5xl mx-auto px-6 w-full pt-12 pb-24">
    <header class="grid gap-8 sm:grid-cols-[minmax(0,14rem)_1fr] sm:items-center">
      <svg viewBox="0 0 100 100" class="w-32 sm:w-full h-auto" aria-hidden="true"><path d={leaf.path} class="fill-kashiwa dark:fill-kashiwa-light" /></svg>
      <div>
        <h1 class="font-bold text-4xl sm:text-5xl text-zinc-900 dark:text-white text-balance">What was missing, made well</h1>
        <p class={`mt-4 max-w-2xl ${body}`}>
          ARVA makes its own software for things people want and can’t find, or can only find done badly. Each product is
          simple to use, carefully engineered underneath, and made to outlast the trend it was built in.
        </p>
      </div>
    </header>

    <section class="mt-20" aria-labelledby="work">
      <h2 id="work" class={h2}>The work</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {products.map((p) => (
          <li class:list={['relative rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-night-surface p-6', p.href && 'hover:border-zinc-500 has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2 has-[a:focus-visible]:outline-kikyo-500']}>
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h3 class="font-bold text-xl text-zinc-900 dark:text-white">
                {p.href ? <a href={p.href} class="after:absolute after:inset-0 focus-visible:outline-none">{p.name}</a> : p.name}
              </h3>
              {p.status && <span class="rounded-md bg-zinc-100 dark:bg-zinc-800 px-2 py-0.5 text-xs font-medium text-zinc-600 dark:text-zinc-300">{p.status}</span>}
            </div>
            <p class="mt-1 font-medium text-zinc-800 dark:text-zinc-200">{p.line}</p>
            <p class="mt-3 text-zinc-600 dark:text-zinc-400 text-pretty">{p.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-20" aria-labelledby="habits">
      <h2 id="habits" class={h2}>How ARVA builds</h2>
      <dl class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2 max-w-4xl">
        {habits.map((w) => (
          <div>
            <dt class="font-medium text-lg text-zinc-900 dark:text-white">{w.title}</dt>
            <dd class="mt-1.5 text-zinc-600 dark:text-zinc-400 text-pretty">{w.text}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="mt-20" aria-labelledby="leaf">
      <h2 id="leaf" class={h2}>The leaf</h2>
      <p class={`mt-4 max-w-3xl ${body}`}>
        ARVA’s sign is a single oak leaf, <i>kashiwa</i> in Japanese. The kashiwa oak keeps its dry leaves all winter,
        long after the trees around it are bare, and lets them go in spring when the new leaves open. ARVA’s products
        are made to hold on the same way, through passing trends, until something better is ready to take their place.
      </p>
      <ul class="mt-10 grid gap-8 sm:grid-cols-3">
        <li>
          <h3 class="font-sans font-medium text-zinc-900 dark:text-white">It leans forward</h3>
          <p class="mt-1.5 text-zinc-600 dark:text-zinc-400 text-pretty">It sits on a 45° line with the tip at the top right, the way a reader’s eye travels.</p>
        </li>
        <li>
          <h3 class="font-sans font-medium text-zinc-900 dark:text-white">It grows toward the tip</h3>
          <p class="mt-1.5 text-zinc-600 dark:text-zinc-400 text-pretty">Each lobe is larger than the one before it, and the last has more than twice the radius of the first.</p>
        </li>
        <li>
          <h3 class="font-sans font-medium text-zinc-900 dark:text-white">Its sides alternate</h3>
          <p class="mt-1.5 text-zinc-600 dark:text-zinc-400 text-pretty">The lobes on one side sit between the lobes on the other, the way they grow on a real oak.</p>
        </li>
      </ul>
    </section>

    <section class="mt-20" aria-labelledby="wordmark">
      <h2 id="wordmark" class={h2}>The name</h2>
      <div class="mt-8 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-night-surface px-6 py-12 grid place-items-center">
        <img src="/logo/arva-horizontal-ink-kashiwa.svg" alt="ARVA" class="h-16 sm:h-24 w-auto dark:hidden" />
        <img src="/logo/arva-horizontal-washi-kashiwa.svg" alt="ARVA" class="h-16 sm:h-24 w-auto hidden dark:block" />
      </div>
      <p class={`mt-6 max-w-3xl ${body}`}>
        The letters are Brygada 1918, a Polish typeface probably cut between the wars and then forgotten. Its metal
        matrices turned up in a museum in Łódź, and it was recut in 2018. Every ARVA title is set in it. In the logo the
        capitals are spaced wide, centred on the leaf and saved as shapes, so the logo looks the same on every screen.
      </p>
    </section>

    <section class="mt-20" aria-labelledby="colours">
      <h2 id="colours" class={h2}>Three colours</h2>
      <p class={`mt-4 max-w-3xl ${body}`}>Each colour has one job, and anything without a job stays neutral.</p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-3">
        {colours.map((c) => (
          <li class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-night-surface overflow-hidden">
            <div class="grid grid-cols-2 h-20" aria-hidden="true"><span style={`background:${c.light}`}></span><span style={`background:${c.dark}`}></span></div>
            <div class="p-5">
              <h3 class="font-bold text-xl text-zinc-900 dark:text-white">{c.title}</h3>
              <p class="mt-1 text-zinc-600 dark:text-zinc-400">{c.origin}</p>
              <p class="mt-3 text-zinc-900 dark:text-white"><span class="font-medium">{c.job}:</span> {c.use}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-20" aria-labelledby="drawn">
      <h2 id="drawn" class={h2}>How the leaf is drawn</h2>
      <p class={`mt-4 max-w-3xl ${body}`}>
        The leaf is drawn with a compass and a ruler: nine circles for the lobes, nine for the notches and one straight
        line. Japanese family crests, <i>kamon</i>, have been drawn this way for centuries, from perfect circles and
        straight lines. ARVA borrows the method, not a family history.
      </p>
      <ol class="mt-10 grid gap-px rounded-xl overflow-hidden border border-zinc-200 dark:border-zinc-800 bg-zinc-200 dark:bg-zinc-800 sm:grid-cols-2 lg:grid-cols-3">
        {steps.map((s, i) => (
          <li class="bg-white dark:bg-night-surface p-6">
            <div class="mx-auto max-w-64"><LeafStep leaf={leaf} step={(i + 1) as 1} label={`Step ${i + 1}: ${s.title}`} /></div>
            <p class="mt-6 text-sm text-zinc-500">Step {i + 1}</p>
            <h3 class="mt-0.5 font-bold text-xl text-zinc-900 dark:text-white">{s.title}</h3>
            <p class="mt-2 text-zinc-600 dark:text-zinc-400 text-pretty">{s.text}</p>
          </li>
        ))}
      </ol>

      <div class="mt-16 grid gap-8 sm:grid-cols-[minmax(0,18rem)_1fr] sm:items-center">
        <div class="max-w-72 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-night-surface p-6">
          <LeafJoint leaf={leaf} label="The tip lobe and the notch next to it, touching at one point with one shared tangent" />
        </div>
        <div class="max-w-2xl">
          <h3 class="font-bold text-2xl text-zinc-900 dark:text-white">No corners</h3>
          <p class={`mt-3 ${body}`}>
            Where a lobe meets a notch, the two circles touch at a single point and leave it heading the same way, along
            the straight line. The outline moves from one curve to the next without a bump, the way a train changes
            tracks. All {leaf.circles.length} joints work like this, and every build of this page checks each one.
          </p>
        </div>
      </div>

      <div class="mt-16 max-w-3xl">
        <h3 class="font-bold text-2xl text-zinc-900 dark:text-white">Why a compass</h3>
        <dl class="mt-6 grid gap-6 sm:grid-cols-3">
          <div>
            <dt class="font-medium text-zinc-900 dark:text-white">Anyone can redraw it</dt>
            <dd class="mt-1.5 text-zinc-600 dark:text-zinc-400 text-pretty">The {leaf.circles.length} circles and the line below are the whole leaf. A designer, a developer or a machine gets the same shape from them.</dd>
          </div>
          <div>
            <dt class="font-medium text-zinc-900 dark:text-white">Sharp at any size</dt>
            <dd class="mt-1.5 text-zinc-600 dark:text-zinc-400 text-pretty">A circle has no wobble to magnify, so the leaf stays clean from a browser tab to a full screen.</dd>
          </div>
          <div>
            <dt class="font-medium text-zinc-900 dark:text-white">Easy to change</dt>
            <dd class="mt-1.5 text-zinc-600 dark:text-zinc-400 text-pretty">Changing the leaf means changing one circle. The rest of the outline stays where it is.</dd>
          </div>
        </dl>
        <p class={`mt-8 ${body}`}>
          Nobody looking at the leaf sees the circles. The products work the same way: a visitor sees a shelf of
          records or a finished theme, and the engineering underneath stays out of sight.
        </p>
        <Disclosure title={`The ${leaf.circles.length} circles, as numbers`} class="mt-8">
          <p class="text-sm">In the logo file’s 100 × 100 box, in the order the outline meets them, starting at the base.</p>
          <div class="mt-3 overflow-x-auto">
            <table class="text-sm">
              <thead class="text-zinc-500">
                <tr><th class="pr-6 py-1 text-left font-medium">Circle</th><th class="px-3 py-1 text-right font-medium">x</th><th class="px-3 py-1 text-right font-medium">y</th><th class="pl-3 py-1 text-right font-medium">Radius</th></tr>
              </thead>
              <tbody class="font-mono text-zinc-800 dark:text-zinc-200">
                {leaf.circles.map((c, i) => (
                  <tr><td class="pr-6 py-0.5 font-sans">{i + 1}. {c.kind === 'lobe' ? 'Lobe' : 'Notch'}</td><td class="px-3 py-0.5 text-right">{n(c.cx)}</td><td class="px-3 py-0.5 text-right">{n(c.cy)}</td><td class="pl-3 py-0.5 text-right">{n(c.r)}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </Disclosure>
      </div>

      <div class="mt-16 max-w-3xl">
        <h3 class="font-bold text-2xl text-zinc-900 dark:text-white">Small sizes</h3>
        <p class={`mt-3 ${body}`}>
          Below 32 pixels the nine lobes and the midrib blur together, so the small leaf keeps seven lobes and
          drops the midrib. It is drawn the same way.
        </p>
      </div>
      <div class="mt-8 grid gap-8 sm:grid-cols-[minmax(0,14rem)_1fr] sm:items-center">
        <div class="max-w-56"><LeafStep leaf={small} step={4} label="The small leaf traced from its 14 circles" /></div>
        <ul class="flex flex-wrap items-end gap-x-8 gap-y-6">
          {[16, 24, 32].map((px) => (
            <li class="grid justify-items-center gap-2">
              <svg viewBox="0 0 100 100" width={px} height={px} aria-hidden="true"><path d={small.path} class="fill-kashiwa dark:fill-kashiwa-light" /></svg>
              <span class="text-sm text-zinc-500">Small, {px} px</span>
            </li>
          ))}
          {[32, 64].map((px) => (
            <li class="grid justify-items-center gap-2">
              <svg viewBox="0 0 100 100" width={px} height={px} aria-hidden="true"><path d={leaf.path} class="fill-kashiwa dark:fill-kashiwa-light" /></svg>
              <span class="text-sm text-zinc-500">Full, {px} px</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <p class="mt-20 max-w-3xl text-lg text-zinc-700 dark:text-zinc-300">
      Colour values, the type, the logo files and every rule are in <a class={link} href="/">the ARVA design language</a>.
    </p>
  </main>
</Layout>
