# Copy to .dev.vars for `astro dev`. Production: npx wrangler secret put <NAME>
TELEGRAM_BOT_TOKEN=123456:bot-token-from-botfather
DISCOGS_CONSUMER_KEY=from-discogs-settings-developers
DISCOGS_CONSUMER_SECRET=from-discogs-settings-developers
# Any long random string; encrypts stored Discogs tokens. Changing it disconnects every shelf.
TOKEN_KEY=change-me
# Optional: Spotify app (developer.spotify.com) for automatic Spotify album/track links.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# Optional: YouTube Data API key, the fallback when YouTube Music's own search finds no album.
# YOUTUBE_API_KEY=
# Messages by email for email accounts: Resend (resend.com, sending access to ar-va.com). Without it, only logged.
# RESEND_API_KEY=
