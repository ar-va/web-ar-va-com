---
// The record's photos: the main cover first, then Discogs' photos. Clicking one opens it large (a <dialog> with
// previous / next and arrow keys); Esc or a click outside closes it.
interface Props { images: string[]; title: string }
const { images, title } = Astro.props;
---
{images.length > 1 && (
  <div class="mt-5">
    <h2 class="sr-only">Photos</h2>
    <ul class="flex flex-wrap gap-2" role="list" data-gallery>
      {images.map((src, i) => (
        <li>
          <button type="button" data-index={i} class="block w-12 h-12 rounded-lg overflow-hidden border border-zinc-200 dark:border-zinc-800 hover:border-kikyo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-kikyo-500 transition-colors" aria-label={`Open photo ${i + 1} of ${images.length}`}>
            <img onload="this.classList.remove('skeleton')" onerror="this.classList.remove('skeleton')" src={src} alt="" width="48" height="48" loading="lazy" referrerpolicy="no-referrer" class="skeleton w-full h-full object-cover" />
          </button>
        </li>
      ))}
    </ul>
    <dialog data-lightbox aria-label={`Photos of ${title}`} class="m-auto max-w-[min(92vw,900px)] max-h-[92vh] bg-transparent p-0 backdrop:bg-black/80 backdrop:backdrop-blur-sm">
      <!-- Drawn icons, centred by the grid (the ‹ › × characters sat off-centre: their place came from the font). -->
      <div class="relative">
        <img data-big src={images[0]} alt="" referrerpolicy="no-referrer" class="block max-w-full max-h-[86vh] rounded-xl object-contain mx-auto" />
        <button type="button" data-step="-1" aria-label="Previous photo" class="glass absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 grid place-items-center rounded-full text-white hover:scale-110 transition-transform"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6" /></svg></button>
        <button type="button" data-step="1" aria-label="Next photo" class="glass absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 grid place-items-center rounded-full text-white hover:scale-110 transition-transform"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg></button>
        <button type="button" data-close aria-label="Close" class="glass absolute right-3 top-3 w-9 h-9 grid place-items-center rounded-full text-white hover:scale-110 transition-transform"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7l10 10M17 7 7 17" /></svg></button>
        <p data-count class="glass mt-3 mx-auto w-fit rounded-full px-3 py-1 text-xs text-white/90"></p>
      </div>
    </dialog>
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((list) => {
    const dialog = list.parentElement!.querySelector<HTMLDialogElement>('[data-lightbox]')!;
    const big = dialog.querySelector<HTMLImageElement>('[data-big]')!;
    const count = dialog.querySelector('[data-count]')!;
    const sources = [...list.querySelectorAll('img')].map((img) => img.src);
    let index = 0;
    const show = (i: number) => {
      index = (i + sources.length) % sources.length;
      big.src = sources[index];
      count.textContent = `${index + 1} / ${sources.length}`;
    };
    list.addEventListener('click', (e) => {
      const button = (e.target as HTMLElement).closest<HTMLElement>('[data-index]');
      if (!button) return;
      show(Number(button.dataset.index));
      dialog.showModal();
    });
    dialog.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === dialog || t.closest('[data-close]')) dialog.close();
      const step = t.closest<HTMLElement>('[data-step]');
      if (step) show(index + Number(step.dataset.step));
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
  });
</script>
