---
// The streaming services as one headphones button that opens a small menu of Spotify / Apple Music / YouTube Music (the
// tracklist, user 2026-11-21: three icons on every row were its busiest part; the album hero too, at the end of the
// title's line, instead of three buttons). Each is the owner's link or an automatic match when there is one, else a
// search on that service (Spotify's narrowed to albums or tracks).
import { safeStreamingUrl, streamingSearch } from '@shared/lib/lib';

// size: 'sm' in the tracklist, 'md' beside the hero's title.
interface Props { query: string; label: string; links?: { spotify?: string; apple?: string; youtube?: string }; size?: 'sm' | 'md'; kind?: 'album' | 'track' }
const { query, label, links = {}, size = 'sm', kind = 'album' } = Astro.props;
const menuId = `listen-${Math.random().toString(36).slice(2, 10)}`;
const search = streamingSearch(query, kind);
const services = [
  { key: 'spotify', name: 'Spotify' },
  { key: 'apple', name: 'Apple Music' },
  { key: 'youtube', name: 'YouTube Music' },
] as const;
const button = size === 'md' ? 'w-10 h-10 bg-[var(--well)]' : 'w-7 h-7';
const icon = size === 'md' ? 'w-5 h-5' : 'w-4 h-4';
---
<span class="inline-flex shrink-0">
  <button type="button" data-listen-menu={menuId} aria-controls={menuId} aria-expanded="false" aria-label={`${label} on Spotify, Apple Music or YouTube Music`} title="Listen on…"
    class={`${button} grid place-items-center rounded-full cursor-pointer text-kikyo-600 dark:text-kikyo-400 hover:bg-[var(--well-hover)] aria-expanded:bg-[var(--on-bg)] aria-expanded:text-[var(--on-text)] focus-visible:outline-2 focus-visible:outline-kikyo-500 motion-safe:active:scale-90 transition-[transform,background-color]`}>
    <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 15v-3a8 8 0 0 1 16 0v3" /><rect x="3.5" y="14" width="4" height="6" rx="1.5" /><rect x="16.5" y="14" width="4" height="6" rx="1.5" /></svg>
  </button>
  <!-- The menu opens over its button: the glass card grows out of the button's violet circle, which stays in its top-right
       corner (bottom-right when it opens upward) and closes it (user 2026-11-21; a violet menu was tried and the glass
       one kept). Beside it a "Listen on" title
       fills the row (user 2026-11-21: the row was empty). The row stays put while the menu grows (data-grow-keep): the
       twin is the button, and the growing shape reveals the title. -->
  <div id={menuId} popover="manual" class="listen-pop glass m-0 min-w-48 rounded-2xl p-1.5 text-sm open:flex flex-col">
    <div data-listen-head data-grow-keep class="flex items-center justify-between gap-3">
      <span class="pl-3 text-sm font-medium text-zinc-500 dark:text-zinc-400">Listen on</span>
      <button type="button" data-listen-close aria-label="Close the menu" title="Close"
        class={`${button} shrink-0 grid place-items-center rounded-full cursor-pointer bg-[var(--on-bg)] hover:bg-[var(--on-bg-hover)] text-[var(--on-text)] focus-visible:outline-2 focus-visible:outline-kikyo-500`}>
        <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 15v-3a8 8 0 0 1 16 0v3" /><rect x="3.5" y="14" width="4" height="6" rx="1.5" /><rect x="16.5" y="14" width="4" height="6" rx="1.5" /></svg>
      </button>
    </div>
    {services.map((s) => (
      <a href={(links[s.key] && safeStreamingUrl(links[s.key]!, s.key)) || search[s.key]} target="_blank" rel="noopener noreferrer"
        class="flex items-center gap-2.5 rounded-xl px-3 py-2 text-zinc-800 dark:text-zinc-200 hover:bg-[var(--well)] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-kikyo-500 [&>svg]:text-kikyo-600 dark:[&>svg]:text-kikyo-400">
        {s.key === 'spotify' && <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5" /><path d="M7.3 9.6c3.3-1 6.8-.7 9.6.9M7.9 12.7c2.7-.7 5.4-.4 7.6.8M8.5 15.6c2-.5 3.9-.3 5.6.6" /></svg>}
        {s.key === 'apple' && <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><path d="M15 7.5v7a1.9 1.9 0 1 1-1.4-1.8V9.6L10 10.5v5.3a1.9 1.9 0 1 1-1.4-1.8V8.9z" fill="currentColor" stroke-width="0.6" /></svg>}
        {s.key === 'youtube' && <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9.5" /><path d="M10.2 8.8v6.4l5.3-3.2z" fill="currentColor" stroke-width="0.6" stroke-linejoin="round" /></svg>}
        {s.name}
      </a>
    ))}
  </div>
</span>

<script>
  import { growFrom, shrinkTo } from '@shared/scripts/grow';
  // The listen menu: a manual popover (on top of everything) that this script opens and closes, so it can spring out
  // of its button and shrink back into it (a browser-closed popover vanishes at once; user 2026-11-21). It opens over
  // the button: its twin (data-listen-close) lands exactly on it, so the button seems to grow into the menu (user
  // 2026-11-21: it was a separate box under it, 6 px down and, beside a desktop scrollbar, ~15 px to the right, as
  // innerWidth counts the scrollbar). Downward, or upward with the twin at the bottom when there's no room below. Placed
  // before it's shown (it once flashed in the top-left corner). One open at a time; the twin, a click outside, Esc,
  // scrolling or picking a service closes it.
  let current: { pop: HTMLElement; button: HTMLElement } | null = null;
  const close = (focus = false) => {
    if (!current) return;
    const { pop, button } = current;
    current = null;
    button.setAttribute('aria-expanded', 'false');
    shrinkTo(pop, button, () => pop.hidePopover());
    if (focus) button.focus();
  };
  const open = (pop: HTMLElement, button: HTMLElement) => {
    close();
    const b = button.getBoundingClientRect();
    const twin = pop.querySelector<HTMLElement>('[data-listen-close]')!;
    const cw = document.documentElement.clientWidth;
    pop.classList.remove('listen-up', 'listen-left');
    pop.style.left = 'auto';
    pop.style.right = `${cw - b.right}px`;
    pop.style.top = `${b.top}px`;
    if (!pop.matches(':popover-open')) pop.showPopover();
    // No room below: open upward, the twin last (at the bottom, over the button), the services in their order.
    if (b.top + pop.offsetHeight > innerHeight - 8) pop.classList.add('listen-up');
    // No room to the left (a short title on a phone: the menu went 32 px past the screen's edge): mirrored, the menu's
    // left edge on the button's and the twin at the row's left.
    const left = b.right - pop.offsetWidth < 8;
    if (left) { pop.classList.add('listen-left'); pop.style.right = 'auto'; pop.style.left = `${b.left}px`; }
    // Then nudge it so the twin sits exactly on the button (the menu's padding and rim).
    const t = twin.getBoundingClientRect(), p = pop.getBoundingClientRect();
    if (left) pop.style.left = `${p.left + (b.left - t.left)}px`;
    else pop.style.right = `${cw - p.right - (b.right - t.right)}px`;
    pop.style.top = `${p.top + (b.top - t.top)}px`;
    button.setAttribute('aria-expanded', 'true');
    growFrom(pop, button);
    current = { pop, button };
  };
  document.querySelectorAll<HTMLElement>('[data-listen-menu]').forEach((button) => {
    const pop = document.getElementById(button.dataset.listenMenu!)!;
    button.addEventListener('click', (e) => { e.stopPropagation(); if (current?.pop === pop) close(); else open(pop, button); });
    pop.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => close()));
    pop.querySelector('[data-listen-close]')?.addEventListener('click', () => close(true));
  });
  document.addEventListener('click', (e) => { if (current && !current.pop.contains(e.target as Node)) close(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && current) close(true); });
  addEventListener('scroll', () => close(), { passive: true });
</script>

<style is:global>
  .listen-pop { position: fixed; inset: auto; }
  /* opening upward: the twin goes last, the services keep their order */
  .listen-pop.listen-up > [data-listen-head] { order: 1; }
  /* mirrored (no room to the left): the twin first in its row, "Listen on" beside it */
  .listen-pop.listen-left > [data-listen-head] { flex-direction: row-reverse; justify-content: flex-end; }
</style>
