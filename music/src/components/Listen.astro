---
// Spotify / Apple Music / YouTube Music icons, in the accent colour (lifts a little on hover): the owner's link or an automatic match when there is one, else a search on
// that service (Spotify's narrowed to albums or tracks).
import { safeStreamingUrl, streamingSearch } from '@shared/lib/lib';

// `buttons`: named pills (the album hero); otherwise bare icons (tracklists).
interface Props { query: string; label: string; links?: { spotify?: string; apple?: string; youtube?: string }; size?: 'sm' | 'md'; kind?: 'album' | 'track'; buttons?: boolean }
const { query, label, links = {}, size = 'sm', kind = 'album', buttons = false } = Astro.props;
const search = streamingSearch(query, kind);
const services = [
  { key: 'spotify', name: 'Spotify' },
  { key: 'apple', name: 'Apple Music' },
  { key: 'youtube', name: 'YouTube Music' },
] as const;
const icon = size === 'md' ? 'w-5 h-5' : 'w-4 h-4';
---
<span class={buttons ? 'flex flex-wrap items-center gap-2' : 'inline-flex items-center gap-1.5 shrink-0'}>
  {services.map((s) => {
    const href = (links[s.key] && safeStreamingUrl(links[s.key]!, s.key)) || search[s.key];
    return (
      <a href={href} target="_blank" rel="noopener noreferrer" aria-label={`${label} on ${s.name}`} title={`${label} on ${s.name}`}
        class={buttons
          ? 'ctl group/svc pl-2.5 [&>svg]:text-blue-violet-600 dark:[&>svg]:text-blue-violet-400 [&>svg]:transition-transform [&>svg]:duration-200 hover:[&>svg]:-translate-y-px hover:[&>svg]:scale-110 motion-reduce:hover:[&>svg]:transform-none'
          : 'text-blue-violet-600 dark:text-blue-violet-400 hover:text-blue-violet-700 dark:hover:text-blue-violet-300 inline-block transition-transform duration-200 ease-out hover:-translate-y-0.5 hover:scale-115 focus-visible:-translate-y-0.5 focus-visible:scale-115 motion-reduce:transition-none motion-reduce:hover:transform-none'}>
        {s.key === 'spotify' && (
          <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5" /><path d="M7.3 9.6c3.3-1 6.8-.7 9.6.9M7.9 12.7c2.7-.7 5.4-.4 7.6.8M8.5 15.6c2-.5 3.9-.3 5.6.6" /></svg>
        )}
        {s.key === 'apple' && (
          <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><path d="M15 7.5v7a1.9 1.9 0 1 1-1.4-1.8V9.6L10 10.5v5.3a1.9 1.9 0 1 1-1.4-1.8V8.9z" fill="currentColor" stroke-width="0.6" /></svg>
        )}
        {s.key === 'youtube' && (
          <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9.5" /><path d="M10.2 8.8v6.4l5.3-3.2z" fill="currentColor" stroke-width="0.6" stroke-linejoin="round" /></svg>
        )}
        {buttons && s.name}
      </a>
    );
  })}
</span>
