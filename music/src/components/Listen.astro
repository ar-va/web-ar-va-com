---
// Spotify / Apple Music / YouTube Music icons, in the accent colour (lifts a little on hover): the owner's link or an automatic match when there is one, else a search on
// that service (Spotify's narrowed to albums or tracks).
import { safeStreamingUrl, streamingSearch } from '@shared/lib/lib';

// `buttons`: named pills (the album hero); `menu`: one button that opens the three as a small menu (the tracklist, user
// 2026-11-21: three icons on every row were the busiest part of it); otherwise bare icons.
interface Props { query: string; label: string; links?: { spotify?: string; apple?: string; youtube?: string }; size?: 'sm' | 'md'; kind?: 'album' | 'track'; buttons?: boolean; menu?: boolean }
const { query, label, links = {}, size = 'sm', kind = 'album', buttons = false, menu = false } = Astro.props;
const menuId = `listen-${Math.random().toString(36).slice(2, 10)}`;
const search = streamingSearch(query, kind);
const services = [
  { key: 'spotify', name: 'Spotify' },
  { key: 'apple', name: 'Apple Music' },
  { key: 'youtube', name: 'YouTube Music' },
] as const;
const icon = size === 'md' ? 'w-5 h-5' : 'w-4 h-4';
---
{menu ? (
  <span class="inline-flex shrink-0">
    <button type="button" data-listen-menu={menuId} aria-controls={menuId} aria-expanded="false" aria-label={`${label} on Spotify, Apple Music or YouTube Music`} title="Listen on…"
      class="w-7 h-7 grid place-items-center rounded-full cursor-pointer text-kikyo-600 dark:text-kikyo-400 hover:bg-[var(--well-hover)] focus-visible:outline-2 focus-visible:outline-kikyo-500 motion-safe:active:scale-90 transition-[transform,background-color]">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 15v-3a8 8 0 0 1 16 0v3" /><rect x="3.5" y="14" width="4" height="6" rx="1.5" /><rect x="16.5" y="14" width="4" height="6" rx="1.5" /></svg>
    </button>
    <div id={menuId} popover="manual" class="listen-pop glass m-0 min-w-48 rounded-2xl p-1.5 text-sm">
      {services.map((s) => (
        <a href={(links[s.key] && safeStreamingUrl(links[s.key]!, s.key)) || search[s.key]} target="_blank" rel="noopener noreferrer"
          class="flex items-center gap-2.5 rounded-xl px-3 py-2 text-zinc-800 dark:text-zinc-200 hover:bg-[var(--well)] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-kikyo-500 [&>svg]:text-kikyo-600 dark:[&>svg]:text-kikyo-400">
          {s.key === 'spotify' && <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5" /><path d="M7.3 9.6c3.3-1 6.8-.7 9.6.9M7.9 12.7c2.7-.7 5.4-.4 7.6.8M8.5 15.6c2-.5 3.9-.3 5.6.6" /></svg>}
          {s.key === 'apple' && <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><path d="M15 7.5v7a1.9 1.9 0 1 1-1.4-1.8V9.6L10 10.5v5.3a1.9 1.9 0 1 1-1.4-1.8V8.9z" fill="currentColor" stroke-width="0.6" /></svg>}
          {s.key === 'youtube' && <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9.5" /><path d="M10.2 8.8v6.4l5.3-3.2z" fill="currentColor" stroke-width="0.6" stroke-linejoin="round" /></svg>}
          {s.name}
        </a>
      ))}
    </div>
  </span>
) : (
<span class={buttons ? 'flex flex-wrap items-center gap-2' : 'inline-flex items-center gap-1.5 shrink-0'}>
  {services.map((s) => {
    const href = (links[s.key] && safeStreamingUrl(links[s.key]!, s.key)) || search[s.key];
    return (
      <a href={href} target="_blank" rel="noopener noreferrer" aria-label={`${label} on ${s.name}`} title={`${label} on ${s.name}`}
        class={buttons
          ? 'ctl group/svc pl-2.5 [&>svg]:text-kikyo-600 dark:[&>svg]:text-kikyo-400 [&>svg]:transition-transform [&>svg]:duration-200 hover:[&>svg]:-translate-y-px hover:[&>svg]:scale-110 motion-reduce:hover:[&>svg]:transform-none'
          : 'text-kikyo-600 dark:text-kikyo-400 hover:text-kikyo-700 dark:hover:text-kikyo-300 inline-block transition-transform duration-200 ease-out hover:-translate-y-0.5 hover:scale-115 focus-visible:-translate-y-0.5 focus-visible:scale-115 motion-reduce:transition-none motion-reduce:hover:transform-none'}>
        {s.key === 'spotify' && (
          <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5" /><path d="M7.3 9.6c3.3-1 6.8-.7 9.6.9M7.9 12.7c2.7-.7 5.4-.4 7.6.8M8.5 15.6c2-.5 3.9-.3 5.6.6" /></svg>
        )}
        {s.key === 'apple' && (
          <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><path d="M15 7.5v7a1.9 1.9 0 1 1-1.4-1.8V9.6L10 10.5v5.3a1.9 1.9 0 1 1-1.4-1.8V8.9z" fill="currentColor" stroke-width="0.6" /></svg>
        )}
        {s.key === 'youtube' && (
          <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9.5" /><path d="M10.2 8.8v6.4l5.3-3.2z" fill="currentColor" stroke-width="0.6" stroke-linejoin="round" /></svg>
        )}
        {buttons && s.name}
      </a>
    );
  })}
</span>
)}

<script>
  import { growFrom, shrinkTo } from '@shared/scripts/grow';
  // The listen menu: a manual popover (on top of everything) that this script opens and closes, so it can spring out
  // of its button and shrink back into it (a browser-closed popover vanishes at once; user 2026-11-21). Placed before
  // it's shown (top / right: no width needed; it once flashed in the top-left corner), under the button, right-aligned
  // (or above it when there's no room below). One open at a time; a click outside, Esc, scrolling or picking a
  // service closes it.
  let current: { pop: HTMLElement; button: HTMLElement } | null = null;
  const close = (focus = false) => {
    if (!current) return;
    const { pop, button } = current;
    current = null;
    button.setAttribute('aria-expanded', 'false');
    shrinkTo(pop, button, () => pop.hidePopover());
    if (focus) button.focus();
  };
  const open = (pop: HTMLElement, button: HTMLElement) => {
    close();
    const b = button.getBoundingClientRect();
    pop.style.right = `${Math.max(8, innerWidth - b.right)}px`;
    pop.style.top = `${b.bottom + 6}px`;
    if (!pop.matches(':popover-open')) pop.showPopover();
    if (b.bottom + 6 + pop.offsetHeight > innerHeight) pop.style.top = `${Math.max(8, b.top - 6 - pop.offsetHeight)}px`;
    button.setAttribute('aria-expanded', 'true');
    growFrom(pop, button);
    current = { pop, button };
  };
  document.querySelectorAll<HTMLElement>('[data-listen-menu]').forEach((button) => {
    const pop = document.getElementById(button.dataset.listenMenu!)!;
    button.addEventListener('click', (e) => { e.stopPropagation(); if (current?.pop === pop) close(); else open(pop, button); });
    pop.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => close()));
  });
  document.addEventListener('click', (e) => { if (current && !current.pop.contains(e.target as Node)) close(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && current) close(true); });
  addEventListener('scroll', () => close(), { passive: true });
</script>

<style is:global>
  .listen-pop { position: fixed; inset: auto; }
</style>
