---
// The owner's card, on a shelf (about the collection) and under each album (about the record), the same on both (user
// 2026-11-21): a soft Kashiwa box headed by their photo, a title ("Artur Doyle’s records" on a shelf, the page's h1;
// "Artur’s note" under an album) and one line of counts (records: the list on a shelf, the shelf from an album; comments;
// Telegram), then their note: two lines, the whole note when tapped anywhere (or "View more"). The owner gets "Edit" (or
// "Add a note…" when empty), which opens ?note: a form rendered by the server here (no script needed) that posts
// `action=note` to the page. At most NOTE_MAX characters. A shelf's card shows even without a note (`always`); an
// album's only with one (else, for the owner, a dashed "Add a note" box).
import { NOTE_MAX } from '@shared/lib/lib';
import Avatar from '@shared/components/Avatar.astro';

interface Props {
  note: string | null;
  /** The owner's full name (the avatar's initial when there's no photo). */
  by: string;
  /** Their Telegram photo (else their initial). */
  photo?: string | null;
  /** The card's title, and its heading level (the shelf's is the page's h1). */
  heading: string;
  level?: 'h1' | 'h2';
  /** The counts line: records (and where that number leads), comments on this page, the owner's Telegram @username. */
  stats: { records: number; recordsHref: string; recordsTitle: string; comments: number; telegram: string | null };
  /** Show the card even without a note (a shelf: it carries the shelf's name and counts). */
  always?: boolean;
  /** "the collection" or "this record". */
  about: string;
  /** The page's own path, for Edit and Cancel. */
  base: string;
  canEdit: boolean;
  editing: boolean;
  addText: string;
  placeholder: string;
  class?: string;
}
const { note, by, photo, heading, level = 'h2', stats, always = false, about, base, canEdit, editing, addText, placeholder, class: className = '' } = Astro.props;
const Heading = level;
const pencil = '<svg class="w-4 h-4 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16.9 4.1a2.1 2.1 0 0 1 3 3L8.5 18.5 4 20l1.5-4.5z" /></svg>';
const statLink = 'inline-flex items-center gap-1.5 py-0.5 tabular-nums hover:text-kikyo-600 dark:hover:text-kikyo-400 transition-colors';
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
---
{!always && !note && !editing ? (canEdit && (
  <a id="note" href={`${base}?note#note`} class={`max-w-3xl scroll-mt-6 flex items-start gap-3 rounded-2xl border border-dashed border-zinc-300 dark:border-zinc-700 px-4 py-3 text-sm text-zinc-500 hover:text-kikyo-600 dark:hover:text-kikyo-400 hover:border-kikyo-400 transition-colors ${className}`}>
    <Fragment set:html={pencil} />
    {addText}
  </a>
)) : (
  <section id="note" data-note={note && !editing ? '' : undefined} class={`max-w-3xl scroll-mt-6 rounded-2xl bg-kashiwa/[0.07] dark:bg-kashiwa-light/[0.07] px-4 py-4 sm:px-5 ${className}`}>
    <!-- The head: the photo beside the title and its counts line, one block (user 2026-11-21: they felt disconnected). -->
    <div class="flex items-center gap-4">
      <Avatar photo={photo} name={by} px={58} class="w-[3.625rem] h-[3.625rem]" />
      <div class="min-w-0 flex-1">
        <Heading class="text-2xl font-bold leading-tight text-zinc-900 dark:text-white">{heading}</Heading>
        <!-- Icons and numbers: records, comments (jumps to them), Telegram. -->
        <p class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-0.5 text-sm text-zinc-500">
          {stats.records > 0 && (
            <a href={stats.recordsHref} title={stats.recordsTitle} aria-label={`${plural(stats.records, 'record')}: ${stats.recordsTitle.toLowerCase()}`} class={statLink}>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="2.5" /><path d="M12 5.5a6.5 6.5 0 0 0-6.5 6.5" stroke-linecap="round" /></svg>
              {stats.records}
            </a>
          )}
          <a href="#comments" title="Comments: jump to them" aria-label={`${plural(stats.comments, 'comment')}, jump to them`} class={statLink}>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 18.5V6.5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H8z" /></svg>
            {stats.comments}
          </a>
          {stats.telegram && (
            <a href={`https://t.me/${stats.telegram}`} target="_blank" rel="noopener noreferrer" title={`${by} on Telegram`} class={statLink}>
              <svg class="w-4 h-4" viewBox="0 0 48 48" fill="currentColor" aria-hidden="true"><path d="M41.4193 7.30899C41.4193 7.30899 45.3046 5.79399 44.9808 9.47328C44.8729 10.9883 43.9016 16.2908 43.1461 22.0262L40.5559 39.0159C40.5559 39.0159 40.3401 41.5048 38.3974 41.9377C36.4547 42.3705 33.5408 40.4227 33.0011 39.9898C32.5694 39.6652 24.9068 34.7955 22.2086 32.4148C21.4531 31.7655 20.5897 30.4669 22.3165 28.9519L33.6487 18.1305C34.9438 16.8319 36.2389 13.8019 30.8426 17.4812L15.7331 27.7616C15.7331 27.7616 14.0063 28.8437 10.7686 27.8698L3.75342 25.7055C3.75342 25.7055 1.16321 24.0823 5.58815 22.459C16.3807 17.3729 29.6555 12.1786 41.4193 7.30899Z"/></svg>
              @{stats.telegram}
            </a>
          )}
        </p>
        <slot />
      </div>
      {canEdit && note && !editing && <a href={`${base}?note#note`} class="self-start shrink-0 text-sm font-medium text-kikyo-600 dark:text-kikyo-400 hover:underline underline-offset-4">Edit</a>}
    </div>
    {editing ? (
      <form method="post" class="mt-4">
        <input type="hidden" name="action" value="note" />
        <label for="note-text" class="block text-sm font-medium text-zinc-800 dark:text-zinc-200 mb-2">About {about.replace(/^the /, 'your ')}</label>
        <textarea id="note-text" name="note" rows="3" maxlength={NOTE_MAX} autofocus placeholder={placeholder}
          oninput="this.form.querySelector('[data-left]').textContent = this.maxLength - this.value.length"
          class="w-full rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 px-3.5 py-2.5 text-zinc-900 dark:text-white leading-relaxed focus:outline-none focus:border-kikyo-500 transition-colors">{note ?? ''}</textarea>
        <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
          <span class="text-xs text-zinc-500"><span data-left>{NOTE_MAX - (note?.length ?? 0)}</span> characters left</span>
          <span class="flex items-center gap-2">
            <a href={`${base}#note`} class="ctl">Cancel</a>
            <button class="btn-primary btn-sm">Save</button>
          </span>
        </div>
      </form>
    ) : note ? (
      <>
        <blockquote class="mt-3">
          <p data-note-text class="text-[0.9375rem] leading-relaxed text-zinc-700 dark:text-zinc-300 break-words line-clamp-2">{note}</p>
        </blockquote>
        <button type="button" data-note-more hidden class="mt-1 text-sm font-medium text-kikyo-600 dark:text-kikyo-400 hover:underline underline-offset-4">View more</button>
      </>
    ) : canEdit && (
      <a href={`${base}?note#note`} class="mt-3 flex items-start gap-3 rounded-xl border border-dashed border-zinc-300 dark:border-zinc-700 px-3.5 py-2.5 text-sm text-zinc-500 hover:text-kikyo-600 dark:hover:text-kikyo-400 hover:border-kikyo-400 transition-colors">
        <Fragment set:html={pencil} />
        {addText}
      </a>
    )}
  </section>
)}

<script>
  import { spring, DURATION } from '@shared/scripts/grow';
  // The two-line preview runs the paragraphs together (a short first line and a blank one would leave a lonely
  // "…"). When it cuts something off, a tap anywhere in the note (or "View more") brings back the whole note with its
  // line breaks (user 2026-11-21); Edit stays a link.
  const box = document.querySelector<HTMLElement>('[data-note]');
  const text = document.querySelector<HTMLElement>('[data-note-text]');
  const more = document.querySelector<HTMLButtonElement>('[data-note-more]');
  if (box && text && more && (text.scrollHeight > text.clientHeight + 1 || /\n/.test(text.textContent ?? ''))) {
    more.hidden = false;
    box.classList.add('cursor-pointer');
    // Opening, the box grows to the whole note on the menus' spring (user 2026-11-21), "View more" going in the same move.
    const open = () => {
      const from = box.offsetHeight;
      text.classList.remove('line-clamp-2');
      text.classList.add('whitespace-pre-line');
      more.hidden = true;
      box.classList.remove('cursor-pointer');
      box.removeEventListener('click', onClick);
      const to = box.offsetHeight;
      if (to === from || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      box.style.overflow = 'hidden';
      box.animate([{ height: `${from}px` }, { height: `${to}px` }], { duration: DURATION, easing: spring })
        .finished.then(() => { box.style.overflow = ''; }, () => {});
    };
    const onClick = (e: MouseEvent) => { if (!(e.target as HTMLElement).closest('a')) open(); };
    box.addEventListener('click', onClick);
  }
</script>
