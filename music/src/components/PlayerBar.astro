---
// The album's player (user, 2026-11-21), sticky in the album page's reading column, placed right after the tracklist. The sound is
// scripts/album-player.ts; play / pause also turns the record in the hero (RecordHero's script wires the buttons).
// One compact row (the user liked the mini view and dropped the full card and Repeat): cover and track, then previous /
// play / next in their own pill and volume (a slider rises above it on hover; a click mutes). The progress is a thin
// line along the card's bottom that shows its knob on hover and can be dragged. Clicking the track (or Q) unfolds the
// queue inside the card: the row slides up, the list sits between it and the progress line. (A Queue button was
// dropped, user 2026-11-21: the track does it.)
interface Props { tracks: { id: string; title: string; duration: string }[]; artist: string; cover: string | null }
const { tracks, artist, cover } = Astro.props;
// Snappy: a press shrinks a button for an instant (none with reduced motion).
const press = 'motion-safe:active:scale-90 transition-[transform,background-color,color] duration-150';
// The site's control colours, like the shelf toolbar (user 2026-11-21): grey well = can press, a lighter well on hover,
// the violet "on" colour for play / pause (like the view switch's knob) and for mute while it's on.
const base = `grid place-items-center rounded-full cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-kikyo-500 ${press}`;
// Previous / next: their hover circle is a layer that only fades in (.player-btn::before), not a background change: a
// background repaint inside the glass card made the colour jump twice (user 2026-11-21).
const icon = `player-btn w-8 h-8 sm:w-9 sm:h-9 ${base} text-zinc-700 dark:text-zinc-200 disabled:opacity-35 disabled:pointer-events-none`;
const playBtn = `w-9 h-9 sm:w-10 sm:h-10 ${base} bg-[var(--on-bg)] text-[var(--on-text)] hover:bg-[var(--on-bg-hover)]`;
const side = `w-9 h-9 sm:w-10 sm:h-10 ${base} bg-[var(--well)] hover:bg-[var(--well-hover)] text-zinc-700 dark:text-zinc-200 aria-pressed:bg-[var(--on-bg)] aria-pressed:text-[var(--on-text)] aria-pressed:hover:bg-[var(--on-bg-hover)]`;
---
<!-- Sticky: at the bottom of the screen until the page reaches the end of the tracklist, where it rests (and scrolls away
     with the page into the comments). Its height in the page is the closed card's (the script keeps it so) and the card
     sits at its bottom, so the queue grows it upward. -->
<div data-player-bar class="sticky bottom-0 z-40 mt-8 h-[4.75rem] pointer-events-none">
  <!-- The cover, blurred, right behind the card and its shape: the glass rim (see .glass) takes the album's colours even
       over the plain page (user 2026-11-21: the player's rim should glow like the toolbar's over covers); the card's
       0.85 inside only shows a hint of it. Kept the card's height by the script below. -->
  {cover && <div data-bar-ambient aria-hidden="true" class="player-ambient absolute right-0 bottom-3 w-full h-[4.25rem] rounded-3xl overflow-hidden"><img src={cover} alt="" /></div>}
  <!-- Minimised (.mini, user 2026-11-21): the cover, or a swipe / drag right, shrinks it to the cover and the previous /
       play / next pill at the right, at the same height; the cover again, a swipe left, or music started from the page
       (the record, a track) bring it back. -->
  <section data-bar-card aria-label="Album player" class="player-card glass pointer-events-auto absolute inset-x-0 bottom-3 rounded-3xl pl-2.5 pr-3 pt-2.5 pb-3.5 sm:pr-4">
    <!-- The row: the cover minimises / restores the player (user 2026-11-21: no separate button); the track opens / closes
         the queue (keyboards: both are buttons). -->
    <div data-bar-head class="flex items-center gap-3 cursor-pointer">
      {/* Concentric corners (as in the CodePen the user sent): the card's 24px radius minus its 1px rim and 10px padding.
          The same size minimised, so the card keeps its height (user 2026-11-21). */}
      <button type="button" data-bar-mini aria-expanded="true" aria-label="Minimise the player" title="Minimise the player"
        class="w-11 h-11 shrink-0 overflow-hidden rounded-[13px] cursor-pointer bg-zinc-200 dark:bg-zinc-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-kikyo-500 motion-safe:active:scale-95 transition-transform duration-150">
        {cover && <img src={cover} alt="" class="w-full h-full object-cover" />}
      </button>
      <button type="button" data-bar-expand aria-expanded="false" aria-controls="player-queue" aria-keyshortcuts="Q" title="Show the queue (Q)"
        class="mini-hide min-w-0 flex-1 text-left rounded-lg cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-kikyo-500">
        <span class="block" aria-live="polite">
          <span data-bar-title class="block truncate text-[0.9375rem] font-semibold leading-5 text-zinc-900 dark:text-white">{tracks[0].title}</span>
          <span data-bar-note data-artist={artist} class="block truncate text-sm leading-5 text-zinc-500">{artist}</span>
        </span>
      </button>
      <!-- Everything after the track: its clicks stay its own (the row would open the queue). -->
      <div data-bar-controls class="flex items-center gap-1 sm:gap-2 shrink-0 -mr-1">
        <!-- Previous / play / next together in a pill. -->
        <div class="flex items-center gap-0.5 rounded-full bg-[var(--well)] p-0.5">
          <button type="button" data-bar-prev aria-label="Previous track" aria-keyshortcuts="Shift+ArrowLeft" title="Previous track (Shift+←)" class={`${icon} motion-safe:active:-translate-x-0.5`}>
            <svg class="w-[1.125rem] h-[1.125rem]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="5" y="5" width="2.6" height="14" rx="1" /><path d="M19 5.5v13L8.5 12z" /></svg>
          </button>
          <button type="button" data-bar-play aria-pressed="false" aria-label="Play" aria-keyshortcuts="Space K" title="Play (Space)" class={`${playBtn} group`}>
            <svg class="player-pop w-6 h-6 group-aria-pressed:hidden" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.5 4.8v14.4a.8.8 0 0 0 1.2.7l11.3-7.2a.8.8 0 0 0 0-1.4L8.7 4.1a.8.8 0 0 0-1.2.7z" /></svg>
            <svg class="player-pop w-6 h-6 group-aria-[pressed=false]:hidden" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4.2" height="14" rx="1.2" /><rect x="13.8" y="5" width="4.2" height="14" rx="1.2" /></svg>
          </button>
          <button type="button" data-bar-next aria-label="Next track" aria-keyshortcuts="Shift+ArrowRight" title="Next track (Shift+→)" disabled={tracks.length < 2} class={`${icon} motion-safe:active:translate-x-0.5`}>
            <svg class="w-[1.125rem] h-[1.125rem]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 5.5v13L15.5 12z" /><rect x="16.4" y="5" width="2.6" height="14" rx="1" /></svg>
          </button>
        </div>
        <!-- Volume: the speaker mutes; hovering it (or focusing the slider) stretches the button upward into a capsule
             holding the slider (user 2026-11-21: a separate floating pill didn't feel part of the player). From 640 px
             up: phones have volume buttons (and iOS ignores a page's volume), and the track's title needs the room. -->
        <div class="player-volume mini-hide relative max-sm:hidden">
          <button type="button" data-bar-mute aria-pressed="false" aria-label="Mute" aria-keyshortcuts="M" title="Mute (M)" class={`${side} group`}>
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.9" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5z" fill="currentColor" stroke="none" />
              <path class="group-aria-pressed:hidden" d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" />
              <path class="group-aria-[pressed=false]:hidden" d="M16 9.5l5 5M21 9.5l-5 5" />
            </svg>
          </button>
          <div class="player-volume-pop">
            <input data-bar-volume type="range" min="0" max="100" step="1" value="50" aria-label="Volume" aria-keyshortcuts="ArrowUp ArrowDown"
              class="player-seek player-volume-range" />
          </div>
        </div>
      </div>
    </div>

    <!-- The queue unfolds between the track and the progress line; the card grows upward as it opens. -->
    <!-- mini-hide: even closed, its long track titles count toward the card's width, so minimised it couldn't shrink. -->
    <div id="player-queue" class="player-queue mini-hide -mx-2" inert>
      <div class="min-h-0 overflow-hidden px-2">
        <div class="mt-3 mb-1 border-t border-zinc-200/70 dark:border-white/10 pt-2">
          <p class="pb-1.5 flex items-baseline justify-between gap-3 text-xs text-zinc-500">
            <span class="font-medium text-zinc-700 dark:text-zinc-300">Queue</span>
            <span>{tracks.length} track{tracks.length === 1 ? '' : 's'} from YouTube Music</span>
          </p>
          <ol data-bar-list class="relative max-h-[min(45vh,24rem)] overflow-y-auto overscroll-contain">
            {tracks.map((t, i) => (
              <li>
                <button type="button" data-bar-go={i} class="group w-full flex items-baseline gap-3 rounded-xl px-2 py-2 text-left text-sm cursor-pointer text-zinc-700 dark:text-zinc-300 hover:bg-[var(--well)] aria-[current=true]:bg-[var(--on-bg)] aria-[current=true]:text-[var(--on-text)] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-kikyo-500 motion-safe:active:scale-[0.98] transition-[transform,background-color,color] duration-150">
                  <span class="w-5 shrink-0 font-mono text-xs text-zinc-500 group-aria-[current=true]:text-inherit">{i + 1}</span>
                  <span class="flex-1 min-w-0 truncate">{t.title}</span>
                  <span class="font-mono text-xs text-zinc-500 group-aria-[current=true]:text-inherit">{t.duration}</span>
                </button>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>

    <!-- The progress: a thin line along the bottom; a taller invisible hit area, the knob on hover, drag to seek. -->
    <input data-bar-seek type="range" min="0" max="0" value="0" step="1" disabled aria-label="Position in the track" aria-keyshortcuts="ArrowLeft ArrowRight"
      class="player-seek player-progress" />
  </section>
</div>

<script>
  import { spring, DURATION } from '@shared/scripts/grow';
  // The queue: the track row, Q (RecordHero), Esc or a click outside. Closed, the list is inert (not tabbable).
  const card = document.querySelector<HTMLElement>('[data-bar-card]');
  const head = document.querySelector<HTMLElement>('[data-bar-head]');
  const expandBtn = document.querySelector<HTMLElement>('[data-bar-expand]');
  const queue = document.getElementById('player-queue');
  const list = document.querySelector<HTMLElement>('[data-bar-list]');
  const isOpen = () => !!queue?.classList.contains('open');
  const openQueue = (on: boolean) => {
    if (!queue) return;
    queue.classList.toggle('open', on);
    queue.toggleAttribute('inert', !on);
    expandBtn?.setAttribute('aria-expanded', String(on));
    if (expandBtn) expandBtn.title = `${on ? 'Hide' : 'Show'} the queue (Q)`;
    // Opening: the track playing in view, a third of the way down the list.
    const current = list?.querySelector<HTMLElement>('[aria-current="true"]');
    if (on && list && current) list.scrollTop = current.offsetTop - list.clientHeight / 3;
  };
  head?.addEventListener('click', () => (isMini() ? setMini(false) : openQueue(!isOpen())));
  document.querySelector('[data-bar-controls]')?.addEventListener('click', (e) => e.stopPropagation());
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen()) { openQueue(false); expandBtn?.focus(); } });
  document.addEventListener('click', (e) => { if (isOpen() && !card?.contains(e.target as Node)) openQueue(false); });

  // The space the bar takes in the page = the card without the queue (+ its 12 px gap), whatever the queue is doing.
  const wrap = document.querySelector<HTMLElement>('[data-player-bar]');
  const ambient = document.querySelector<HTMLElement>('[data-bar-ambient]');
  const fit = () => {
    if (wrap && card && queue) wrap.style.height = `${card.offsetHeight - queue.offsetHeight + 12}px`;
    if (ambient && card) { ambient.style.height = `${card.offsetHeight}px`; ambient.style.width = `${card.offsetWidth}px`; }
  };
  if (card) new ResizeObserver(fit).observe(card);

  // Minimised: just the cover and the previous / play / next pill, at the right (user 2026-11-21). The card stays
  // anchored right while its width springs between the two sizes, so it shrinks into the pill and grows out of it.
  const miniBtn = document.querySelector<HTMLElement>('[data-bar-mini]');
  const still = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  function isMini() { return !!card?.classList.contains('mini'); }
  function setMini(on: boolean, offset = 0) {
    if (!card || on === isMini()) return;
    if (on) openQueue(false);
    const from = card.offsetWidth; // mid-spring too: the new spring starts where the card is now
    // A toggle still springing: stop it, or its ending would un-anchor the card in the middle of this one.
    card.getAnimations().forEach((a) => a.cancel());
    card.classList.add('anchor-right');
    card.classList.toggle('mini', on);
    miniBtn?.setAttribute('aria-expanded', String(!on));
    miniBtn?.setAttribute('aria-label', on ? 'Show the full player' : 'Minimise the player');
    if (miniBtn) miniBtn.title = on ? 'Show the full player' : 'Minimise the player';
    const to = card.offsetWidth;
    if (still()) { card.classList.remove('anchor-right'); return; }
    card.style.overflow = 'hidden';
    const a = card.animate([{ width: `${from}px`, translate: `${offset}px 0` }, { width: `${to}px`, translate: '0 0' }], { duration: DURATION, easing: spring });
    if (!on) card.querySelectorAll<HTMLElement>('.mini-hide').forEach((el) => el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 220, delay: 60, easing: 'ease-out', fill: 'backwards' }));
    a.finished.then(() => { card.style.overflow = ''; card.classList.remove('anchor-right'); }, () => {});
  }
  // The cover: its click is its own (the row would also act on it).
  miniBtn?.addEventListener('click', (e) => { e.stopPropagation(); setMini(!isMini()); });
  // Music started from the page (the record, a track in the tracklist): the full player comes back (RecordHero).
  document.addEventListener('player:show', () => setMini(false));

  // Swipe (touch) or drag (mouse) sideways: the card follows, a little reluctantly the wrong way; let go past a
  // quarter of its width (or 60 px) and it minimises / comes back, otherwise it springs home. Sliders, the queue's list
  // and vertical scrolling (touch-action: pan-y) are left alone; a drag doesn't count as a click.
  let drag: { x: number; y: number; id: number; dx: number; active: boolean } | null = null;
  let dragged = false;
  card?.addEventListener('pointerdown', (e) => {
    dragged = false;
    if (e.button !== 0 || (e.target as Element).closest('input, #player-queue')) return;
    drag = { x: e.clientX, y: e.clientY, id: e.pointerId, dx: 0, active: false };
  });
  card?.addEventListener('pointermove', (e) => {
    if (!drag || e.pointerId !== drag.id) return;
    const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
    if (!drag.active) {
      if (Math.abs(dy) > 10 && Math.abs(dy) > Math.abs(dx)) { drag = null; return; }
      if (Math.abs(dx) < 10) return;
      drag.active = true;
      card.setPointerCapture(e.pointerId);
    }
    drag.dx = dx;
    const way = isMini() ? -1 : 1;
    card.style.translate = `${dx * way > 0 ? dx : dx / 4}px 0`;
  });
  const endDrag = (e: PointerEvent) => {
    if (!drag || e.pointerId !== drag.id) return;
    const { active, dx } = drag;
    drag = null;
    if (!active || !card) return;
    dragged = true;
    const shown = parseFloat(card.style.translate) || 0;
    card.style.translate = '';
    const far = Math.max(60, card.offsetWidth * (isMini() ? 0.3 : 0.25));
    if (isMini() ? dx < -far : dx > far) setMini(!isMini(), shown);
    else if (!still()) card.animate([{ translate: `${shown}px 0` }, { translate: '0 0' }], { duration: DURATION, easing: spring });
  };
  card?.addEventListener('pointerup', endDrag);
  card?.addEventListener('pointercancel', endDrag);
  card?.addEventListener('click', (e) => { if (dragged) { e.stopPropagation(); e.preventDefault(); dragged = false; } }, true);
</script>

<style is:global>
  /* Minimised: the card shrinks to its content at the right; the track, volume and queue step out; the cover turns
     round (it brings the full player back). pan-y: horizontal drags are the card's, vertical scrolling the page's. */
  .player-card { touch-action: pan-y; }
  .player-card.mini, .player-card.anchor-right { left: auto; }
  .player-card.mini .mini-hide { display: none; }
  [data-bar-mini] { transition-property: transform, border-radius; transition-duration: 0.15s, 0.25s; }
  .player-card.mini [data-bar-mini] { border-radius: 9999px; }
  @media (prefers-reduced-motion: reduce) { [data-bar-mini] { transition: none; } }
  .player-btn { position: relative; isolation: isolate; }
  .player-btn::before { content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit; background: var(--well-hover); opacity: 0; transition: opacity 0.15s; will-change: opacity; }
  .player-btn:hover::before { opacity: 1; }
  .player-ambient img { width: 100%; height: 100%; object-fit: cover; filter: blur(14px) saturate(1.3); transform: scale(1.25); opacity: 0.4; }
  .dark .player-ambient img { opacity: 0.7; } /* light glass shows colour through more, so less of it there */
  /* Unfolding: grid rows from 0fr to 1fr animate to the list's own height; quick and settling softly. */
  .player-queue { display: grid; grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows 0.28s cubic-bezier(0.2, 0.9, 0.25, 1), opacity 0.2s; }
  .player-queue.open { grid-template-rows: 1fr; opacity: 1; }
  /* Play / pause: the icon that appears pops in. */
  @keyframes player-pop { from { transform: scale(0.6); opacity: 0.4; } }
  @media (prefers-reduced-motion: no-preference) { .player-pop { animation: player-pop 0.18s cubic-bezier(0.3, 1.4, 0.5, 1); } }

  /* Registered, so the line's thickness can animate. */
  @property --line { syntax: '<length>'; inherits: true; initial-value: 3px; }
  /* Sliders: a line filled up to --p (the progress reads the card's, the volume its own), with a round knob. The
     element is taller than the line it draws, so it's easy to hit; the line is painted in its middle. */
  .player-seek {
    --fill: var(--color-kikyo-600);
    --line: 3px;
    appearance: none; height: 14px; cursor: pointer;
    background:
      linear-gradient(var(--fill), var(--fill)) 0 50% / var(--p, 0%) var(--line) no-repeat,
      linear-gradient(var(--well-hover), var(--well-hover)) 0 50% / 100% var(--line) no-repeat;
    transition: --line 0.15s;
  }
  .dark .player-seek { --fill: var(--color-kikyo-400); }
  .player-seek:disabled { cursor: default; }
  .player-seek::-webkit-slider-thumb { appearance: none; width: 13px; height: 13px; border-radius: 50%; background: var(--fill); transition: transform 0.15s, opacity 0.15s; }
  .player-seek::-moz-range-thumb { width: 13px; height: 13px; border: 0; border-radius: 50%; background: var(--fill); transition: transform 0.15s, opacity 0.15s; }
  .player-seek:focus-visible { outline: 2px solid var(--color-kikyo-500); outline-offset: 2px; border-radius: 9999px; }

  /* The progress along the card's bottom: line and knob only while hovered / dragged / focused. */
  .player-progress { position: absolute; left: 1rem; right: 1rem; bottom: 0; --line: 2px; }
  .player-progress:is(:hover, :active, :focus-visible):not(:disabled) { --line: 4px; }
  .player-progress::-webkit-slider-thumb { opacity: 0; transform: scale(0.5); }
  .player-progress::-moz-range-thumb { opacity: 0; transform: scale(0.5); }
  .player-progress:is(:hover, :active, :focus-visible):not(:disabled)::-webkit-slider-thumb { opacity: 1; transform: none; }
  .player-progress:is(:hover, :active, :focus-visible):not(:disabled)::-moz-range-thumb { opacity: 1; transform: none; }

  /* Volume: on hover / keyboard focus (a mouse click's focus doesn't keep it open) the speaker button stretches upward into one capsule (::before, the button's hover well
     over the card's own tint, so the part above the card reads the same), the slider in its upper part. The capsule
     grows from the button's size; the button's own background steps aside meanwhile. */
  .player-volume::before {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 100%; border-radius: 9999px; pointer-events: none;
    background: linear-gradient(var(--well-hover), var(--well-hover)), rgb(253 253 251 / 0.9);
    /* closing (these apply when hover ends): like a menu shrinking back, 0.2 s accelerating, no bounce */
    opacity: 0; transition: height 0.2s cubic-bezier(0.5, 0, 0.75, 0), opacity 0.1s 0.1s, box-shadow 0.2s;
  }
  .dark .player-volume::before { background: linear-gradient(var(--well-hover), var(--well-hover)), rgb(30 32 41 / 0.9); }
  /* opening: the menus' spring (shared/scripts/grow.ts sets --spring; without it, a plain ease-out) */
  .player-volume:is(:hover, :has(:focus-visible))::before {
    opacity: 1; height: calc(100% + 7rem); box-shadow: 0 10px 20px -12px rgb(0 0 0 / 0.4);
    transition: height var(--spring-time, 0.24s) var(--spring, cubic-bezier(0.2, 0.9, 0.25, 1)), opacity 0.08s, box-shadow 0.3s;
  }
  .player-volume > button { position: relative; z-index: 1; }
  .player-volume:is(:hover, :has(:focus-visible)) > button[aria-pressed="false"] { background: transparent; }
  .player-volume-pop {
    position: absolute; left: 0; right: 0; bottom: 100%; height: 7rem; z-index: 1;
    opacity: 0; visibility: hidden; translate: 0 0.5rem; transition: opacity 0.1s, translate 0.2s cubic-bezier(0.5, 0, 0.75, 0), visibility 0.1s;
  }
  /* the slider follows the capsule a beat later, like a menu's items */
  .player-volume:is(:hover, :has(:focus-visible)) .player-volume-pop {
    opacity: 1; visibility: visible; translate: 0 0;
    transition: opacity 0.2s 0.05s, translate var(--spring-time, 0.24s) var(--spring, cubic-bezier(0.2, 0.9, 0.25, 1)) 0.03s, visibility 0s;
  }
  .player-volume-range { position: absolute; left: 50%; top: calc(50% + 0.25rem); width: 5.5rem; translate: -50% -50%; rotate: -90deg; --line: 4px; }
  @media (prefers-reduced-motion: reduce) { .player-queue, .player-volume-pop, .player-volume::before { transition: none; } }
</style>
