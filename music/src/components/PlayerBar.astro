---
// The album's player, pinned to the bottom of the album page (user, 2026-11-21): the track playing, previous / play /
// next, its progress (drag to seek), repeat and the queue. The sound is scripts/album-player.ts; play / pause also turns
// the record in the hero (RecordHero's script wires the buttons).
// Laid out like a phone's now-playing card (user's reference, 2026-11-21): title and artist with the cover on the right,
// the progress line with its times under it, then one evenly spaced row: repeat, previous, play, next, queue.
interface Props { tracks: { id: string; title: string; duration: string }[]; artist: string; cover: string | null }
const { tracks, artist, cover } = Astro.props;
const icon = 'w-10 h-10 grid place-items-center rounded-full cursor-pointer text-zinc-800 dark:text-white hover:bg-[var(--well)] disabled:opacity-35 disabled:pointer-events-none transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-kikyo-500';
const side = `${icon} !text-zinc-500 dark:!text-zinc-400 aria-pressed:!text-kikyo-600 dark:aria-pressed:!text-kikyo-400 aria-expanded:!text-kikyo-600 dark:aria-expanded:!text-kikyo-400`;
---
<div data-player-bar class="fixed inset-x-0 bottom-0 z-40 px-3 pb-3 pointer-events-none">
  <section aria-label="Album player" class="glass pointer-events-auto mx-auto w-full max-w-[30rem] rounded-3xl px-5 pt-4 pb-2">
    <!-- Clicking the track row also opens / closes the queue (user, 2026-11-21); keyboards use the Queue button. -->
    <div data-bar-head class="flex items-center gap-4 cursor-pointer" title="Show or hide the queue">
      <div class="min-w-0 flex-1" aria-live="polite">
        <p data-bar-title class="truncate text-base font-semibold leading-6 text-zinc-900 dark:text-white">{tracks[0].title}</p>
        <p data-bar-note data-artist={artist} class="truncate text-sm leading-5 text-zinc-500">{artist}</p>
      </div>
      {cover ? <img src={cover} alt="" class="w-12 h-12 rounded-lg object-cover shrink-0" /> : <span class="w-12 h-12 rounded-lg bg-zinc-200 dark:bg-zinc-800 shrink-0"></span>}
    </div>
    <!-- The queue opens inside the card, between the track and its progress (user, 2026-11-21): the card is pinned to the
         bottom, so it grows upward and the track slides up as the list unfolds. -->
    <div id="player-queue" class="player-queue -mx-2" inert>
      <div class="min-h-0 overflow-hidden">
        <div class="mx-2 mt-3 border-t border-zinc-200/70 dark:border-white/10 pt-2">
          <p class="pb-1.5 flex items-baseline justify-between gap-3 text-xs text-zinc-500">
            <span class="font-medium text-zinc-700 dark:text-zinc-300">Queue</span>
            <span>{tracks.length} track{tracks.length === 1 ? '' : 's'} from YouTube Music</span>
          </p>
          <ol data-bar-list class="-mx-2 relative max-h-[min(45vh,24rem)] overflow-y-auto overscroll-contain">
            {tracks.map((t, i) => (
              <li>
                <button type="button" data-bar-go={i} class="group w-full flex items-baseline gap-3 rounded-xl px-2 py-2 text-left text-sm cursor-pointer text-zinc-700 dark:text-zinc-300 hover:bg-[var(--well)] aria-[current=true]:bg-[var(--on-bg)] aria-[current=true]:text-[var(--on-text)] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-kikyo-500 transition-colors">
                  <span class="w-5 shrink-0 font-mono text-xs text-zinc-500 group-aria-[current=true]:text-inherit">{i + 1}</span>
                  <span class="flex-1 min-w-0 truncate">{t.title}</span>
                  <span class="font-mono text-xs text-zinc-500 group-aria-[current=true]:text-inherit">{t.duration}</span>
                </button>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
    <div class="mt-4">
      <input data-bar-seek type="range" min="0" max="0" value="0" step="1" disabled aria-label="Position in the track" class="player-seek block w-full" />
      <div class="mt-2 flex justify-between font-mono text-[11px] leading-none text-zinc-500 tabular-nums">
        <span data-bar-time>0:00</span>
        <span data-bar-length>{tracks[0].duration || '0:00'}</span>
      </div>
    </div>
    <div class="mt-1 -mx-2 flex items-center justify-between">
      <button type="button" data-bar-repeat aria-pressed="false" aria-label="Repeat the album" title="Repeat the album" class={side}>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.9" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 2.5l3 3-3 3" /><path d="M4 11.5v-1a5 5 0 0 1 5-5h11" /><path d="M7 21.5l-3-3 3-3" /><path d="M20 12.5v1a5 5 0 0 1-5 5H4" /></svg>
      </button>
      <button type="button" data-bar-prev aria-label="Previous track" title="Previous track" class={icon}>
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="5" y="5" width="2.6" height="14" rx="1" /><path d="M19 5.5v13L8.5 12z" /></svg>
      </button>
      <button type="button" data-bar-play aria-pressed="false" aria-label="Play" title="Play" class={`${icon} group w-14 h-14`}>
        <svg class="w-9 h-9 group-aria-pressed:hidden" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.5 4.8v14.4a.8.8 0 0 0 1.2.7l11.3-7.2a.8.8 0 0 0 0-1.4L8.7 4.1a.8.8 0 0 0-1.2.7z" /></svg>
        <svg class="w-9 h-9 group-aria-[pressed=false]:hidden" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4.2" height="14" rx="1.2" /><rect x="13.8" y="5" width="4.2" height="14" rx="1.2" /></svg>
      </button>
      <button type="button" data-bar-next aria-label="Next track" title="Next track" disabled={tracks.length < 2} class={icon}>
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 5.5v13L15.5 12z" /><rect x="16.4" y="5" width="2.6" height="14" rx="1" /></svg>
      </button>
      <button type="button" data-bar-queue aria-controls="player-queue" aria-expanded="false" aria-label="Queue" title="Queue" class={side}>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.9" stroke="currentColor" stroke-linecap="round" aria-hidden="true"><path d="M4 6h11M4 12h11M4 18h7" /><path d="M17 15.5v-9l4 2" /><circle cx="15" cy="16" r="2" /></svg>
      </button>
    </div>
  </section>
</div>

<script>
  // Queue open / closed: the button, Esc, or a click outside the card. Closed, the list is inert (not tabbable).
  const card = document.querySelector<HTMLElement>('[data-player-bar] section');
  const button = document.querySelector<HTMLElement>('[data-bar-queue]');
  const queue = document.getElementById('player-queue');
  const list = document.querySelector<HTMLElement>('[data-bar-list]');
  const open = (on: boolean) => {
    if (!queue || !button) return;
    button.setAttribute('aria-expanded', String(on));
    queue.toggleAttribute('inert', !on);
    queue.classList.toggle('open', on);
    // Opening: the track playing in view, a third of the way down the list.
    const current = list?.querySelector<HTMLElement>('[aria-current="true"]');
    if (on && list && current) list.scrollTop = current.offsetTop - list.clientHeight / 3;
  };
  const flip = () => open(button?.getAttribute('aria-expanded') !== 'true');
  button?.addEventListener('click', flip);
  document.querySelector('[data-bar-head]')?.addEventListener('click', flip);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && queue?.classList.contains('open')) { open(false); button?.focus(); } });
  document.addEventListener('click', (e) => { if (queue?.classList.contains('open') && !card?.contains(e.target as Node)) open(false); });
</script>

<style is:global>
  /* The queue unfolds: a grid row from 0fr to 1fr animates to the list's own height. */
  .player-queue { display: grid; grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.25s; }
  .player-queue.open { grid-template-rows: 1fr; opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .player-queue { transition: none; } }
  /* Room under the footer, so the pinned card never covers the end of the page. */
  body:has([data-player-bar]) { padding-bottom: 12.5rem; }
  /* The progress: a thin line filled up to --p (set by album-player.ts), with a round knob at the current position. */
  .player-seek {
    --fill: var(--color-kikyo-600);
    appearance: none; height: 4px; border-radius: 9999px; cursor: pointer;
    background: linear-gradient(var(--fill), var(--fill)) 0 / var(--p, 0%) 100% no-repeat, var(--well-hover);
  }
  .dark .player-seek { --fill: var(--color-kikyo-400); }
  .player-seek:disabled { cursor: default; }
  .player-seek::-webkit-slider-thumb { appearance: none; width: 14px; height: 14px; border-radius: 50%; background: var(--fill); transition: transform 0.15s; }
  .player-seek::-moz-range-thumb { width: 14px; height: 14px; border: 0; border-radius: 50%; background: var(--fill); transition: transform 0.15s; }
  .player-seek:is(:hover, :active):not(:disabled)::-webkit-slider-thumb { transform: scale(1.25); }
  .player-seek:is(:hover, :active):not(:disabled)::-moz-range-thumb { transform: scale(1.25); }
  .player-seek:focus-visible { outline: 2px solid var(--color-kikyo-500); outline-offset: 6px; }
</style>
