---
// The big record block shared by the album page and the shelf's "Latest", identical on both (user, 2026-10-29): the sleeve with the vinyl rolled out to
// the right, then artist, album with the streaming menu (headphones) at the end of its line, added / released / genre / tracks.
// The record plays on its own after rolling out; a small play / pause button on the cover stops it. On the shelf the cover and
// title link to the album; on the album page a click anywhere on the cover plays / pauses too.
import Cover from '@shared/components/Cover.astro';
import Listen from './Listen.astro';
import { displayDate, formatReleased, type ShelfRecord } from '@shared/lib/lib';

interface Props {
  record: ShelfRecord;
  artist: string;
  title: string;
  released: string;
  genres: string[];
  trackCount: number;
  links: { spotify?: string; apple?: string; youtube?: string };
  href?: string;
  /** Total running time, e.g. "42 min" (the album page). */
  runtime?: string;
  /** For the owner when the "Added on" date is missing (addedNeedsDate): an icon that opens a popup to set it.
   *  `sameDay` = how many of their records Discogs dated on this record's day. */
  askAdded?: { sameDay: number };
  /** Album page: the tracks found on YouTube Music, in order. The record's sound plays them (scripts/album-player.ts),
   *  with the player bar the album page renders at its end (PlayerBar.astro). */
  play?: { id: string; title: string; duration: string }[];
}
const { record, artist, title, released, genres, trackCount, links, href, runtime, askAdded, play } = Astro.props;
// Discogs' added date is in the collector's local time: show that day, not the UTC one.
const day = record.added.slice(0, 10);
const added = day ? `Added to the shelf ${formatReleased(day)}` : 'Added date unknown';
// Genres: the main one (Discogs lists it first) as a tag, "+3" for the rest; a click shows them all (user 2026-11-21:
// four genres wrapped the facts line).
const GENRES = 'genres';
const facts = [
  released && displayDate(released),
  genres.length > 0 && GENRES,
  trackCount > 0 && `${trackCount} track${trackCount === 1 ? '' : 's'}`,
  runtime,
].filter(Boolean);
const Heading = href ? 'h2' : 'h1';
// The row above the hero, only when something is in it: a slot filled inside a condition counts as filled even when the
// condition is false (visitors on an album page got an empty 52 px gap).
const above = Astro.slots.has('above') ? (await Astro.slots.render('above')).trim() : '';
// Album page: artist and title copy themselves on click (src/scripts/copy.ts); on the shelf the title links instead.
const copy = 'cursor-copy text-left [text-transform:inherit] rounded-sm hover:opacity-75 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-kikyo-500 transition-opacity';
---
<!-- The rolled-out disc sticks out 38 % of the sleeve's width: the gap leaves it ~60 px clear of the text.
     Phones: the sleeve takes 62 % of the screen up to the desktop size (user 2026-11-21: it had room; was 12rem), so
     sleeve + disc stay inside a 360 px screen's margins. -->
<!-- overflow-x: clip, with the page's 24 px side margin to spare: the light behind the rolled-out record reaches 120 % of
     the cover past it, which made phones scroll sideways (446 px on a 390 px screen); now it fades out at the screen edge. -->
<!-- Above the hero, one row in the same place on every hero (user 2026-11-21): the shelf's "Latest", the album page's
     "Edit record details" for its owner. 32 px tall, 20 px above the hero. -->
{above && <div class="mb-5 flex h-8 items-center"><Fragment set:html={above} /></div>}
<!-- Desktop: the text starts 44 px below the cover's top (where centring put the usual text), not centred, so extra lines
     under it (the album page's photos) grow it downward and the title sits at the same height on both heroes. -->
<div data-hero class="flex flex-col sm:flex-row sm:items-start gap-8 sm:gap-36 overflow-x-clip [overflow-clip-margin:1.5rem]">
  <div data-turntable data-play={play?.length ? JSON.stringify(play) : undefined} class="relative shrink-0 self-start sm:self-auto">
    <!-- Shelf: the cover links too (for mouse and touch; keyboards and screen readers use the title's link). -->
    {href ? (
      <a href={href} tabindex="-1" aria-hidden="true" class="block"><Cover record={record} eager class="sleeve-open w-[min(15rem,62vw)] sm:w-60" /></a>
    ) : (
      <div data-spin-cover class="motion-safe:cursor-pointer"><Cover record={record} eager class="sleeve-open w-[min(15rem,62vw)] sm:w-60" /></div>
    )}
    <span class="sleeve-shine" aria-hidden="true"></span>
    <button type="button" data-spin aria-pressed="false" aria-label="Play the record" title="Play the record"
      class="glass glass-dark group absolute right-2 bottom-2 z-10 w-9 h-9 grid place-items-center rounded-full text-white cursor-pointer motion-reduce:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-kikyo-500">
      <svg class="w-4 h-4 group-aria-pressed:hidden" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" /></svg>
      <svg class="w-4 h-4 group-aria-[pressed=false]:hidden" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6.5" y="5.5" width="3.8" height="13" rx="1" /><rect x="13.7" y="5.5" width="3.8" height="13" rx="1" /></svg>
    </button>
  </div>
  <div class="min-w-0 flex-1 sm:pt-11">
    <p class="text-lg font-medium text-kashiwa dark:text-kashiwa-light mb-1">{href ? artist : <button type="button" data-copy title="Click to copy" class={copy}>{artist}</button>}</p>
    <!-- The title, and right after its first line the headphones: a menu of the streaming services (user 2026-11-21,
         instead of three buttons under the facts; at the frame's far edge they sat apart from everything else). -->
    <div class="flex items-start gap-4">
      <Heading class="min-w-0 text-3xl sm:text-5xl font-bold leading-[1.05] text-zinc-900 dark:text-white">
        {href ? <a href={href} class="hover:text-kikyo-600 dark:hover:text-kikyo-400 transition-colors">{title}</a> : <button type="button" data-copy title="Click to copy" class={copy}>{title}</button>}
      </Heading>
      <span class="-mt-0.5 sm:mt-1"><Listen size="md" query={`${artist} ${title}`} label={`Listen to ${title}`} links={links} /></span>
    </div>
    {facts.length > 0 && <p class="mt-5 flex flex-wrap gap-y-1 text-zinc-700 dark:text-zinc-300">{facts.map((f) => <span class="fact">{f !== GENRES ? f : genres.length === 1 ? genres[0] : (
      <button type="button" data-genres aria-expanded="false" title="Show all genres"
        class="group/genres inline-flex items-baseline gap-1.5 -my-0.5 rounded-full bg-[var(--well)] hover:bg-[var(--well-hover)] px-2.5 py-0.5 cursor-pointer text-left focus-visible:outline-2 focus-visible:outline-kikyo-500 transition-colors">
        <span class="group-aria-expanded/genres:hidden">{genres[0]}</span>
        <span class="hidden group-aria-expanded/genres:inline">{genres.join(', ')}</span>
        <span class="text-sm text-zinc-500 group-aria-expanded/genres:hidden">+{genres.length - 1}</span>
      </button>
    )}</span>)}</p>}
    <p class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-zinc-500">
      {added}
      {askAdded && (
        <button type="button" popovertarget="added-ask" title="Set the day this record joined your collection"
          class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium text-warning dark:text-warning-light bg-warning/10 dark:bg-warning-light/15 hover:bg-warning/20 dark:hover:bg-warning-light/25 focus-visible:outline-2 focus-visible:outline-kikyo-500 transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7.5v5.5M12 16.5h.01" /></svg>{day ? 'Is this date right?' : 'Add the date'}
        </button>
      )}
    </p>
    {askAdded && (
      <div id="added-ask" popover class="m-auto w-[min(27rem,calc(100vw-2rem))] rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-night-surface p-6 text-left text-zinc-700 dark:text-zinc-300 shadow-2xl backdrop:bg-black/40">
        <h2 class="text-lg font-bold text-zinc-900 dark:text-white">When did this record join your collection?</h2>
        <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
          {day ? `Discogs says ${formatReleased(day)}, the same day as ${askAdded.sameDay - 1} other records of yours: probably when they went into Discogs, not when you got them.` : 'Discogs didn’t give a date for this one.'}
          {' '}Your date orders the shelf and the “Added” filter.
        </p>
        <form method="post" class="mt-5 flex flex-col gap-4">
          <label class="flex flex-col gap-1.5 text-sm font-medium text-zinc-800 dark:text-zinc-200">
            Added on
            <input type="date" name="added" value={day || undefined} max={new Date().toISOString().slice(0, 10)} required onclick="try { this.showPicker() } catch {}"
              class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950 px-3.5 py-2.5 font-normal text-zinc-900 dark:text-white focus:outline-none focus:border-kikyo-500 [color-scheme:light] dark:[color-scheme:dark]" />
          </label>
          <!-- Save comes first in the form, so Enter saves; the row shows it rightmost. -->
          <div class="flex flex-row-reverse flex-wrap justify-start gap-2">
            <button name="action" value="added" class="inline-flex items-center h-8 px-4 rounded-full text-sm font-medium bg-kikyo-600 dark:bg-kikyo-400 text-white dark:text-zinc-950 hover:bg-kikyo-700 dark:hover:bg-kikyo-300 transition-colors">Save date</button>
            {day && <button name="action" value="added-ok" formnovalidate class="ctl">Discogs’ date is right</button>}
            <button type="button" popovertarget="added-ask" popovertargetaction="hide" class="ctl">Later</button>
          </div>
        </form>
      </div>
    )}
    <slot />
  </div>
</div>

<script>
  import { emitBurst } from '../scripts/notes';
  import { albumPlayer } from '../scripts/album-player';

  // The genre tag in the facts line: a click shows every genre, another folds them back to the main one.
  document.querySelectorAll<HTMLElement>('[data-genres]').forEach((b) => b.addEventListener('click', () => {
    b.setAttribute('aria-expanded', String(b.getAttribute('aria-expanded') !== 'true'));
    b.title = b.getAttribute('aria-expanded') === 'true' ? 'Show the main genre only' : 'Show all genres';
  }));

  // Notes drift out of the open side while the record rolls out (CSS: 0.25 s delay, 1.6 s).
  document.querySelectorAll<HTMLElement>('.sleeve-open').forEach((sleeve) => emitBurst(sleeve, 'right', 9, 1500, 300));

  // The record plays like a turntable: once it has rolled out it spins up to 33⅓ rpm (a turn every 1.8 s) and keeps
  // going, a note drifting out now and then (only while the hero is on screen). Tapping play / pause (or, on the album page, the cover) stops the notes and
  // slows it to a halt; tapping again starts it. Nothing moves with reduced motion.
  const REV_MS = 1800;
  document.querySelectorAll<HTMLElement>('[data-turntable]').forEach((turntable) => {
    const button = turntable.querySelector<HTMLElement>('[data-spin]')!;
    const disc = turntable.querySelector<HTMLElement>('.disc');
    const sleeve = disc?.closest<HTMLElement>('.sleeve');
    if (!disc || !sleeve) return;
    // Album page with tracks on YouTube Music: the record's sound follows the turntable.
    const sound = turntable.dataset.play ? albumPlayer(JSON.parse(turntable.dataset.play), () => halt()) : null;
    const barPlays = sound ? [...document.querySelectorAll<HTMLElement>('[data-bar-play]')] : []; // mini row + full card
    let spin: Animation | null = null;
    let ramp = 0;
    let notes = 0;
    let playing = false;
    let visible = true;
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(sleeve);
    // Spin-up: the speed eases in like a platter catching up.
    const spinUp = (ms: number) => {
      cancelAnimationFrame(ramp);
      const from = spin!.playbackRate;
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / ms);
        spin!.playbackRate = from + (1 - from) * (1 - (1 - t) ** 2);
        if (t < 1) ramp = requestAnimationFrame(step);
      };
      ramp = requestAnimationFrame(step);
    };
    // Spin-down: coasts from its current speed and halts on a whole turn, back at the resting position it started from.
    // The light (.glare) stays still above it the whole time: the record turns under it. Returns how long the stop takes.
    const coast = () => {
      cancelAnimationFrame(ramp);
      const s = spin!;
      const from = Number(s.currentTime);
      const speed = Math.max(s.playbackRate, 0.4);
      s.pause();
      // about 1.1 s of travel at full speed (a ~2.2 s stop), rounded to a whole turn, never less than a third of one
      let to = Math.round((from + 1100 * speed) / REV_MS) * REV_MS;
      if (to - from < REV_MS / 3) to += REV_MS;
      const ms = (2 * (to - from)) / speed; // easing out from that speed: distance = speed × time / 2
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / ms);
        s.currentTime = from + (to - from) * t * (2 - t);
        if (t < 1) ramp = requestAnimationFrame(step);
      };
      ramp = requestAnimationFrame(step);
      return ms;
    };
    const set = (on: boolean) => {
      playing = on;
      button.setAttribute('aria-pressed', String(on));
      const label = on ? 'Stop the record' : 'Play the record';
      button.title = label;
      button.setAttribute('aria-label', label);
      // The tracklist shows what's playing: bars on the current track (moving while it plays), from the first play on.
      if (on) document.documentElement.setAttribute('data-album-started', '');
      document.documentElement.toggleAttribute('data-album-playing', on);
      barPlays.forEach((b) => {
        b.setAttribute('aria-pressed', String(on));
        b.setAttribute('aria-label', on ? 'Pause' : 'Play');
        b.title = `${on ? 'Pause' : 'Play'} (Space)`;
      });
    };
    // Reduced motion: the record stays still and nothing plays by itself; the player bar still plays the album.
    const toggle = (byUser: boolean) => {
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (still && (!byUser || !sound)) return;
      if (!playing) sound?.play(byUser); else sound?.stop(byUser);
      if (still) return set(!playing);
      if (!playing) {
        set(true);
        if (!spin) {
          // The resting record sits rolled out 38 % and turned 300°; the spin carries on from there.
          spin = disc.animate(
            [{ transform: 'translateX(38%) rotate(300deg)' }, { transform: 'translateX(38%) rotate(660deg)' }],
            { duration: REV_MS, iterations: Infinity },
          );
        }
        spin.playbackRate = 0;
        spin.play();
        spinUp(1100);
        emitBurst(sleeve, 'right', 3, 900, 400);
        clearInterval(notes);
        notes = window.setInterval(() => { if (visible && !document.hidden) emitBurst(sleeve, 'right', 1, 300); }, 1600);
      } else {
        set(false);
        clearInterval(notes);
        if (spin) coast();
      }
    };
    // The album ended or the browser refused sound: the record comes to rest without touching the sound.
    function halt() { if (playing) { set(false); clearInterval(notes); if (spin) coast(); } }
    // Music started from the page (this record, a tracklist row) brings a minimised player back (PlayerBar listens);
    // the player's own buttons don't.
    const showBar = () => { if (!playing) document.dispatchEvent(new Event('player:show')); };
    button.addEventListener('click', () => { showBar(); toggle(true); });
    turntable.querySelector('[data-spin-cover]')?.addEventListener('click', () => { showBar(); toggle(true); });
    // The player bar: play / pause is the record's; previous, next and a track in the queue start it if it's stopped.
    if (sound) {
      const start = () => { if (!playing) toggle(true); };
      barPlays.forEach((b) => b.addEventListener('click', () => toggle(true)));
      document.querySelector('[data-bar-prev]')?.addEventListener('click', () => { start(); sound.prev(); });
      document.querySelectorAll('[data-bar-next]').forEach((b) => b.addEventListener('click', () => { start(); sound.next(); }));
      // A click anywhere else on a playable tracklist row does the same as its number (user 2026-11-21); the title
      // (copies), the heart, the listen menu keep their own clicks.
      document.querySelectorAll<HTMLElement>('.track-row').forEach((row) => {
        const play = row.querySelector<HTMLElement>('.track-play');
        if (play) row.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('button, a, input, form, [popover]')) play.click(); });
      });
      // A track in the queue or the tracklist: plays it; the current one plays / pauses instead of starting over.
      document.querySelectorAll<HTMLElement>('[data-bar-go]').forEach((b) => b.addEventListener('click', () => {
        if (!b.closest('[data-player-bar]')) showBar();
        if (b.getAttribute('aria-current') === 'true') toggle(true);
        else { start(); sound.go(Number(b.dataset.barGo)); }
      }));
      // Keyboard (user, 2026-11-21): Space / K play-pause, ← → 5 s, Shift+← → previous / next, ↑ ↓ volume (so they
      // don't scroll album pages), Q queue, M mute.
      // Not while typing, not with Ctrl / ⌘ / Alt, not while a dialog or popover (photo viewer, date popup) has the
      // keys, and Space / Enter on a focused button or link stay theirs.
      const press = (sel: string) => document.querySelector<HTMLElement>(sel)?.click();
      document.addEventListener('keydown', (e) => {
        const t = e.target as HTMLElement;
        if (e.defaultPrevented || e.ctrlKey || e.metaKey || e.altKey) return;
        if (t.closest('input, textarea, select, [contenteditable]:not([contenteditable="false"])')) return;
        if (document.querySelector('dialog[open], [popover]:popover-open')) return;
        const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
        if (key === ' ' && t.closest('button, a, summary')) return;
        const act: Record<string, () => void> = e.shiftKey
          ? { ArrowLeft: () => press('[data-bar-prev]'), ArrowRight: () => press('[data-bar-next]') }
          : { ' ': () => toggle(true), k: () => toggle(true), ArrowLeft: () => sound.seekBy(-5), ArrowRight: () => sound.seekBy(5), ArrowUp: () => sound.volumeBy(10), ArrowDown: () => sound.volumeBy(-10), q: () => press('[data-bar-expand]'), m: () => press('[data-bar-mute]') };
        const run = act[key];
        if (!run) return;
        e.preventDefault();
        run();
      });
    }
    // Start playing as the roll-out (CSS `roll-out`, 0.25 s delay + 1.6 s) settles.
    let started = false;
    // An album whose sound stays off (paused on an earlier visit) rests too: spinning would say it's playing.
    const autoplay = () => { if (!started && !playing && sound?.willAutoplay() !== false) { started = true; toggle(false); } };
    disc.addEventListener('animationend', (e) => { if (e.animationName === 'roll-out') autoplay(); }, { once: true });
    setTimeout(autoplay, 2000);
  });

  // Album page and the shelf's Latest (user 2026-11-21: the same on both): the turntable leans toward the mouse, the side under the pointer coming forward, on a spring (stiffness
  // 120, damping 16, like React Bits' ReflectiveCard); the sleeve's glare follows the pointer and its band of light
  // slides with the tilt (.sleeve-shine). Mouse only (a tilt under a finger would fight scrolling), none with reduced motion.
  const TILT = 10;
  if (matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
    document.querySelectorAll<HTMLElement>('[data-turntable]').forEach((el) => {
      let tx = 0, ty = 0, rx = 0, ry = 0, vx = 0, vy = 0, last = 0, frame = 0;
      const step = (now: number) => {
        const dt = Math.min(0.032, (now - last) / 1000 || 0.016);
        last = now;
        vx += (120 * (ty * TILT - rx) - 16 * vx) * dt; rx += vx * dt;
        vy += (120 * (-tx * TILT - ry) - 16 * vy) * dt; ry += vy * dt;
        el.style.transform = `perspective(900px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg)`;
        el.style.setProperty('--band', `${(50 - (ry / TILT) * 45).toFixed(1)}%`);
        const resting = Math.abs(ty * TILT - rx) + Math.abs(-tx * TILT - ry) + Math.abs(vx) + Math.abs(vy) < 0.02;
        if (resting && !tx && !ty) el.style.transform = '';
        frame = resting ? 0 : requestAnimationFrame(step);
      };
      const run = () => { if (!frame) { last = performance.now(); frame = requestAnimationFrame(step); } };
      el.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse') return;
        const r = el.getBoundingClientRect();
        tx = Math.max(-1, Math.min(1, ((e.clientX - r.left) / r.width) * 2 - 1));
        ty = Math.max(-1, Math.min(1, ((e.clientY - r.top) / r.height) * 2 - 1));
        el.style.setProperty('--gx', `${((tx + 1) * 50).toFixed(1)}%`);
        el.style.setProperty('--gy', `${((ty + 1) * 50).toFixed(1)}%`);
        el.style.setProperty('--glare', '1');
        run();
      });
      el.addEventListener('pointerleave', () => { tx = ty = 0; el.style.setProperty('--glare', '0'); run(); });
    });
  }
</script>
