---
// What a visitor can do with a wishlist record, on its page: "Log in to reserve" (logged out: no reserved state at all),
// Reserve, someone's "Reserved", or their own reservation: when they're giving it, "I gave it", Cancel. The owner gets
// nothing here (gifts stay a surprise). Each button is a form posted to the wishlist page, which comes back to `back`.
import { displayDate } from '@shared/lib/lib';
import type { ReserveState } from '@shared/lib/wishlist';

interface Props {
  state: ReserveState;
  item: string;
  giveOn: string | null;
  ownerFirst: string;
  /** The wishlist page, which handles the forms. */
  action: string;
  /** Where to come back to (this page). */
  back: string;
  loginHref: string;
  class?: string;
}
const { state, item, giveOn, ownerFirst, action, back, loginHref, class: className = '' } = Astro.props;
const today = new Date().toISOString().slice(0, 10);
const lastDay = new Date(Date.now() + 365 * 86400_000).toISOString().slice(0, 10);
---
{state !== 'none' && (
  <div class={className}>
    {state === 'login' && (
      <div class="flex flex-wrap items-center gap-3">
        <a href={loginHref} class="btn-primary">Log in to reserve</a>
        <span class="text-sm text-zinc-500">Giving it to {ownerFirst}? Reserve it so nobody else buys the same one.</span>
      </div>
    )}
    {state === 'free' && (
      <form method="post" action={action} class="flex flex-wrap items-center gap-3">
        <input type="hidden" name="action" value="reserve" /><input type="hidden" name="item" value={item} /><input type="hidden" name="back" value={back} />
        <button class="btn-primary">Reserve to give it</button>
        <span class="text-sm text-zinc-500">{ownerFirst} won’t see it’s reserved, or by whom.</span>
      </form>
    )}
    {state === 'taken' && <p class="text-sm text-zinc-500">Someone has reserved this one to give {ownerFirst}.</p>}
    {state === 'mine' && (
      <div class="rounded-2xl bg-(--on-bg) text-(--on-text) px-4 py-3 text-sm">
        <p class="font-medium">Reserved by you{giveOn && `, to give on ${displayDate(giveOn)}`}. Nobody else can see it’s you.</p>
        <div class="mt-3 flex flex-wrap items-end gap-x-4 gap-y-3">
          <form method="post" action={action} class="flex items-end gap-2">
            <input type="hidden" name="action" value="give-on" /><input type="hidden" name="item" value={item} /><input type="hidden" name="back" value={back} />
            <label class="flex flex-col gap-1 text-xs">When are you giving it?
              <input type="date" name="give_on" value={giveOn ?? ''} min={today} max={lastDay}
                class="h-8 rounded-full bg-white/70 dark:bg-zinc-950/40 px-3 text-sm text-zinc-900 dark:text-white" />
            </label>
            <button class="ctl">Save date</button>
          </form>
          <form method="post" action={action}>
            <input type="hidden" name="action" value="gifted" /><input type="hidden" name="item" value={item} /><input type="hidden" name="back" value={back} />
            <button class="btn-primary btn-sm" title={`${ownerFirst} will be told it’s from you`}>I gave it to {ownerFirst}</button>
          </form>
          <form method="post" action={action}>
            <input type="hidden" name="action" value="unreserve" /><input type="hidden" name="item" value={item} /><input type="hidden" name="back" value={back} />
            <button class="ctl">Cancel reservation</button>
          </form>
        </div>
        <p class="mt-2 text-xs opacity-80">“I gave it” tells {ownerFirst} the gift was from you, so press it once it’s handed over.</p>
      </div>
    )}
  </div>
)}
