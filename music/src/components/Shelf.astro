---
// A collector's shelf: a featured latest record, filters (added, released, genres) and search like Writing.astro,
// sorting, and two views of the records: on shelves, or listed like blog articles.
import RecordHero from './RecordHero.astro';
import Note from './Note.astro';
import WishlistLink from './WishlistLink.astro';
import RecordBrowser, { type BrowserItem } from './RecordBrowser.astro';
import type { shelfView } from '@shared/lib/lib';

interface Props {
  owner: { name: string; slug: string; discogs_username: string; telegram: string | null; note: string | null; photo?: string | null };
  records: ReturnType<typeof shelfView>[];
  commentCount: number;
  /** Records on the shelf's wishlist (shown to visitors when there are any, always to the owner). */
  wishCount: number;
  /** The visitor owns this shelf: they can write its note (`?note` opens the editor). */
  canEdit: boolean;
  editingNote: boolean;
}
const { owner, records, commentCount, wishCount, canEdit, editingNote } = Astro.props;
const base = `/${encodeURIComponent(owner.slug)}`;
const latest = records[0];
const items: BrowserItem[] = records.map((r) => ({
  id: String(r.instanceId), href: `${base}/${r.instanceId}`, record: r, added: r.added, releasedYear: r.releasedYear,
  // The first release date when it's a date ("1959-08-17"; an owner may have typed something else).
  releasedOn: r.released.match(/^\d{4}(-\d{2}){0,2}/)?.[0] ?? null, genres: r.genres,
  search: [r.labels, r.year, r.releasedYear, ...r.genres, ...(r.styles ?? []), ...r.fields.map((f) => f.value)].join(' '),
}));
---

<div id="shelf" class="font-normal">
  {latest && (
    <section class="mt-2">
      <RecordHero record={latest} artist={latest.artist} title={latest.title} released={latest.released} genres={latest.genres}
        trackCount={latest.trackCount} links={latest.links} runtime={latest.runtime ?? undefined} href={`${base}/${latest.instanceId}`}>
        <!-- The wishlist's button at the other end of the Latest row (user 2026-11-25); always for the owner. -->
        <div slot="above" class="flex flex-1 items-center justify-between gap-4">
          <h2 class="font-sans"><span class="inline-block rounded-full bg-bengara-tint px-2.5 py-0.5 text-sm font-medium text-bengara dark:bg-bengara-tint-dark dark:text-bengara-light">Latest</span></h2>
          {(wishCount > 0 || canEdit) && <WishlistLink href={`${base}/wishlist`} count={wishCount} />}
        </div>
      </RecordHero>
    </section>
  )}
  {!latest && (wishCount > 0 || canEdit) && <div class="mt-2 flex justify-end"><WishlistLink href={`${base}/wishlist`} count={wishCount} /></div>}

  <!-- The shelf's card, between the Latest hero and the whole collection (user, 2026-10-29): the collector's photo, the
       shelf's name, its counts and Telegram (user 2026-11-21: merged into it from the top of the page), then their note. -->
  <Note class={latest ? 'mt-12' : 'mt-2'} note={owner.note} by={owner.name} photo={owner.photo} heading={`${owner.name}’s records`} level="h1" always
    stats={{ records: records.length, recordsHref: '#all-records', recordsTitle: 'Records: jump to the list', comments: commentCount, telegram: owner.telegram }}
    about="the collection" base={base} canEdit={canEdit} editing={editingNote}
    addText="Add a short note about your collection: what you collect, how it started. Visitors see it here."
    placeholder="What you collect, how it started, what you’re hunting for…">
    <p id="sync-progress" class="mt-1 text-xs text-zinc-500 empty:hidden" role="status" aria-live="polite"></p>
  </Note>

  {records.length === 0 ? (
    <div class="py-12 text-center">
      <!-- An empty record crate, with the collector's name on its front board. -->
      <div class="crate-empty" aria-hidden="true"><div class="crate-front"><span class="crate-name">{owner.name}’s records</span></div></div>
      <p class="mt-6 text-zinc-500">The shelf is still empty. Records appear here a few minutes after they’re added on Discogs.</p>
    </div>
  ) : (
    <>

      <section id="all-records" class="mt-12">


        <h2 class="sr-only">All records</h2>
        <RecordBrowser items={items} />

        <a href={`https://www.discogs.com/user/${encodeURIComponent(owner.discogs_username)}/collection`} class="mt-10 inline-block text-sm font-medium text-kikyo-600 dark:text-kikyo-400 hover:bg-kikyo-50 dark:hover:bg-kikyo-500/15 -mx-4 px-4 py-2 rounded-full transition-colors">View Discogs catalogue</a>
      </section>
    </>
  )}

</div>

<script>
  import { autoSync } from '../lib/sync';

  const progress = document.getElementById('sync-progress');
  autoSync((message) => { if (progress) progress.textContent = message; });
</script>
