---
// One "where to get it" line in the wishlist form: a shop's name and / or link, and − to remove the line (wish-form.ts
// adds lines with + from a <template> of this same field).
import WishIcon from './WishIcon.astro';
interface Props { value?: string }
const { value = '' } = Astro.props;
---
<div data-shop class="flex items-center gap-2">
  <span class="relative flex-1 min-w-0">
    <WishIcon name="where" class="pointer-events-none absolute left-3.5 top-3 w-4.5 h-4.5 text-zinc-400 dark:text-zinc-500" />
    <input name="where" maxlength="300" value={value} placeholder="Rough Trade https://…" aria-label="A shop: its name and / or link"
      class="w-full rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950 pl-10 pr-3.5 py-2.5 text-zinc-900 dark:text-white focus:outline-none focus:border-kikyo-500 transition-colors" />
  </span>
  <button type="button" data-shop-remove aria-label="Remove this shop" title="Remove this shop" class="ctl !px-0 w-8 justify-center shrink-0">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14" /></svg>
  </button>
</div>
