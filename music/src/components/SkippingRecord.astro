---
// "Not found", the same on every music page that can miss (2026-11-22): a record whose needle skips (styles in
// global.css, "Not found"), the heading stuttering once, and the page's own explanation in the slot.
interface Props { heading?: string }
const { heading = 'Page not found' } = Astro.props;
---
<div class="flex flex-col sm:flex-row items-center sm:items-center gap-8 sm:gap-12 py-8">
  <div class="skip-record sleeve relative w-40 sm:w-48 aspect-square shrink-0" aria-hidden="true">
    <span class="disc"></span>
    <span class="glare"></span>
    <!-- The tonearm: pivots at the top right, its head resting in the grooves. -->
    <span class="skip-arm absolute right-[2%] top-[-6%] h-[62%] w-1.5 origin-top" style="transform: rotate(28deg)">
      <span class="absolute inset-x-0 top-0 bottom-3 rounded-full bg-zinc-400 dark:bg-zinc-500"></span>
      <span class="absolute -left-1 bottom-0 h-4 w-3.5 rounded-sm bg-zinc-600 dark:bg-zinc-300"></span>
      <span class="absolute -left-1.5 -top-1.5 h-4.5 w-4.5 rounded-full bg-zinc-300 dark:bg-zinc-600"></span>
    </span>
  </div>
  <div class="text-center sm:text-left">
    <h1 class="skip-text text-3xl font-bold text-zinc-900 dark:text-white">{heading}</h1>
    <p class="mt-3 text-zinc-500"><slot /></p>
  </div>
</div>
