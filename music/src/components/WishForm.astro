---
// Adding an album to the owner's own wishlist (user 2026-11-25: one line, like anon's box): "Search for an album, or
// paste a link" with + inside. Typed words list Apple Music's albums to pick from; a pasted Apple Music / Spotify /
// YouTube Music link fills in the album (music/src/scripts/wish-form.ts); the box opens below to check it and add the
// extras. Without picking (or without script), a typed "Artist – Album" is split into the two fields (server too). Editing an album shows it open. The server
// checks everything again (toWish).
import Disclosure from '@shared/components/Disclosure.astro';
import { NOTE_MAX } from '@shared/lib/lib';
import WishIcon from './WishIcon.astro';
import ShopField from './ShopField.astro';
import { WHERE_MAX, whereLines } from '@shared/lib/wishlist';

interface Props {
  /** The values shown: an album being edited, or what was typed before an error. */
  values?: { artist?: string; title?: string; year?: string | number | null; cover?: string | null; tracklist?: string; note?: string | null;
    links?: Record<string, string>; where?: string[] | string | null; top?: boolean };
  /** The album being edited (absent when adding). */
  editId?: number;
  error?: string | null;
}
const { values = {}, editId, error } = Astro.props;
const links = values.links ?? {};
const shops = whereLines(values.where);
const open = !!editId || !!error;
const input = 'w-full rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950 px-3.5 py-2.5 text-zinc-900 dark:text-white focus:outline-none focus:border-kikyo-500 transition-colors';
const label = 'flex flex-col gap-1.5 text-sm font-medium text-zinc-700 dark:text-zinc-300';
// Each field with its icon inside, on the left (the same icons mark a filled field on the record).
const withIcon = `${input} pl-10`;
const iconAt = 'pointer-events-none absolute left-3.5 top-3 w-4.5 h-4.5 text-zinc-400 dark:text-zinc-500';
const hint = 'font-normal text-zinc-500';
---
<form id="add" method="post" data-wish-form tabindex="-1" class:list={['compose-form outline-none scroll-mt-6', open && 'open']}>
  <input type="hidden" name="action" value={editId ? 'edit' : 'add'} />
  {editId && <input type="hidden" name="id" value={editId} />}
  <!-- The box searches Apple Music as you type (user 2026-11-25: "nothing was the same by drake"); picking a suggestion
       fills everything. -->
  <div class="relative">
    <div data-toast-avoid class="compose flex items-center gap-2 pr-1.5">
      {editId ? (
        <span class="flex-1 min-w-0 truncate pl-5 py-3 font-medium text-zinc-900 dark:text-white">Editing {values.artist} – {values.title}</span>
      ) : (
        <WishIcon name="search" class="shrink-0 ml-4 w-5 h-5 text-zinc-400 dark:text-zinc-500" />
        <input name="link" data-wish-link autocomplete="off" aria-label="Search for an album, or paste a link to one"
          role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="wish-suggest"
          placeholder="Search for an album, or paste a link"
          class="flex-1 min-w-0 bg-transparent pl-1 py-3 text-zinc-900 dark:text-white placeholder:text-zinc-400 dark:placeholder:text-zinc-500 focus:outline-none" />
      )}
      <button class="btn-primary shrink-0 w-10 px-0" aria-label={editId ? 'Save' : 'Add to the wishlist'} title={editId ? 'Save' : 'Add to the wishlist'}>
        {editId
          ? <svg class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4.5 12.75 6 6 9-13.5" /></svg>
          : <svg class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>}
      </button>
    </div>
    <ul id="wish-suggest" data-wish-suggest role="listbox" aria-label="Albums on Apple Music" hidden
      class="glass absolute left-0 right-0 top-full mt-2 z-40 rounded-3xl p-1.5 max-h-[22rem] overflow-y-auto"></ul>
  </div>
  <p data-wish-status role="status" aria-live="polite" class="mt-2 px-5 text-sm text-zinc-500 empty:hidden">{error}</p>

  <!-- Shown while in use (shared .compose-form): the album as found or typed, and the extras. -->
  <div class="open-only mt-3 rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-night-surface p-5 space-y-4">
    <div class="flex gap-4 items-start">
      <img data-wish-cover-preview src={values.cover || undefined} alt="" hidden={!values.cover} width="80" height="80" referrerpolicy="no-referrer" class="w-20 h-20 rounded-lg object-cover shrink-0" />
      <input type="hidden" name="cover" value={values.cover ?? ''} />
      <div class="grid sm:grid-cols-[1fr_1fr_5.5rem] gap-3 flex-1 min-w-0">
        <label class={label}>Artist <span class="relative"><WishIcon name="artist" class={iconAt} /><input name="artist" maxlength="300" value={values.artist ?? ''} class={withIcon} /></span></label>
        <label class={label}>Album <span class="relative"><WishIcon name="album" class={iconAt} /><input name="title" maxlength="300" value={values.title ?? ''} class={withIcon} /></span></label>
        <label class={label}>Year <span class="relative"><WishIcon name="year" class={iconAt} /><input name="year" inputmode="numeric" pattern="\d{4}" maxlength="4" value={values.year ?? ''} class={withIcon} /></span></label>
      </div>
    </div>
    <div class="grid gap-4">
      <!-- Shops: a line each, + adds one (up to WHERE_MAX), − removes one (wish-form.ts; without script, an emptied line is dropped). -->
      <div class={label}>
        <span>Where to get it <span class={hint}>(optional)</span></span>
        <div data-shops data-max={WHERE_MAX} class="space-y-2">{(shops.length ? shops : ['']).map((w) => <ShopField value={w} />)}</div>
        <template data-shop-template><ShopField /></template>
        <button type="button" data-shop-add class="ctl self-start">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
          Add a shop
        </button>
      </div>
      <label class={label}><span>A note for whoever gives it <span class={hint}>(optional)</span></span>
        <span class="relative"><WishIcon name="note" class={iconAt} /><input name="note" maxlength={NOTE_MAX} value={values.note ?? ''} placeholder="The red pressing, please" class={withIcon} /></span>
      </label>
    </div>
    <Disclosure title="Tracklist and links">
      <div class="space-y-3 pt-1">
        <label class={label}><span>Tracklist <span class={hint}>One track per line: “1 | Title | 4:52”.</span></span>
          <span class="relative"><WishIcon name="tracklist" class={iconAt} /><textarea name="tracklist" rows="6" class={`${withIcon} font-mono text-sm`}>{values.tracklist ?? ''}</textarea></span>
        </label>
        <div class="grid sm:grid-cols-3 gap-3">
          <label class={label}>Spotify <span class="relative"><WishIcon name="link" class={iconAt} /><input name="spotify" type="url" value={links.spotify ?? ''} class={withIcon} /></span></label>
          <label class={label}>Apple Music <span class="relative"><WishIcon name="link" class={iconAt} /><input name="apple" type="url" value={links.apple ?? ''} class={withIcon} /></span></label>
          <label class={label}>YouTube Music <span class="relative"><WishIcon name="link" class={iconAt} /><input name="youtube" type="url" value={links.youtube ?? ''} class={withIcon} /></span></label>
        </div>
      </div>
    </Disclosure>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <label class="flex items-center gap-2.5 text-sm font-medium text-zinc-700 dark:text-zinc-300 cursor-pointer">
        <input type="checkbox" name="top" checked={values.top} class="w-4 h-4 accent-kikyo-600" />
        Most wanted
      </label>
      <div class="flex items-center gap-2">
        {editId && <a href="?#list" class="ctl">Cancel</a>}
        <button type="reset" class="ctl" title={editId ? 'Put back what’s saved' : 'Empty every field'}>{editId ? 'Reset' : 'Clear'}</button>
        <button class="btn-primary btn-sm">{editId ? 'Save' : 'Add to the wishlist'}</button>
      </div>
    </div>
  </div>
</form>

<script>
  import '../scripts/wish-form';
</script>
