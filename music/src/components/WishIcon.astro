---
// The wishlist's field icons, one set everywhere (user 2026-11-25): in the add / edit form beside each field, and on a
// record (its sleeve, its list row, its page) when the field is filled, so a note or a shop shows at a glance.
export type WishIconName = 'artist' | 'album' | 'year' | 'where' | 'note' | 'tracklist' | 'link';
interface Props { name: WishIconName; class?: string; label?: string }
const { name, class: className = 'w-4 h-4', label } = Astro.props;
const paths: Record<WishIconName, string> = {
  artist: 'M12 14.5a3 3 0 0 0 3-3V6a3 3 0 1 0-6 0v5.5a3 3 0 0 0 3 3ZM17.5 11.5a5.5 5.5 0 0 1-11 0M12 17v3.5',
  album: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18ZM12 9.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Z',
  year: 'M5.5 5h13a2 2 0 0 1 2 2v11.5a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2ZM8 3v4M16 3v4M3.5 10h17',
  // A shop front with an awning (a shopping bag read as a bin at 14 px).
  where: 'M3.5 9.5 5 4h14l1.5 5.5M3.5 9.5h17M3.5 9.5a2.8 2.8 0 0 0 5.67 0 2.8 2.8 0 0 0 5.66 0 2.8 2.8 0 0 0 5.67 0M5 12.5v7.5h14v-7.5M10 20v-4.5h4V20',
  note: 'M7 3.5h7l4 4v13H7ZM14 3.5v4h4M9.5 12h6M9.5 15.5h4',
  tracklist: 'M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01',
  link: 'M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1',
};
---
<svg class={className} fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label}>
  {label && <title>{label}</title>}<path d={paths[name]} />
</svg>
