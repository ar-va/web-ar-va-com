---
// One record on a wishlist: sleeve, artist, album, year, listen menu, the tracklist folded under it, and what this viewer
// can do. Visitors: "Log in to reserve" (logged out: no reserved state at all), Reserve, someone's "Reserved", or their
// own reservation with its giving date, "I gave it" and Cancel. The owner: nothing about reservations (gifts stay a
// surprise); Edit and Remove on albums added on the site. Every button is a form posted to the page (no script needed).
import Cover from '@shared/components/Cover.astro';
import Disclosure from '@shared/components/Disclosure.astro';
import Listen from './Listen.astro';
import { displayDate, runtime } from '@shared/lib/lib';
import { wishAnchor, type WishItem } from '../lib/wishes';
import type { ReserveState } from '@shared/lib/wishlist';

interface Props {
  item: WishItem & { state: ReserveState; giveOn: string | null };
  /** The owner's first name ("I gave it to Artur"). */
  ownerFirst: string;
  isOwner: boolean;
  /** Log in, then back to this row. */
  loginHref: string;
  /** Today and a year ahead (UTC), the giving date's range. */
  today: string;
  lastDay: string;
}
const { item, ownerFirst, isOwner, loginHref, today, lastDay } = Astro.props;
const anchor = wishAnchor(item.key);
const songs = item.tracks.filter((t) => !t.heading);
const length = runtime(item.tracks);
const facts = [item.year, songs.length ? `${songs.length} track${songs.length === 1 ? '' : 's'}` : null, length].filter(Boolean).join(', ');
---
<li id={anchor} class="py-4 border-b border-zinc-100 dark:border-zinc-800/40 last:border-none scroll-mt-6">
  <div class="flex items-start gap-4">
    <Cover record={item} class="w-16 sm:w-20 shrink-0" />
    <div class="min-w-0 flex-1">
      <div class="flex items-start gap-2">
        <div class="min-w-0 flex-1">
          <p class="text-sm font-medium text-kashiwa dark:text-kashiwa-light truncate">{item.artist}</p>
          <h2 class="text-lg font-bold leading-snug text-zinc-900 dark:text-white">{item.title}</h2>
          {facts && <p class="mt-0.5 text-sm text-zinc-500">{facts}</p>}
        </div>
        <Listen query={`${item.artist} ${item.title}`} label={`${item.artist}, ${item.title}`} links={item.links} />
      </div>
      {item.note && <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400 whitespace-pre-line">“{item.note}”</p>}

      <div class="mt-3 flex flex-wrap items-center gap-2">
        {item.state === 'login' && <a href={loginHref} class="ctl">Log in to reserve</a>}
        {item.state === 'free' && (
          <form method="post">
            <input type="hidden" name="action" value="reserve" /><input type="hidden" name="item" value={item.key} />
            <button class="btn-primary btn-sm">Reserve</button>
          </form>
        )}
        {item.state === 'taken' && <span class="ctl !cursor-default !bg-transparent text-zinc-500">Reserved by someone</span>}
        {isOwner && item.wish && (
          <>
            <a href={`?edit=${item.instanceId}#add`} class="ctl">Edit</a>
            <form method="post">
              <input type="hidden" name="action" value="remove" /><input type="hidden" name="id" value={item.instanceId} />
              <button class="ctl">Remove</button>
            </form>
          </>
        )}
      </div>

      {item.state === 'mine' && (
        <div class="mt-3 rounded-2xl bg-(--on-bg) text-(--on-text) px-4 py-3 text-sm">
          <p class="font-medium">Reserved by you{item.giveOn && `, to give on ${displayDate(item.giveOn)}`}. Nobody else can see it’s you.</p>
          <div class="mt-3 flex flex-wrap items-end gap-x-4 gap-y-3">
            <form method="post" class="flex items-end gap-2">
              <input type="hidden" name="action" value="give-on" /><input type="hidden" name="item" value={item.key} />
              <label class="flex flex-col gap-1 text-xs">When are you giving it?
                <input type="date" name="give_on" value={item.giveOn ?? ''} min={today} max={lastDay}
                  class="h-8 rounded-full bg-white/70 dark:bg-zinc-950/40 px-3 text-sm text-zinc-900 dark:text-white" />
              </label>
              <button class="ctl">Save date</button>
            </form>
            <form method="post">
              <input type="hidden" name="action" value="gifted" /><input type="hidden" name="item" value={item.key} />
              <button class="btn-primary btn-sm" title={`${ownerFirst} will be told it’s from you`}>I gave it to {ownerFirst}</button>
            </form>
            <form method="post">
              <input type="hidden" name="action" value="unreserve" /><input type="hidden" name="item" value={item.key} />
              <button class="ctl">Cancel reservation</button>
            </form>
          </div>
          <p class="mt-2 text-xs opacity-80">“I gave it” tells {ownerFirst} the gift was from you, so press it once it’s handed over.</p>
        </div>
      )}

      {songs.length > 0 && (
        <Disclosure title="Tracklist" class="mt-3 text-sm">
          <ol class="space-y-1">
            {item.tracks.map((t) => t.heading
              ? <li class="pt-2 font-medium text-zinc-700 dark:text-zinc-300">{t.title}</li>
              : <li class="flex gap-3"><span class="w-8 shrink-0 font-mono text-zinc-500">{t.position}</span><span class="flex-1 min-w-0">{t.title}</span>{t.duration && <span class="font-mono text-zinc-500">{t.duration}</span>}</li>)}
          </ol>
        </Disclosure>
      )}
    </div>
  </div>
</li>
