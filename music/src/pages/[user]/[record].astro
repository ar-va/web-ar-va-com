---
// One record: Discogs details (with the owner's edits), public Discogs fields, tracklist with listening links, comments.
export const prerender = false;
import Layout from '@shared/layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RecordHero from '../../components/RecordHero.astro';
import PlayerBar from '../../components/PlayerBar.astro';
import Gallery from '../../components/Gallery.astro';
import Note from '../../components/Note.astro';
import LoginButton from '@shared/components/LoginButton.astro';
import CommentThread from '@shared/components/CommentThread.astro';
import Listen from '../../components/Listen.astro';
import { youtubeId, addedNeedsDate, cleanNote, commentNotices, safeDay, displayDate, formatReleased, gallery, loginHref, popularTracks, recordDefaults, shortCount, recordValues, shelfView, textToTracklist, titleKey, withSideHeadings } from '@shared/lib/lib';
import { addComment, canDeleteComment, currentUser, deleteComment, editComment, recordData, saveOverrides, shelfSlug } from '@shared/lib/store';
import { notify } from '@shared/lib/notify';

const instanceId = Number(Astro.params.record);
const [user, { owner, record, overrides, detail, match, comments, sameDay, shelfSize }] = await Promise.all([
  currentUser(Astro.cookies),
  recordData(Astro.params.user!, Number.isSafeInteger(instanceId) ? instanceId : 0),
]);
const path = Astro.url.pathname;
const thread = { shelfId: owner?.id ?? 0, instanceId };

let error: string | null = null;
let draft = '';
if (owner && record && Astro.request.method === 'POST') {
  if (!user) return Astro.redirect(loginHref(Astro.url), 303);
  const form = await Astro.request.formData();
  const action = form.get('action');
  const id = Number(form.get('id'));
  // The "Added on" popup: the owner's day, or Discogs' confirmed (so it stops asking).
  if (action === 'added' || action === 'added-ok') {
    if (user.id === owner.id) {
      const { added: _a, addedChecked: _c, ...rest } = overrides;
      const day = action === 'added' ? safeDay(String(form.get('added') ?? '')) : null;
      const discogsDay = record.added.slice(0, 10);
      if (action === 'added-ok' || day === discogsDay) await saveOverrides(owner.id, instanceId, { ...rest, addedChecked: '1' });
      else if (day) await saveOverrides(owner.id, instanceId, { ...rest, added: day });
    }
    return Astro.redirect(path, 303);
  }
  // The owner's note under the album: one override key, the other edits stay as they are.
  // The owner's heart on a track: toggles it in the favourites (one override key, matched by title).
  if (action === 'favorite') {
    if (user.id === owner.id) {
      const title = String(form.get('title') ?? '').trim().slice(0, 300);
      const list = (overrides.favorites ?? '').split('\n').filter((x) => x.trim());
      const next = list.some((x) => titleKey(x) === titleKey(title)) ? list.filter((x) => titleKey(x) !== titleKey(title)) : [...list, title];
      const { favorites: _, ...rest } = overrides;
      if (title) await saveOverrides(owner.id, instanceId, next.length ? { ...rest, favorites: next.join('\n') } : rest);
    }
    return Astro.redirect(`${path}#tracklist`, 303);
  }
  if (action === 'note') {
    if (user.id === owner.id) {
      const { note: _, ...rest } = overrides;
      const note = cleanNote(String(form.get('note') ?? ''));
      await saveOverrides(owner.id, instanceId, note ? { ...rest, note } : rest);
    }
    return Astro.redirect(`${path}#note`, 303);
  }
  if (action === 'delete') {
    await deleteComment(thread, id, user);
    return Astro.redirect(`${path}#comments`, 303);
  }
  if (action === 'edit') {
    error = await editComment(thread, id, user, String(form.get('body') ?? ''));
    if (!error) return Astro.redirect(`${path}#comment-${id}`, 303);
  } else {
    draft = String(form.get('body') ?? '');
    const saved = await addComment(thread, user, draft, Number(form.get('parent_id')) || null);
    if ('error' in saved) {
      error = saved.error;
    } else {
      const title = overrides.title ?? record.title;
      Astro.locals.cfContext.waitUntil(notify(commentNotices({
        authorId: user.id, authorName: user.name, ownerId: owner.id, parentAuthorId: saved.parentAuthorId,
        title, body: draft.trim(), url: `${Astro.url.origin}${path}#comment-${saved.id}`,
      })));
      return Astro.redirect(`${path}#comment-${saved.id}`, 303);
    }
  }
}

if (!owner || !record) Astro.response.status = 404;
const v = record ? recordValues(recordDefaults(record, detail, match), overrides) : {};
const tracks = record ? withSideHeadings(textToTracklist(v.tracklist)) : [];
// Marks in the tracklist: the most played on YouTube (objective) and the owner's favourites (their pick).
const popular = popularTracks(tracks, match);
// The record's sound: every track with a YouTube or YouTube Music link (the owner's or the automatic match), in order.
// Each playable track's place in that queue, so the tracklist can play it and show what's playing.
const playIndex = new Map<object, number>();
const play = tracks.flatMap((t) => {
  const id = !t.heading && youtubeId(t.links?.youtube);
  if (!id) return [];
  playIndex.set(t, playIndex.size);
  return [{ id, title: t.title, duration: t.duration }];
});
const favorites = new Set((v.favorites ?? '').split('\n').filter((x) => x.trim()).map(titleKey));
const ownerFirst = owner?.name.split(' ')[0] ?? '';
const hero = record ? shelfView(record, detail, overrides, match) : null;
const photos = record ? gallery(hero!.cover, record.cover, detail?.images) : [];
const isOwner = !!user && user.id === owner?.id;

const shelfPath = owner ? `/${encodeURIComponent(shelfSlug(owner))}` : '/';

// Artist and album are the hero's title: the details start after them.
const rows: [string, string | null | undefined][] = record ? [
  ['Released', displayDate(v.released)],
  ['Vinyl release', displayDate(v.vinylRelease)],
  ['Genre', v.genre],
  ['Style', v.style],
  ['Label', v.label],
  ['Format', v.format],
  ['Country', v.country],
  ['Added to collection', formatReleased(v.added)],
  ...Object.entries(v).filter(([k]) => k.startsWith('field:')).map(([k, value]) => [k.slice(6), value] as [string, string]),
] : [];
// What the closed details card shows: the pressing at a glance.
const preview = record ? [v.label, v.format, v.country].filter(Boolean) : [];
const link = 'text-kikyo-600 dark:text-kikyo-400 underline decoration-kikyo-500/30 hover:decoration-kikyo-500 underline-offset-4 transition-colors';
---
<Layout title={record ? `${v.title} by ${v.artist} - ARVA` : 'Not found - ARVA'} description={record ? `${v.artist} – ${v.title}${v.released ? ` (${displayDate(v.released)})` : ''}, on ${owner!.name}’s shelf.` : undefined}>
  {!record || !owner ? (
    <div class="max-w-5xl mx-auto px-6 w-full flex-grow pt-12 pb-24 *:max-w-3xl">
      <Breadcrumbs class="mb-8" items={[{ label: 'Shelves', href: '/' }, ...(owner ? [{ label: owner.name, href: shelfPath }] : []), { label: 'Not found' }]} />
      <p class="text-zinc-500">This record isn’t on the shelf (any more). <a href={shelfPath} class={link}>Back to the shelf</a></p>
    </div>
  ) : (
    <article class="max-w-5xl mx-auto px-6 w-full flex-grow pt-12 pb-24 *:max-w-3xl">
      <!-- Everything keeps the reading column (Edit ends where Details ends, the player is as wide as the tracklist;
           user 2026-11-21); only the hero uses the whole frame. The Edit pill's -my-1.5 keeps this row as tall as the
           breadcrumbs, so they sit exactly where the shelf page has them (they moved 6 px down for the owner). Phones:
           Edit goes under the breadcrumbs (it ran into their copy icon). It says "Edit record details" (user
           2026-11-21: plain "Edit" didn't say what gets edited). -->
      <div class="flex max-sm:flex-col max-sm:items-start sm:items-center justify-between gap-x-4 gap-y-3">
        <Breadcrumbs class="min-w-0" share items={[{ label: 'Shelves', href: '/' }, { label: owner.name, href: shelfPath }, { label: v.title }]} />
        {isOwner && (
          <a href={`${path}/edit`} class="ctl pl-2.5 sm:-my-1.5 whitespace-nowrap">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16.9 4.1a2.1 2.1 0 0 1 3 3L8.5 18.5 4 20l1.5-4.5z" /></svg>
            Edit record details
          </a>
        )}
      </div>
      {isOwner && <p id="sync-progress" class="text-xs text-zinc-500 empty:hidden mt-2" role="status" aria-live="polite"></p>}

      <header class="mt-10 mb-12 !max-w-none">
        <RecordHero record={hero!} artist={hero!.artist} title={hero!.title} released={hero!.released} genres={hero!.genres} trackCount={hero!.trackCount} links={hero!.links} runtime={hero!.runtime ?? undefined}
          askAdded={isOwner && addedNeedsDate(record.added, overrides, sameDay) ? { sameDay } : undefined} play={play}>
          <!-- The photos follow the text, 20 px under "Added" like its other lines (user 2026-11-21: under the cover they
               left a gap). The hero's text starts at a fixed height, so this doesn't lift the title above the shelf's
               identical Latest hero. -->
          <Gallery images={photos} title={hero!.title} />
        </RecordHero>
      </header>

      <Note class="mb-12" note={v.note || null} by={owner.name} photo={owner.photo_url} heading={`${ownerFirst}’s note`}
        stats={{ records: shelfSize, recordsHref: shelfPath, recordsTitle: `Records: ${owner.name}’s shelf`, comments: comments.length, telegram: owner.username }}
        about="this record" base={path} canEdit={isOwner}
        editing={isOwner && Astro.url.searchParams.has('note')}
        addText="Add a note about this record: where you found it, why it matters, a favourite moment."
        placeholder="Where you found it, why it matters, what to listen for…" />

      <!-- Details: a section like the tracklist, not a box (user 2026-11-21: the note is the page's one box, so the two
           don't look alike), still folding. Closed it previews the pressing (label, format, country). Native <details>:
           keyboard and screen readers included. -->
      {/* The chevrons sit on the heading's line (items-start; the 32px button = the 2xl heading's line), so they stay put
          while the preview line under the heading comes and goes (user 2026-11-21). */}
      <details id="details" class="group/details">
        <summary class="group/sum flex items-start gap-4 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-kikyo-500">
          <span class="min-w-0 flex-1">
            <h2 class="text-2xl font-bold text-zinc-900 dark:text-white">Details</h2>
            {preview.length > 0 && <span class="flex mt-1.5 text-sm text-zinc-500 truncate group-open/details:hidden">{preview.map((x) => <span class="fact truncate">{x}</span>)}</span>}
          </span>
          <span class="shrink-0 grid place-items-center w-8 h-8 rounded-full bg-(--well) group-hover/sum:bg-(--well-hover) text-zinc-700 dark:text-zinc-200 transition-colors">
            <svg class="w-4 h-4 transition-transform group-open/details:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" /></svg>
          </span>
        </summary>
        <dl class="pt-5 grid grid-cols-2 sm:grid-cols-3 gap-x-8 gap-y-5">
          {rows.filter(([, v]) => v).map(([k, v]) => (
            <div class="min-w-0">
              <dt class="text-sm text-zinc-500">{k}</dt>
              <dd class="mt-1 text-zinc-800 dark:text-zinc-200 whitespace-pre-line break-words">{v}</dd>
            </div>
          ))}
        </dl>
      </details>

      {tracks.length > 0 ? (
        <details id="tracklist" open class="group/tracks mt-14 scroll-mt-6">
          {/* Folds like Details (user 2026-11-21), open by default; closed it says how many tracks and how long. */}
          <summary class="group/sum flex items-start gap-4 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-kikyo-500">
            <span class="min-w-0 flex-1">
              <h2 class="text-2xl font-bold text-zinc-900 dark:text-white">Tracklist</h2>
              <span class="flex mt-1.5 text-sm text-zinc-500 group-open/tracks:hidden">
                <span class="fact">{hero!.trackCount} track{hero!.trackCount === 1 ? '' : 's'}</span>{hero!.runtime && <span class="fact">{hero!.runtime}</span>}
              </span>
            </span>
            <span class="shrink-0 grid place-items-center w-8 h-8 rounded-full bg-(--well) group-hover/sum:bg-(--well-hover) text-zinc-700 dark:text-zinc-200 transition-colors">
              <svg class="w-4 h-4 transition-transform group-open/tracks:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" /></svg>
            </span>
          </summary>
          {(popular.size > 0 || favorites.size > 0) && (
            <p class="mt-2 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-zinc-500">
              {popular.size > 0 && <span class="inline-flex items-center gap-1.5"><svg class="w-4 h-4 text-bengara dark:text-bengara-light" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.07-2.14-.22-4.05 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.15.43-2.29 1-3a2.5 2.5 0 0 0 2.5 2.5z" /></svg>Most played on YouTube</span>}
              {favorites.size > 0 && <span class="inline-flex items-center gap-1.5"><svg class="w-4 h-4 text-bengara dark:text-bengara-light" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" /></svg>{ownerFirst}’s favourites</span>}
            </p>
          )}
          <!-- Rows light up on hover; their listening icons show on hover or focus (always on touch screens). -->
          <ol class="mt-4 -mx-3">
            {tracks.map((t) => t.heading ? (
              <li class="px-3 pt-6 pb-2 first:pt-1 text-sm font-semibold text-zinc-900 dark:text-white">{t.title}</li>
            ) : (
              <li class="track-row group flex items-center gap-4 px-3 py-2.5 rounded-xl hover:bg-zinc-100 dark:hover:bg-white/[0.04] focus-within:bg-zinc-100 dark:focus-within:bg-white/[0.04] transition-colors">
                {/* A track the player has: its number turns into play on hover, bars while it's the one playing (user,
                    2026-11-21). data-bar-go joins it to the player's queue rows (RecordHero wires the click). */}
                {playIndex.has(t) ? (
                  <button type="button" data-bar-go={playIndex.get(t)} aria-label={`Play ${t.title}`} title="Play this track"
                    class="track-play w-7 h-6 shrink-0 grid place-items-center justify-items-start rounded-md cursor-pointer font-mono text-sm text-zinc-500 tabular-nums focus-visible:outline-2 focus-visible:outline-kikyo-500">
                    <span class="track-num">{t.position}</span>
                    <svg class="track-play-icon w-4 h-4 text-zinc-900 dark:text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.5 4.8v14.4a.8.8 0 0 0 1.2.7l11.3-7.2a.8.8 0 0 0 0-1.4L8.7 4.1a.8.8 0 0 0-1.2.7z" /></svg>
                    <svg class="track-pause-icon w-4 h-4 text-zinc-900 dark:text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4.2" height="14" rx="1.2" /><rect x="13.8" y="5" width="4.2" height="14" rx="1.2" /></svg>
                    <span class="track-eq text-kikyo-600 dark:text-kikyo-400" aria-hidden="true"><i></i><i></i><i></i></span>
                  </button>
                ) : (
                  <span class="w-7 shrink-0 font-mono text-sm text-zinc-500 tabular-nums">{t.position}</span>
                )}
                <span class="flex-grow min-w-0 text-zinc-800 dark:text-zinc-200"><button type="button" data-copy title="Click to copy" class="track-title cursor-copy text-left rounded-sm hover:opacity-75 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-kikyo-500 transition-[opacity,color]">{t.title}</button>
                  {popular.has(titleKey(t.title)) && (
                    <span title={`Most played: ${shortCount(popular.get(titleKey(t.title))!)} plays on YouTube`} class="ml-2 inline-flex align-[-2px] text-bengara dark:text-bengara-light">
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.07-2.14-.22-4.05 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.15.43-2.29 1-3a2.5 2.5 0 0 0 2.5 2.5z" /></svg><span class="sr-only">(one of the most played)</span>
                    </span>
                  )}
                  {/* The owner hearts tracks right here: a form (works without script), sent in the background by the script below. */}
                  {isOwner ? (
                    <form method="post" data-fav class="inline">
                      <input type="hidden" name="action" value="favorite" /><input type="hidden" name="title" value={t.title} />
                      <button aria-pressed={String(favorites.has(titleKey(t.title)))} title="Your favourite: click to mark or unmark" aria-label={`Favourite: ${t.title}`}
                        class="group/fav ml-1.5 inline-flex align-[-2px] rounded text-zinc-400 hover:text-kikyo-600 dark:hover:text-kikyo-400 aria-pressed:text-bengara dark:aria-pressed:text-bengara-light sm:opacity-0 sm:group-hover:opacity-100 sm:focus-visible:opacity-100 sm:aria-pressed:opacity-100 focus-visible:outline-2 focus-visible:outline-kikyo-500 transition">
                        <svg class="w-4 h-4 group-aria-pressed/fav:fill-current" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" /></svg>
                      </button>
                    </form>
                  ) : favorites.has(titleKey(t.title)) && (
                    <span title={`${ownerFirst}’s favourite`} class="ml-1.5 inline-flex align-[-2px] text-bengara dark:text-bengara-light">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" /></svg><span class="sr-only">({ownerFirst}’s favourite)</span>
                    </span>
                  )}
                </span>
                <span class="sm:opacity-0 sm:group-hover:opacity-100 sm:group-focus-within:opacity-100 sm:has-[:popover-open]:opacity-100 transition-opacity">
                  <Listen query={`${v.artist} ${t.title}`} label={`Listen to ${t.title}`} links={t.links} kind="track" />
                </span>
                {t.duration && <span class="w-12 shrink-0 text-right font-mono text-sm text-zinc-500 tabular-nums">{t.duration}</span>}
              </li>
            ))}
          </ol>
        </details>
      ) : (
        <p class="mt-12 text-sm text-zinc-500">The tracklist arrives with the next sync from Discogs.</p>
      )}

      <p class="mt-8 text-sm text-zinc-500">
        Data from Discogs: <a href={detail?.uri ?? `https://www.discogs.com/release/${record.releaseId}`} class={link}>view this release there</a>.
      </p>
      {play.length > 0 && <PlayerBar tracks={play} artist={hero!.artist} cover={hero!.cover} />}

      <section id="comments" class="mt-16">
        <CommentThread comments={comments} user={user} canDelete={(id) => canDeleteComment(thread, id, user)} error={error} draft={draft}>
          <LoginButton slot="login" href={loginHref(Astro.url, `${Astro.url.origin}${path}#comments`)} />
        </CommentThread>
      </section>
    </article>
  )}
</Layout>

<script>
  // The owner's visit finishes any missing tracklists (see src/music/sync.ts); others skip it quickly.
  import '@shared/scripts/comments';
  import '../../scripts/copy';

  // The owner's hearts save in the background (the form still works without script): flip it at once, undo on failure.
  document.querySelectorAll<HTMLFormElement>('form[data-fav]').forEach((form) => form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const button = form.querySelector('button')!;
    const on = button.getAttribute('aria-pressed') !== 'true';
    button.setAttribute('aria-pressed', String(on));
    const ok = await fetch(location.pathname, { method: 'POST', body: new FormData(form) }).then((r) => r.ok, () => false);
    if (!ok) button.setAttribute('aria-pressed', String(!on));
  }));
  import { autoSync } from '../../lib/sync';
  const progress = document.getElementById('sync-progress');
  if (progress) autoSync((message) => (progress.textContent = message));

</script>
