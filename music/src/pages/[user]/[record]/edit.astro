---
// The owner's edit form for one record. Discogs' values stay underneath: each edited field shows the Discogs value
// (to the owner only) with a Revert button. An empty field means "use Discogs".
export const prerender = false;
import Layout from '@shared/layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { CLEAR_VINYL, NOTE_MAX, VINYL_SWATCHES, cleanNote, loginHref, recordDefaults, safeCoverUrl, safeDay, safeStreamingUrl, vinylName, vinylPick, type Overrides } from '@shared/lib/lib';
import { currentUser, recordData, saveOverrides } from '@shared/lib/store';

const instanceId = Number(Astro.params.record);
const [user, data] = await Promise.all([
  currentUser(Astro.cookies),
  recordData(Astro.params.user!, Number.isSafeInteger(instanceId) ? instanceId : 0),
]);
const { owner, record, detail, match } = data;
const recordPath = Astro.url.pathname.replace(/\/edit$/, '');
if (!user) return Astro.redirect(loginHref(Astro.url));
if (!record || user.id !== owner?.id) return Astro.redirect(recordPath);

const defaults = recordDefaults(record, detail, match);
let overrides: Overrides = data.overrides;
const errors: Record<string, string> = {};
const links = { spotify: 'Spotify', apple: 'Apple Music', youtube: 'YouTube Music' } as const;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const revert = String(form.get('revert') ?? '');
  const next: Overrides = {};
  if (revert !== '*') {
    for (const key of Object.keys(defaults)) {
      const raw = key === 'vinyl' ? vinylPick(String(form.get('vinyl') ?? ''), String(form.get('vinylCustom') ?? ''), form.has('vinylSeeThrough')) : form.get(key);
      const typed = String(raw ?? '').replace(/\r\n/g, '\n').trim().slice(0, 5000);
      const value = key === 'note' ? cleanNote(typed) ?? '' : typed;
      if (!value || value === defaults[key] || key === revert) continue;
      if (key === 'cover' && !safeCoverUrl(value)) continue;
      if (key === 'added' && !safeDay(value)) {
        errors[key] = 'Pick a day from the calendar, or type it as YYYY-MM-DD.';
        continue;
      }
      if (key in links && !safeStreamingUrl(value, key as keyof typeof links)) {
        errors[key] = `Paste a link from ${links[key as keyof typeof links]} (https://…).`;
        continue;
      }
      next[key] = value;
    }
  }
  // "Discogs’ date is right" (from the album page's popup) isn't a field here: keep it unless the date was changed.
  if (revert !== '*' && overrides.addedChecked && !next.added) next.addedChecked = overrides.addedChecked;
  if (Object.keys(errors).length === 0) {
    await saveOverrides(owner!.id, instanceId, next);
    return Astro.redirect(`${recordPath}/edit?saved`, 303);
  }
  overrides = next;
}

const values = { ...defaults, ...overrides };
// Cover choices: Discogs' photo (the default), Apple Music's official artwork (suggested), then Discogs' other photos.
const appleArt = match?.apple?.artwork ?? null;
// The current pick goes first so it stays selected (and saved) even if it's no longer among the suggestions.
const covers = [...new Map([
  ...(values.cover ? [[values.cover, 'Current cover']] : []),
  ...(defaults.cover ? [[defaults.cover, 'Discogs photo']] : []),
  ...(appleArt ? [[appleArt, 'Apple Music artwork']] : []),
  ...(detail?.images ?? []).slice(1).map((src, i) => [src, `Discogs photo ${i + 2}`]),
] as [string, string][])];
const coverNote = !match
  ? 'Apple Music’s official artwork shows up here once it’s found: that happens in the background while your shelf page is open.'
  : !appleArt ? 'Apple Music doesn’t seem to have this album, so there’s no official artwork to suggest.' : null;
// Vinyl: a swatch (or the custom colour) plus "see-through" (the colour's alpha); Clear is its own swatch.
const vinylBase = values.vinyl === CLEAR_VINYL ? CLEAR_VINYL : values.vinyl.slice(0, 7);
const vinylCustom = !VINYL_SWATCHES.some(([, hex]) => hex === vinylBase);
// A newly saved Apple Music link that isn't the matched album yet: the page fetches that album's cover and tracks.
const albumId = (url?: string | null) => url?.match(/\/album\/(?:[^/?#]+\/)?(\d+)/)?.[1] ?? null;
const autoRematch = Astro.request.method === 'GET' && !!overrides.apple && albumId(overrides.apple) !== albumId(match?.apple?.url);
const fields: { key: string; label: string; hint?: string; multiline?: boolean }[] = [
  { key: 'artist', label: 'Artist' },
  { key: 'title', label: 'Album' },
  { key: 'released', label: 'Released', hint: 'When the album first came out. A date like 2016-01-08 is shown as “January 8, 2016”; anything else as typed.' },
  { key: 'vinylRelease', label: 'Vinyl release', hint: 'When this pressing came out.' },
  { key: 'added', label: 'Added on', hint: 'When the record joined your collection: it orders your shelf and the “Added” filter. Discogs’ date by default; change it if that’s not right.' },
  { key: 'genre', label: 'Genre', hint: 'Comma-separated; used by the Genres filter on the shelf.' },
  { key: 'style', label: 'Style' },
  { key: 'label', label: 'Label' },
  { key: 'format', label: 'Format' },
  { key: 'country', label: 'Country' },
  { key: 'note', label: 'Your note', hint: `Shown under the album, up to ${NOTE_MAX} characters: where you found it, why it matters.`, multiline: true },
  ...Object.keys(defaults).filter((k) => k.startsWith('field:')).map((k) => ({ key: k, label: k.slice(6), hint: 'One of your Discogs collection fields.', multiline: defaults[k].length > 60 })),
  { key: 'tracklist', label: 'Tracklist', hint: 'Position, title, length and, under “Links”, the track on each service. Positions like A1, B1 are shown as Side A, Side B.', multiline: true },
  ...Object.entries(links).map(([key, name]) => ({ key, label: `${name} link`, hint: defaults[key] ? `Found automatically. Paste another ${name} album link if it’s the wrong one.` : `The album on ${name}. Empty: the ${name} icon searches for it.` })),
];
const input = 'w-full rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950 px-3.5 py-2.5 text-zinc-900 dark:text-white focus:outline-none focus:border-kikyo-500 transition-colors';
// The form in cards: what the record is, the owner's Discogs notes, the tracklist, where to listen.
const byKey = Object.fromEntries(fields.map((f) => [f.key, f]));
const groups = [
  { id: 'album', title: 'Album', intro: null, keys: ['artist', 'title', 'released', 'vinylRelease', 'added', 'genre', 'style', 'label', 'format', 'country'], wide: ['artist', 'title'] },
  { id: 'notes', title: 'Your notes', intro: 'Your note shows under the album; the others are your Discogs collection fields.', keys: ['note', ...fields.filter((f) => f.key.startsWith('field:')).map((f) => f.key)], wide: ['note', ...fields.filter((f) => f.key.startsWith('field:')).map((f) => f.key)] },
  { id: 'tracklist', title: 'Tracklist', intro: 'Drag a row by its handle (or focus the handle and use ↑ ↓) to reorder; positions like A1, B2 renumber within their side.', keys: ['tracklist'], wide: ['tracklist'] },
  { id: 'listen', title: 'Listen', intro: null, keys: Object.keys(links), wide: Object.keys(links) },
].filter((g) => g.keys.length);
const card = 'rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-night-surface p-4 sm:p-6';
const cardTitle = 'text-lg font-bold text-zinc-900 dark:text-white';
const primary = 'inline-flex items-center h-8 px-4 rounded-full text-sm font-medium bg-kikyo-600 dark:bg-kikyo-400 text-white dark:text-zinc-950 hover:bg-kikyo-700 dark:hover:bg-kikyo-300 transition-colors';
const edited = Object.keys(overrides).length;
const dated = new Set(['released', 'vinylRelease', 'added']);
---
<Layout title={`Edit ${values.title} - ARVA`}>
  <div class="max-w-5xl mx-auto px-6 w-full flex-grow pt-12 pb-24 *:max-w-3xl">
    <Breadcrumbs items={[{ label: 'Shelves', href: '/' }, { label: owner!.name, href: recordPath.replace(/\/[^/]+$/, '') }, { label: values.title, href: recordPath }, { label: 'Edit' }]} />
    <p class="mt-8 text-lg font-medium text-kashiwa dark:text-kashiwa-light">{values.artist}</p>
    <h1 class="mt-2 text-3xl sm:text-4xl font-bold leading-tight text-zinc-900 dark:text-white">Edit {values.title}</h1>
    <p class="mt-3 text-zinc-600 dark:text-zinc-400 max-w-xl">Everything starts from Discogs and the automatic Apple Music / Spotify matches. What you change is what visitors see; the default stays underneath (only you see it), so you can go back any time.</p>

    {Astro.url.searchParams.has('saved') && Object.keys(errors).length === 0 && (
      <p class="mt-6 rounded-xl bg-kikyo-100 dark:bg-kikyo-900 px-4 py-3 text-sm text-kikyo-700 dark:text-kikyo-200" role="status">Saved. <a href={recordPath} class="font-medium underline underline-offset-4">See the record</a></p>
    )}

    <form method="post" class="mt-8 flex flex-col gap-5">
      <!-- Enter in a field submits with the form's first button: make that Save, not a Revert. -->
      <button class="sr-only" tabindex="-1" aria-hidden="true">Save</button>

      {covers.length > 0 && (
        <fieldset class={card}>
          <div class="flex items-center justify-between gap-4">
            <legend class={`${cardTitle} flex items-center gap-2`}>
              Cover
              {'cover' in overrides && <span class="text-xs font-medium text-kikyo-600 dark:text-kikyo-400">Edited</span>}
            </legend>
            {'cover' in overrides && <button name="revert" value="cover" class="text-sm font-medium text-kikyo-600 dark:text-kikyo-400 hover:underline underline-offset-4">Revert</button>}
          </div>
          <p class="mt-1 text-sm text-zinc-500">The main cover on the shelf and the record page; the others appear in its photos.{coverNote && <> {coverNote}</>}</p>
          <div class="mt-4 grid grid-cols-3 sm:grid-cols-5 gap-3">
            {covers.map(([src, label]) => (
              <label class="group cursor-pointer min-w-0">
                <input type="radio" name="cover" value={src} checked={values.cover === src} class="sr-only peer" />
                <span class="relative block aspect-square rounded-xl overflow-hidden ring-2 ring-transparent ring-offset-2 ring-offset-white dark:ring-offset-night-surface peer-checked:ring-kikyo-500 peer-focus-visible:ring-kikyo-500/60 transition-shadow">
                  <img onload="this.classList.remove('skeleton')" onerror="this.classList.remove('skeleton')" src={src} alt="" width="160" height="160" loading="lazy" referrerpolicy="no-referrer"
                    class="skeleton w-full h-full object-cover group-hover:scale-[1.03] transition-transform" />
                </span>
                <span class="mt-1.5 block text-xs text-zinc-500 truncate peer-checked:text-kikyo-600 dark:peer-checked:text-kikyo-400">
                  {src === appleArt && src !== values.cover ? 'Suggested: ' : ''}{label}
                </span>
              </label>
            ))}
          </div>
        </fieldset>
      )}

      <fieldset class={card}>
        <div class="flex items-center justify-between gap-4">
          <legend class={`${cardTitle} flex items-center gap-2`}>
            Vinyl colour
            {'vinyl' in overrides && <span class="text-xs font-medium text-kikyo-600 dark:text-kikyo-400">Edited</span>}
          </legend>
          {'vinyl' in overrides && <button name="revert" value="vinyl" class="text-sm font-medium text-kikyo-600 dark:text-kikyo-400 hover:underline underline-offset-4">Revert</button>}
        </div>
        <p class="mt-1 text-sm text-zinc-500">The disc on the shelf and the record page. From Discogs: {vinylName(defaults.vinyl).toLowerCase()}{defaults.vinyl === VINYL_SWATCHES[0][1] && ' (nothing in its format note)'}.</p>
        <div class="mt-4 flex flex-wrap gap-3">
          {VINYL_SWATCHES.map(([name, hex]) => (
            <label class="cursor-pointer" title={name}>
              <input type="radio" name="vinyl" value={hex} checked={!vinylCustom && vinylBase === hex} class="sr-only peer" aria-label={name} />
              <span class="vinyl-swatch block w-9 h-9 rounded-full ring-2 ring-transparent ring-offset-2 ring-offset-white dark:ring-offset-night-surface peer-checked:ring-kikyo-500 peer-focus-visible:ring-kikyo-500/60 transition-shadow" style={`--vinyl: ${hex}`}></span>
            </label>
          ))}
          <!-- Any other colour: the native picker sits over the swatch; picking selects this choice (script below). -->
          <label class="relative cursor-pointer" title="Another colour">
            <input type="radio" name="vinyl" value="custom" checked={vinylCustom} class="sr-only peer" aria-label="Another colour" data-vinyl-custom />
            <span data-vinyl-custom-swatch class={`block w-9 h-9 rounded-full ring-2 ring-transparent ring-offset-2 ring-offset-white dark:ring-offset-night-surface peer-checked:ring-kikyo-500 peer-focus-visible:ring-kikyo-500/60 transition-shadow ${vinylCustom ? 'vinyl-swatch' : 'vinyl-swatch-any'}`} style={vinylCustom ? `--vinyl: ${vinylBase}` : undefined}></span>
            <input type="color" name="vinylCustom" value={vinylCustom ? vinylBase : '#7f4bc4'} class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" aria-label="Pick another colour" />
          </label>
        </div>
        <label class="mt-4 inline-flex items-center gap-2 text-sm text-zinc-700 dark:text-zinc-300 cursor-pointer">
          <input type="checkbox" name="vinylSeeThrough" checked={values.vinyl.length === 9 && values.vinyl !== CLEAR_VINYL} class="w-4 h-4 accent-kikyo-600" />
          See-through (a translucent pressing)
        </label>
      </fieldset>

      {groups.map((g) => (
        <section class={card} aria-labelledby={`g-${g.id}`}>
          <h2 id={`g-${g.id}`} class={cardTitle}>{g.title}</h2>
          {g.intro && <p class="mt-1 text-sm text-zinc-500">{g.intro}</p>}

          {g.id === 'listen' && (
            <div class="mt-4 rounded-xl bg-zinc-100 dark:bg-white/[0.04] px-4 py-3 text-sm" data-rematch data-release={record.releaseId}
              data-artist={values.artist} data-title={values.title} data-matched={defaults.apple ?? ''} data-auto={autoRematch ? albumId(overrides.apple) : undefined}>
              <div class="flex flex-wrap items-center justify-between gap-3">
                <p class="text-zinc-700 dark:text-zinc-300">
                  {match?.apple
                    ? <>Matched on Apple Music: <a href={match.apple.url} target="_blank" rel="noopener noreferrer" class="text-kikyo-600 dark:text-kikyo-400 underline decoration-kikyo-500/40 underline-offset-4">open the album ↗</a></>
                    : match ? 'Not found on Apple Music.' : 'Not looked up on Apple Music yet.'}
                </p>
                <button type="button" class="ctl shrink-0 disabled:opacity-50">Match again</button>
              </div>
              <p class="mt-1.5 text-xs text-zinc-500">Uses the Apple Music link below if there is one (any country’s store), otherwise searches by the artist and title above, so correct those first if Discogs spells them differently. The suggested cover, the Apple track links and Spotify then follow that album.</p>
              <p data-rematch-status role="status" class="mt-1 text-xs font-medium text-zinc-700 dark:text-zinc-300 empty:hidden"></p>
            </div>
          )}

          <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-5">
            {g.keys.map((key) => {
              const f = byKey[key];
              const changed = key in overrides;
              const original = defaults[key];
              return (
                <div class={g.wide.includes(key) ? 'sm:col-span-2' : ''}>
                  <div class="flex items-center justify-between gap-3 mb-1.5">
                    <label for={`f-${key}`} class={`flex items-center gap-2 text-sm font-medium text-zinc-800 dark:text-zinc-200 ${key === 'tracklist' && !changed ? 'sr-only' : ''}`}>
                      {f.label}
                      {changed && <span class="text-xs font-medium text-kikyo-600 dark:text-kikyo-400">Edited</span>}
                    </label>
                    {changed && <button name="revert" value={key} class="text-xs font-medium text-kikyo-600 dark:text-kikyo-400 hover:underline underline-offset-4">Revert</button>}
                  </div>
                  {f.multiline
                    ? <textarea id={`f-${key}`} name={key} maxlength={key === 'note' ? NOTE_MAX : undefined} rows={key === 'tracklist' ? Math.min(24, Math.max(6, values[key].split('\n').length + 1)) : 4} class={`${input} leading-relaxed ${key === 'tracklist' ? 'font-mono text-sm' : ''}`}>{values[key]}</textarea>
                    : dated.has(key)
                      ? (
                        <div class="flex gap-2">
                          <input id={`f-${key}`} name={key} value={values[key]} class={input} placeholder={key === 'added' ? 'YYYY-MM-DD' : 'YYYY-MM-DD, or just a year'} aria-invalid={errors[key] ? 'true' : undefined} />
                          <!-- A calendar for picking the date; typing stays possible (a year alone, "around 1975"). -->
                          <label class="relative shrink-0 grid place-items-center w-11 rounded-xl border border-zinc-200 dark:border-zinc-800 text-zinc-500 hover:text-kikyo-500 hover:border-kikyo-500 focus-within:text-kikyo-500 focus-within:border-kikyo-500 focus-within:ring-2 focus-within:ring-kikyo-500/30 transition-colors cursor-pointer" title="Pick a date">
                            <svg class="w-5 h-5 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="2" /><path d="M3.5 9.5h17M8 3v4M16 3v4" stroke-linecap="round" /></svg>
                            <input type="date" data-date-for={`f-${key}`} class="absolute inset-0 opacity-0 cursor-pointer" aria-label={`Pick the ${f.label.toLowerCase()} date`}
                              value={/^\d{4}-\d{2}-\d{2}$/.test(values[key]) ? values[key] : undefined} />
                          </label>
                        </div>
                      )
                      : <input id={`f-${key}`} name={key} value={values[key]} class={input} inputmode={key in links ? 'url' : undefined} aria-invalid={errors[key] ? 'true' : undefined} />}
                  {key === 'tracklist' && <><div id="track-editor" class="hidden flex-col gap-2"></div><input type="hidden" id="f-favorites" name="favorites" value={values.favorites} /></>}
                  {errors[key] && <p class="mt-1.5 text-sm text-red-600 dark:text-red-400" role="alert">{errors[key]}</p>}
                  {changed
                    ? key !== 'tracklist' && <p class="mt-1.5 text-xs text-zinc-500 whitespace-pre-line break-words line-clamp-3">Default: {original || '(empty)'}</p>
                    : f.hint && key !== 'tracklist' && <p class="mt-1.5 text-xs text-zinc-500">{f.hint}</p>}
                </div>
              );
            })}
          </div>
        </section>
      ))}

      <template id="track-row">
        <div class="track rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950">
          <div class="flex items-center gap-0.5 sm:gap-1.5 p-1 sm:p-1.5">
            <button type="button" data-act="drag" aria-label="Move this line: drag it, or use the up and down arrow keys" title="Drag to reorder"
              class="shrink-0 w-6 sm:w-7 h-8 grid place-items-center rounded-lg text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 cursor-grab active:cursor-grabbing touch-none focus-visible:outline-2 focus-visible:outline-kikyo-500">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="9" cy="6" r="1.6" /><circle cx="15" cy="6" r="1.6" /><circle cx="9" cy="12" r="1.6" /><circle cx="15" cy="12" r="1.6" /><circle cx="9" cy="18" r="1.6" /><circle cx="15" cy="18" r="1.6" /></svg>
            </button>
            <input data-k="position" aria-label="Position" placeholder="A1" class="w-9 sm:w-12 shrink-0 rounded-lg bg-transparent px-1 sm:px-2 py-1.5 font-mono text-sm text-zinc-500 focus:bg-white dark:focus:bg-night-surface focus:outline-none focus:ring-1 focus:ring-kikyo-500" />
            <input data-k="title" aria-label="Title" placeholder="Title" class="min-w-0 flex-grow rounded-lg bg-transparent px-1 sm:px-2 py-1.5 text-sm text-zinc-900 dark:text-white focus:bg-white dark:focus:bg-night-surface focus:outline-none focus:ring-1 focus:ring-kikyo-500" />
            <input data-k="duration" aria-label="Length" placeholder="4:52" class="w-11 sm:w-14 shrink-0 rounded-lg bg-transparent px-1 sm:px-2 py-1.5 font-mono text-sm tabular-nums text-zinc-500 text-right focus:bg-white dark:focus:bg-night-surface focus:outline-none focus:ring-1 focus:ring-kikyo-500" />
            <button type="button" data-act="fav" aria-pressed="false" aria-label="Favourite" title="Mark as one of your favourites"
              class="group/fav shrink-0 w-7 sm:w-8 h-8 grid place-items-center rounded-lg text-zinc-400 hover:text-kikyo-600 dark:hover:text-kikyo-400 aria-pressed:text-bengara dark:aria-pressed:text-bengara-light focus-visible:outline-2 focus-visible:outline-kikyo-500">
              <svg class="w-4 h-4 group-aria-pressed/fav:fill-current" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" /></svg>
            </button>
            <button type="button" data-act="links" aria-label="Streaming links for this track" aria-expanded="false" title="Streaming links"
              class="shrink-0 h-8 px-1 sm:px-2 inline-flex items-center gap-1 rounded-lg text-xs font-medium text-zinc-400 hover:text-kikyo-600 dark:hover:text-kikyo-400 aria-expanded:text-kikyo-600 dark:aria-expanded:text-kikyo-400">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1" /></svg>
              <span data-count></span>
            </button>
            <button type="button" data-act="remove" aria-label="Remove this line" title="Remove" class="shrink-0 w-7 sm:w-8 h-8 grid place-items-center rounded-lg text-zinc-400 hover:text-red-600 dark:hover:text-red-400">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
            </button>
          </div>
          <div data-links class="hidden grid-cols-1 sm:grid-cols-3 gap-2 px-2.5 pb-2.5">
            <input data-k="spotify" type="url" aria-label="Spotify link" placeholder="Spotify link" class="rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-night-surface px-2.5 py-1.5 text-xs text-zinc-900 dark:text-white focus:outline-none focus:border-kikyo-500" />
            <input data-k="apple" type="url" aria-label="Apple Music link" placeholder="Apple Music link" class="rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-night-surface px-2.5 py-1.5 text-xs text-zinc-900 dark:text-white focus:outline-none focus:border-kikyo-500" />
            <input data-k="youtube" type="url" aria-label="YouTube Music link" placeholder="YouTube Music link" class="rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-night-surface px-2.5 py-1.5 text-xs text-zinc-900 dark:text-white focus:outline-none focus:border-kikyo-500" />
          </div>
        </div>
      </template>

      <!-- Save stays in reach at the bottom of the screen while editing. -->
      <div class="glass sticky bottom-4 z-30 mt-3 rounded-full flex items-center gap-2 p-1.5 pl-5">
        <span class="text-sm text-zinc-500 truncate">
          <span class="sm:hidden">{edited > 0 ? `${edited} edited` : 'From Discogs'}</span>
          <span class="hidden sm:inline">{edited > 0 ? `${edited} field${edited === 1 ? '' : 's'} changed from Discogs` : 'All values from Discogs'}</span>
        </span>
        <span class="flex-1"></span>
        <a href={recordPath} class="ctl">Cancel</a>
        {edited > 0 && <button name="revert" value="*" class="ctl max-sm:!hidden" onclick="return confirm('Undo all your edits to this record and use Discogs’ data again?')">Revert all</button>}
        <button class={primary}>Save</button>
      </div>
    </form>
    <p id="track-status" class="sr-only" role="status" aria-live="polite"></p>
  </div>
</Layout>

<script>
  import { growFrom } from '@shared/scripts/grow';
  import { renumber, titleKey, textToTracklist, tracklistToText, type Track } from '@shared/lib/lib';
  import { rematch } from '../../../lib/sync';

  // Vinyl colour: picking in the native colour picker chooses "another colour" and shows it on its swatch.
  document.querySelector<HTMLInputElement>('input[name="vinylCustom"]')?.addEventListener('input', (e) => {
    const picked = (e.target as HTMLInputElement).value;
    document.querySelector<HTMLInputElement>('[data-vinyl-custom]')!.checked = true;
    const swatch = document.querySelector<HTMLElement>('[data-vinyl-custom-swatch]')!;
    swatch.classList.replace('vinyl-swatch-any', 'vinyl-swatch');
    swatch.style.setProperty('--vinyl', picked);
  });

  // "Match again": the album from the Apple Music link field, or a search by the artist and title fields (as typed).
  const box = document.querySelector<HTMLElement>('[data-rematch]');
  if (box) {
    const button = box.querySelector('button')!;
    const status = box.querySelector('[data-rematch-status]')!;
    const field = (key: string) => (document.getElementById(`f-${key}`) as HTMLInputElement | null)?.value.trim() ?? '';
    // The field shows the automatic match until the owner pastes another link; only a different link is followed.
    const link = () => (field('apple') && field('apple') !== box.dataset.matched ? field('apple') : null);
    const run = async () => {
      button.disabled = true;
      status.textContent = link() ? 'Reading the album from the Apple Music link…' : 'Searching Apple Music…';
      try {
        const found = await rematch(Number(box.dataset.release), field('artist') || box.dataset.artist!, field('title') || box.dataset.title!, link());
        if (found) {
          status.textContent = 'Found it. Reloading…';
          location.reload();
          return;
        }
        status.textContent = link()
          ? 'That link didn’t lead to an album. Copy the link from the album page on Apple Music (Share → Copy Link).'
          : 'Still no match. Paste the album’s Apple Music link below, save, and it will be used.';
      } catch (e) {
        status.textContent = `Apple Music didn’t answer (${e instanceof Error ? e.message : e}). Try again in a minute.`;
      }
      button.disabled = false;
    };
    button.addEventListener('click', run);
    // Right after saving a new Apple Music link: once per link and tab, so a link Apple can't resolve doesn't loop.
    const key = `rematched:${box.dataset.release}:${box.dataset.auto}`;
    try {
      if (box.dataset.auto && !sessionStorage.getItem(key)) { sessionStorage.setItem(key, '1'); run(); }
    } catch {}
  }

  // Calendar buttons: the whole button opens the calendar (browsers otherwise only open it from the hidden date
  // input's own little icon), starting at the date already typed, and the pick fills the text field next to it.
  document.querySelectorAll<HTMLInputElement>('input[data-date-for]').forEach((picker) => {
    const field = document.getElementById(picker.dataset.dateFor!) as HTMLInputElement;
    const open = () => {
      if (/^\d{4}-\d{2}-\d{2}$/.test(field.value.trim())) picker.value = field.value.trim();
      try { picker.showPicker(); } catch {} // already open, or an older browser: its own icon still works
    };
    picker.addEventListener('click', (e) => { e.preventDefault(); open(); });
    picker.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
    picker.addEventListener('change', () => { if (picker.value) field.value = picker.value; });
  });

  // Row-by-row tracklist editor; the textarea underneath stays what the form sends (and the fallback without JS).
  // Rows reorder by dragging the handle (mouse or touch) or with ↑ ↓ on a focused handle; positions renumber after.
  const area = document.getElementById('f-tracklist') as HTMLTextAreaElement | null;
  const editor = document.getElementById('track-editor');
  const template = document.getElementById('track-row') as HTMLTemplateElement | null;
  const announce = document.getElementById('track-status');
  if (area && editor && template) {
    const services = ['spotify', 'apple', 'youtube'] as const;
    const rows = () => [...editor.querySelectorAll<HTMLElement>('.track')];
    const read = (row: HTMLElement) => {
      const get = (k: string) => (row.querySelector<HTMLInputElement>(`[data-k="${k}"]`)?.value ?? '').trim();
      if (row.dataset.heading) return { position: '', title: get('title'), duration: '', heading: true } as Track;
      const links = Object.fromEntries(services.map((s) => [s, get(s)]).filter(([, v]) => v));
      return { position: get('position'), title: get('title'), duration: get('duration'), heading: false, ...(Object.keys(links).length && { links }) } as Track;
    };
    // Favourites (the heart on each row) are kept by title in their own field, so they survive reordering.
    const favorites = document.getElementById('f-favorites') as HTMLInputElement | null;
    const favs = new Set((favorites?.value ?? '').split('\n').filter((x) => x.trim()).map(titleKey));
    const save = () => {
      area.value = tracklistToText(rows().map(read).filter((t) => t.title));
      if (favorites) favorites.value = rows().filter((r) => r.querySelector('[data-act="fav"]')?.getAttribute('aria-pressed') === 'true')
        .map((r) => read(r).title).filter(Boolean).join('\n');
    };
    const countLinks = (row: HTMLElement) => {
      const n = services.filter((s) => row.querySelector<HTMLInputElement>(`[data-k="${s}"]`)?.value.trim()).length;
      const badge = row.querySelector('[data-count]');
      if (badge) badge.textContent = n ? String(n) : '';
    };
    const add = (t: Track, before?: Element | null) => {
      const row = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const set = (k: string, v = '') => { const el = row.querySelector<HTMLInputElement>(`[data-k="${k}"]`); if (el) el.value = v; };
      set('title', t.title);
      if (t.heading) {
        row.dataset.heading = '1';
        row.querySelectorAll('[data-k="position"], [data-k="duration"], [data-act="fav"], [data-act="links"], [data-links]').forEach((el) => el.remove());
        const title = row.querySelector<HTMLInputElement>('[data-k="title"]')!;
        title.placeholder = 'Heading, e.g. Side B';
        title.classList.add('text-sm', 'font-semibold');
        row.classList.add('mt-2');
      } else {
        set('position', t.position);
        set('duration', t.duration);
        services.forEach((s) => set(s, t.links?.[s]));
        countLinks(row);
        row.querySelector('[data-act="fav"]')!.setAttribute('aria-pressed', String(favs.has(titleKey(t.title))));
      }
      editor.insertBefore(row, before ?? null);
      return row;
    };
    textToTracklist(area.value).forEach((t) => add(t));

    // After a move: number the songs again in their new order (A1, A2 … within each side).
    const renumbered = () => {
      const songs = rows().filter((r) => !r.dataset.heading).map((r) => r.querySelector<HTMLInputElement>('[data-k="position"]')!);
      renumber(songs.map((i) => i.value.trim())).forEach((v, k) => { songs[k].value = v; });
      save();
    };
    // Rows glide to their new places instead of jumping (FLIP).
    const glide = (move: () => void) => {
      const before = new Map(rows().map((r) => [r, r.getBoundingClientRect().top]));
      move();
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      rows().forEach((r) => {
        const dy = (before.get(r) ?? 0) - r.getBoundingClientRect().top;
        if (dy && !r.classList.contains('dragging')) r.animate([{ transform: `translateY(${dy}px)` }, { transform: 'none' }], { duration: 160, easing: 'ease-out' });
      });
    };

    const actions = document.createElement('div');
    actions.className = 'flex gap-2 pt-2';
    actions.innerHTML = '<button type="button" data-add="track" class="ctl">+ Track</button><button type="button" data-add="heading" class="ctl">+ Heading</button>';
    editor.append(actions);
    actions.addEventListener('click', (e) => {
      const kind = (e.target as HTMLElement).closest<HTMLElement>('[data-add]')?.dataset.add;
      if (!kind) return;
      add({ position: '', title: '', duration: '', heading: kind === 'heading' }, actions).querySelector<HTMLInputElement>('[data-k="title"], [data-k="position"]')?.focus();
    });
    editor.addEventListener('input', (e) => {
      const row = (e.target as HTMLElement).closest<HTMLElement>('.track');
      if (row) countLinks(row);
      save();
    });
    editor.addEventListener('click', (e) => {
      const button = (e.target as HTMLElement).closest<HTMLElement>('[data-act]');
      const row = button?.closest<HTMLElement>('.track');
      if (!button || !row) return;
      if (button.dataset.act === 'remove') { glide(() => row.remove()); save(); }
      if (button.dataset.act === 'fav') { button.setAttribute('aria-pressed', String(button.getAttribute('aria-pressed') !== 'true')); save(); }
      if (button.dataset.act === 'links') {
        const l = row.querySelector('[data-links]')!;
        const open = l.classList.toggle('hidden') === false;
        l.classList.toggle('grid', open);
        button.setAttribute('aria-expanded', String(open));
        if (open) growFrom(l, button);
      }
    });

    // Dragging: pointer events (mouse, pen and touch alike); the row follows the pointer between its neighbours.
    let dragging: HTMLElement | null = null;
    const onMove = (e: PointerEvent) => {
      if (!dragging) return;
      const others = rows().filter((r) => r !== dragging);
      const next = others.find((r) => { const b = r.getBoundingClientRect(); return e.clientY < b.top + b.height / 2; });
      if ((next ?? actions) !== dragging.nextElementSibling) glide(() => editor.insertBefore(dragging!, next ?? actions));
    };
    const onUp = () => {
      if (!dragging) return;
      dragging.classList.remove('dragging');
      document.documentElement.style.userSelect = '';
      dragging = null;
      removeEventListener('pointermove', onMove);
      removeEventListener('pointerup', onUp);
      removeEventListener('pointercancel', onUp);
      renumbered();
    };
    editor.addEventListener('pointerdown', (e) => {
      const handle = (e.target as HTMLElement).closest('[data-act="drag"]');
      if (!handle || e.button !== 0) return;
      e.preventDefault();
      dragging = handle.closest<HTMLElement>('.track');
      dragging!.classList.add('dragging');
      document.documentElement.style.userSelect = 'none';
      addEventListener('pointermove', onMove);
      addEventListener('pointerup', onUp);
      addEventListener('pointercancel', onUp);
    });
    // Keyboard: ↑ ↓ on a focused handle moves its row one place.
    editor.addEventListener('keydown', (e) => {
      const handle = (e.target as HTMLElement).closest<HTMLElement>('[data-act="drag"]');
      if (!handle || (e.key !== 'ArrowUp' && e.key !== 'ArrowDown')) return;
      e.preventDefault();
      const row = handle.closest<HTMLElement>('.track')!;
      const list = rows();
      const k = list.indexOf(row);
      const target = e.key === 'ArrowUp' ? list[k - 1] : list[k + 1];
      if (!target) return;
      glide(() => editor.insertBefore(row, e.key === 'ArrowUp' ? target : target.nextElementSibling));
      handle.focus();
      renumbered();
      if (announce) announce.textContent = `Moved to place ${rows().indexOf(row) + 1} of ${rows().length}.`;
    });

    area.classList.add('hidden');
    editor.classList.replace('hidden', 'flex');
  }
</script>
