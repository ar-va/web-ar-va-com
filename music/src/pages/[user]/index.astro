---
// A collector's shelf. The owner can write a short note about the collection; everyone logged in can comment on the
// shelf (forms post here and come back with a redirect, like record pages).
export const prerender = false;
import ShelfPage from '../../components/ShelfPage.astro';
import { cleanNote, loginHref } from '@shared/lib/lib';
import { SHELF_THREAD, commentForm, currentUser, setShelfNote, shelfData } from '@shared/lib/store';
import { wishCount } from '../../lib/wishes';

const [user, data, wishes] = await Promise.all([currentUser(Astro.cookies), shelfData(Astro.params.user!), wishCount(Astro.params.user!)]);
const { owner } = data;
const path = Astro.url.pathname;
const thread = { shelfId: owner?.id ?? 0, instanceId: SHELF_THREAD };

let error: string | null = null;
let draft = '';
if (owner && Astro.request.method === 'POST') {
  if (!user) return Astro.redirect(loginHref(Astro.url), 303);
  const form = await Astro.request.formData();
  const action = form.get('action');
  if (action === 'note') {
    if (user.id === owner.id) await setShelfNote(owner.id, cleanNote(String(form.get('note') ?? '')));
    return Astro.redirect(`${path}#note`, 303);
  }
  const result = await commentForm(thread, form, user, { ownerId: owner.id, title: `${owner.name}’s records`, url: `${Astro.url.origin}${path}` },
    (p) => Astro.locals.cfContext.waitUntil(p));
  if ('anchor' in result) return Astro.redirect(`${path}#${result.anchor}`, 303);
  ({ error, draft } = result);
}
if (!owner) Astro.response.status = 404;
---
<ShelfPage {...data} wishCount={wishes} user={user} error={error} draft={draft} editingNote={!!owner && user?.id === owner.id && Astro.url.searchParams.has('note')} />
