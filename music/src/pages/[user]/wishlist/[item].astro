---
// One record on a collector's wishlist (music.ar-va.com/<shelf>/wishlist/d-123 or c-5): the album page's hero (the vinyl
// rolls out), the giver's note, what this visitor can do (ReserveBox), the tracklist. Forms post to the wishlist page and
// come back here. The owner sees no reservation; for albums added on the site, Edit and Remove.
export const prerender = false;
import Layout from '@shared/layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import RecordHero from '../../../components/RecordHero.astro';
import ReserveBox from '../../../components/ReserveBox.astro';
import Disclosure from '@shared/components/Disclosure.astro';
import Toast from '@shared/components/Toast.astro';
import Listen from '../../../components/Listen.astro';
import SkippingRecord from '../../../components/SkippingRecord.astro';
import StarIcon from '../../../components/StarIcon.astro';
import WishIcon from '../../../components/WishIcon.astro';
import { loginHref, runtime, withSideHeadings } from '@shared/lib/lib';
import { currentUser, shelfSlug } from '@shared/lib/store';
import { wishKey, wishNotice, wishlistData } from '../../../lib/wishes';
import { shopLink } from '@shared/lib/wishlist';

const key = wishKey(Astro.params.item!);
const user = await currentUser(Astro.cookies);
const { owner, items } = await wishlistData(Astro.params.user!, user);
// Gone, gifted, already on the shelf, or on the list the owner doesn't show: not found.
const item = key ? items.find((i) => i.key === key) : undefined;
if (!owner || !item) Astro.response.status = 404;

const path = Astro.url.pathname;
const list = owner ? `/${shelfSlug(owner)}/wishlist` : '/';
const first = owner?.name.split(' ')[0] ?? '';
const isOwner = !!owner && user?.id === owner.id;
const q = Astro.url.searchParams;
const notice = isOwner && q.has('copied') ? 'Copied to your own list. It shows there when you switch the wishlist to “My own list”.'
  : isOwner && q.has('copy-exists') ? 'That album is already on your own list.'
  : isOwner && q.has('copy-full') ? 'Your own list is full (200 albums). Remove one to copy this.'
  : wishNotice(q, first);
const tracks = item ? withSideHeadings(item.tracks) : [];
const songs = tracks.filter((t) => !t.heading);
---
<Layout title={item ? `${item.artist} – ${item.title} on ${owner!.name}’s wishlist - ARVA` : 'Not found - ARVA'}
  description={item ? `${owner!.name} would like ${item.title} by ${item.artist} on vinyl.` : undefined}>
  <article class="max-w-5xl mx-auto px-6 w-full flex-grow pt-12 pb-24 *:max-w-3xl">
    <Breadcrumbs class="mb-8" share={!!item} items={owner
      ? [{ label: 'Shelves', href: '/' }, { label: owner.name, href: `/${shelfSlug(owner)}` }, { label: 'Wishlist', href: list }, { label: item?.title ?? 'Not found' }]
      : [{ label: 'Shelves', href: '/' }, { label: 'Not found' }]} />
    {item ? (
      <>
        {notice && <Toast>{notice}</Toast>}
        {Astro.url.searchParams.has('nomsg') && (user && user.id < 0
          ? <Toast>Reserved, but we couldn’t email you, so there won’t be reminders. Check that messages are on in <a href="/settings#account" class="underline underline-offset-4">settings</a>.</Toast>
          : <Toast>Reserved. Telegram didn’t let the bot message you, so there won’t be reminders. <a href={loginHref(Astro.url)} class="underline underline-offset-4">Log in again</a> and allow messages to get them.</Toast>
        )}
        <div class="!max-w-none">
          <RecordHero record={item} artist={item.artist} title={item.title} released={item.year ? String(item.year) : ''} genres={item.genres}
            trackCount={songs.length} runtime={runtime(item.tracks) ?? undefined} links={item.links} addedPrefix="On the wishlist since">
            {/* The row above the hero: the owner's star (either list), Edit and Remove (albums added here); visitors see
                "Most wanted" in the same place as the shelf's "Latest". */}
            {isOwner ? (
              <div slot="above" class="flex flex-wrap items-center gap-2">
                <form method="post" action={list}>
                  <input type="hidden" name="action" value="star" /><input type="hidden" name="item" value={item.key} />
                  <input type="hidden" name="on" value={item.top ? '0' : '1'} /><input type="hidden" name="back" value={path} />
                  <button class="ctl" aria-pressed={String(item.top)}><StarIcon />{item.top ? 'Most wanted' : 'Mark as most wanted'}</button>
                </form>
                {item.key.startsWith('d:') && (
                  <form method="post" action={list}>
                    <input type="hidden" name="action" value="copy" /><input type="hidden" name="item" value={item.key} /><input type="hidden" name="back" value={path} />
                    <button class="ctl" title="Add it to the list you make on this site, where you can edit it and say where to get it">Copy to my own list</button>
                  </form>
                )}
                {item.wish && (
                  <>
                    <a href={`${list}?edit=${item.instanceId}#add`} class="ctl">Edit</a>
                    <form method="post" action={list}>
                      <input type="hidden" name="action" value="remove" /><input type="hidden" name="id" value={item.instanceId} />
                      <button class="ctl">Remove from the wishlist</button>
                    </form>
                  </>
                )}
              </div>
            ) : (item.top || item.state === 'mine' || item.state === 'taken') && (
              <p slot="above" class="flex flex-wrap items-center gap-2 font-sans">
                {item.top && <span class="inline-flex items-center gap-1 rounded-full bg-bengara-tint px-2.5 py-0.5 text-sm font-medium text-bengara dark:bg-bengara-tint-dark dark:text-bengara-light"><StarIcon />Most wanted</span>}
                {/* Visitors see it is reserved (logged out too); only the reserver that it is theirs; the owner never (wishlistData). */}
                {item.state === 'mine' && <span class="rounded-full bg-(--on-bg) px-2.5 py-0.5 text-sm font-medium text-(--on-text)">Reserved by you</span>}
                {item.state === 'taken' && <span class="rounded-full bg-(--well) px-2.5 py-0.5 text-sm font-medium text-zinc-700 dark:text-zinc-300">Reserved</span>}
              </p>
            )}
            {/* The note in a box like the shelf's note (user 2026-11-25), the shops as buttons. */}
            {item.note && (
              <div class="mt-6 rounded-2xl bg-kashiwa/[0.07] dark:bg-kashiwa-light/[0.07] px-4 py-3.5 sm:px-5">
                <p class="flex items-center gap-2 text-sm font-medium text-kashiwa dark:text-kashiwa-light"><WishIcon name="note" class="w-4 h-4" />{first}’s note</p>
                <p class="mt-1.5 text-zinc-700 dark:text-zinc-300 whitespace-pre-line">{item.note}</p>
              </div>
            )}
            {item.where.length > 0 && (
              <div class="mt-5">
                {/* No visible heading (user 2026-11-25): the shop icon on each button says it; screen readers get the group's name. */}
                <div role="group" aria-label="Where to get it" class="flex flex-wrap gap-2">
                  {item.where.map(shopLink).map((shop) => shop.url ? (
                    <a href={shop.url} target="_blank" rel="nofollow ugc noopener noreferrer" class="ctl" title={shop.url}>
                      <WishIcon name="where" class="w-4 h-4" />{shop.label}
                      <svg class="w-3.5 h-3.5 opacity-60" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
                      <span class="sr-only">(opens in a new tab)</span>
                    </a>
                  ) : (
                    <span class="ctl !cursor-default !bg-transparent ring-1 ring-inset ring-zinc-200 dark:ring-zinc-800"><WishIcon name="where" class="w-4 h-4" />{shop.label}</span>
                  ))}
                </div>
              </div>
            )}
            <ReserveBox class="mt-6" state={item.state} item={item.key} giveOn={item.giveOn} heldUntil={item.heldUntil} ownerFirst={first} action={list} back={path}
              loginHref={loginHref(Astro.url)} />
          </RecordHero>
        </div>

        {songs.length > 0 && (
          <Disclosure id="tracklist" title="Tracklist" heading open class="mt-14 scroll-mt-6">
            <ol class="mt-4 -mx-3">
              {tracks.map((t) => t.heading ? (
                <li class="px-3 pt-6 pb-2 first:pt-1 text-sm font-semibold text-zinc-900 dark:text-white">{t.title}</li>
              ) : (
                <li class="track-row group flex items-center gap-4 px-3 py-2.5 rounded-xl hover:bg-zinc-100 dark:hover:bg-white/[0.04] focus-within:bg-zinc-100 dark:focus-within:bg-white/[0.04] transition-colors">
                  <span class="w-7 shrink-0 font-mono text-sm text-zinc-500 tabular-nums">{t.position}</span>
                  <span class="flex-grow min-w-0 text-zinc-800 dark:text-zinc-200">{t.title}</span>
                  {t.duration && <span class="font-mono text-sm text-zinc-500 tabular-nums">{t.duration}</span>}
                  <Listen query={`${item.artist} ${t.title}`} label={t.title} links={t.links} kind="track" />
                </li>
              ))}
            </ol>
          </Disclosure>
        )}
        <a href={list} class="mt-12 inline-block text-sm font-medium text-kikyo-600 dark:text-kikyo-400 hover:underline underline-offset-4">All of {first}’s wishlist</a>
      </>
    ) : (
      <SkippingRecord heading="Not on the wishlist">This record isn’t on the wishlist any more. <a href={list} class="text-kikyo-600 dark:text-kikyo-400 underline underline-offset-4">See the wishlist</a></SkippingRecord>
    )}
  </article>
</Layout>
