---
// A collector's wishlist (music.ar-va.com/<shelf>/wishlist): records they'd like on vinyl, from their Discogs wantlist or
// added here (the owner switches between the two; both are kept). Logged-in visitors reserve one they'll give; the
// owner never sees what's reserved, until the giver presses "I gave it". Forms post here and come back with a redirect.
export const prerender = false;
import Layout from '@shared/layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Toast from '@shared/components/Toast.astro';
import SkippingRecord from '../../../components/SkippingRecord.astro';
import RecordBrowser, { type BrowserItem } from '../../../components/RecordBrowser.astro';
import WishForm from '../../../components/WishForm.astro';
import { loginHref } from '@shared/lib/lib';
import { WISHES_MAX, parseStreamingLink, reservationCard, safeGiveOn, splitArtistAlbum, toWish } from '@shared/lib/wishlist';
import { connectWebhook, notify } from '@shared/lib/notify';
import { currentUser, shelfSlug } from '@shared/lib/store';
import {
  addWish, copyToOwnList, markGifted, removeWish, reserve, setGiveOn, setStar, setWishlistSource, unreserve, updateWish, wishAnchor, wishKey, wishNotice, wishSlug, wishlistData,
} from '../../../lib/wishes';

const name = Astro.params.user!;
const user = await currentUser(Astro.cookies);
const data = await wishlistData(name, user);
const { owner } = data;
const path = Astro.url.pathname;
const today = new Date().toISOString().slice(0, 10);

let error: string | null = null;
let draft: Record<string, any> | null = null;
if (owner && Astro.request.method === 'POST') {
  if (!user) return Astro.redirect(loginHref(Astro.url), 303);
  const form = await Astro.request.formData();
  const get = (k: string) => String(form.get(k) ?? '');
  const action = get('action');
  const item = get('item');
  // A record's page (here/<item>) and settings' "Gifts you've reserved" post here too, and go back there; nowhere else.
  const to = get('back');
  const fromSettings = to.startsWith('/settings');
  const fromRecord = to.startsWith(`${path}/`) && !!wishKey(to.slice(path.length + 1));
  const back = (query = '') => Astro.redirect(fromSettings ? `/settings${query}#gifts` : fromRecord ? `${to}${query}` : `${path}${query}#${wishAnchor(item)}`, 303);
  const isOwner = user.id === owner.id;

  if (isOwner && action === 'source') {
    await setWishlistSource(owner, get('source') === 'discogs' ? 'discogs' : 'custom');
    return Astro.redirect(path, 303);
  }
  if (isOwner && (action === 'add' || action === 'edit')) {
    const values = { artist: get('artist'), title: get('title'), year: get('year'), cover: get('cover'), tracklist: get('tracklist'), note: get('note'),
      where: form.getAll('where').map(String), top: form.get('top') === 'on', links: { spotify: get('spotify'), apple: get('apple'), youtube: get('youtube') } as Record<string, string> };
    // The one-line box without script: a pasted link isn't looked up (it's kept as that service's album link), typed
    // "Artist – Album" fills the empty fields.
    const pasted = parseStreamingLink(get('link'));
    if (pasted && !values.links[pasted.service]) values.links[pasted.service] = get('link').trim();
    if (!pasted && !values.artist && !values.title) Object.assign(values, splitArtistAlbum(get('link')));
    const wish = toWish(values);
    if ('error' in wish) { error = wish.error; draft = values; Astro.response.status = 400; }
    else if (action === 'edit') {
      await updateWish(owner, Number(get('id')), wish);
      await setStar(owner, `c:${Number(get('id'))}`, values.top);
      return Astro.redirect(`${path}/${wishSlug(`c:${Number(get('id'))}`)}`, 303);
    } else {
      const id = await addWish(owner, wish);
      if (id && values.top) await setStar(owner, `c:${id}`, true);
      if (id) return Astro.redirect(`${path}?added=${id}#${wishAnchor(`c:${id}`)}`, 303);
      error = `Your wishlist holds ${WISHES_MAX} albums at most. Remove one to add another.`; draft = values; Astro.response.status = 400;
    }
  }
  if (isOwner && action === 'copy') {
    // From a Discogs record's page; back there with what happened (the copy shows once the own list is switched on).
    const found = data.items.find((i) => i.key === item && item.startsWith('d:'));
    const result = found ? await copyToOwnList(owner, found) : 'full';
    return back(typeof result === 'number' ? '?copied' : `?copy-${result}`);
  }
  if (isOwner && action === 'star') {
    await setStar(owner, item, get('on') === '1');
    return back();
  }
  if (isOwner && action === 'remove') {
    await removeWish(owner, Number(get('id')));
    return Astro.redirect(path, 303);
  }
  if (!isOwner && action === 'reserve') {
    const found = data.items.find((i) => i.key === item);
    if (!found || found.state !== 'free') return back(found?.state === 'mine' ? '' : '?taken');
    const result = await reserve(owner.id, item, user, null);
    if (result !== 'ok') return back(`?${result}`);
    // Everything about the record in the message (user 2026-11-25): cover, album, artist, year, note, shop, tracklist,
    // buttons to its page, the shop, the services, I gave it / Cancel (whose taps need the webhook set).
    const card = reservationCard({
      ownerFirst: owner.name.split(' ')[0], title: found.title, artist: found.artist, year: found.year, top: found.top, tracks: found.tracks,
      note: found.note, where: found.where, giveOn: null, links: found.links, item, ownerId: owner.id,
      pageUrl: `${Astro.url.origin}${path}/${wishSlug(item)}`, byEmail: user.id < 0,
    });
    Astro.locals.cfContext.waitUntil(connectWebhook(Astro.url.host));
    const [sent] = await notify([{ chatId: user.id, text: card.caption, buttons: card.buttons, photo: found.cover }]);
    return back(sent ? '?reserved' : '?nomsg');
  }
  if (!isOwner && action === 'unreserve') {
    await unreserve(owner.id, item, user.id);
    return back();
  }
  if (!isOwner && action === 'give-on') {
    await setGiveOn(owner.id, item, user.id, safeGiveOn(get('give_on'), today));
    return back();
  }
  if (!isOwner && action === 'gifted') {
    // The record leaves the list, so its page is gone: back to the list (or settings).
    const done = await markGifted(owner.id, item, user);
    return Astro.redirect(fromSettings ? `/settings${done ? '?gifted' : ''}#gifts` : `${path}${done ? '?gifted' : ''}#list`, 303);
  }
  if (!error) return Astro.redirect(path, 303);
}
if (!owner) Astro.response.status = 404;

const isOwner = !!owner && user?.id === owner.id;
const first = owner?.name.split(' ')[0] ?? '';
const q = Astro.url.searchParams;
const editId = isOwner ? Number(q.get('edit')) || 0 : 0;
const edited = editId ? data.items.find((i) => i.key === `c:${editId}`) : undefined;
const editing = edited?.wish ? { ...edited.wish, top: edited.top } : undefined;
// Starred ("Most wanted") first, then A–Z by artist and album (user 2026-11-25), as the Sort menu's A–Z does.
const alpha = (i: { artist: string; title: string }) => `${i.artist} ${i.title}`.toLowerCase();
const items: BrowserItem[] = [...data.items].sort((a, b) => Number(b.top) - Number(a.top) || alpha(a).localeCompare(alpha(b))).map((i) => ({
  id: i.key, anchor: wishAnchor(i.key), href: `${path}/${wishSlug(i.key)}`, record: i, added: i.added, releasedYear: i.year, genres: i.genres, top: i.top,
  search: [i.year, ...i.genres, i.note, ...i.where].filter(Boolean).join(' '),
  marks: [i.where.length > 0 && 'where', !!i.note && 'note'].filter((m): m is 'where' | 'note' => !!m),
  badge: i.state === 'mine' ? { text: 'Reserved by you', on: true } : i.state === 'taken' ? { text: 'Reserved' } : null,
}));
const notice = wishNotice(q, first) ?? (q.has('added') ? (data.items.some((i) => i.key === `c:${Number(q.get('added'))}`) ? 'Added to your wishlist.' : 'Added, but it doesn’t show: that album is already on your shelf.')
  : null);
---
<Layout title={owner ? `${owner.name}’s wishlist - ARVA` : 'Not found - ARVA'} description={owner ? `Records ${first} would like on vinyl.` : undefined}>
  <div class="max-w-5xl mx-auto px-6 w-full flex-grow pt-12 pb-24 *:max-w-3xl">
    <Breadcrumbs class="mb-8" share={!!owner} items={[{ label: 'Shelves', href: '/' }, ...(owner ? [{ label: owner.name, href: `/${shelfSlug(owner)}` }, { label: 'Wishlist' }] : [{ label: 'Not found' }])]} />
    {owner ? (
      <>
        <h1 class="text-3xl font-bold text-zinc-900 dark:text-white">{first}’s wishlist</h1>
        <p class="mt-2 text-zinc-600 dark:text-zinc-400 leading-relaxed">
          {isOwner
            ? 'Records you’d like on vinyl. Friends can reserve one to give you. Reservations are hidden while you’re logged in, so gifts stay a surprise.'
            : `Records ${first} would like on vinyl. Reserve one you’ll give, so nobody else buys the same one. ${first} won’t see who reserved it.`}
        </p>

        {notice && <Toast>{notice}</Toast>}
        {q.has('nomsg') && (user && user.id < 0
          ? <Toast>Reserved, but we couldn’t email you, so there won’t be reminders. Check that messages are on in <a href="/settings#your-account" class="underline underline-offset-4">settings</a>.</Toast>
          : <Toast>Reserved. Telegram didn’t let the bot message you, so there won’t be reminders. <a href={loginHref(Astro.url)} class="underline underline-offset-4">Log in again</a> and allow messages to get them.</Toast>
        )}

        {isOwner && (
          <div class="mt-6 space-y-3">
            <form method="post" class="flex flex-wrap items-center gap-3">
              <input type="hidden" name="action" value="source" />
              <span class="text-sm text-zinc-500">Show</span>
              <span class="inline-flex gap-1 rounded-full bg-(--well) p-1">
                <button name="source" value="custom" aria-pressed={data.source === 'custom' ? 'true' : 'false'} class="ctl !bg-transparent aria-pressed:!bg-(--on-bg)">My own list</button>
                <button name="source" value="discogs" aria-pressed={data.source === 'discogs' ? 'true' : 'false'} class="ctl !bg-transparent aria-pressed:!bg-(--on-bg)">Discogs wantlist</button>
              </span>
            </form>
            {data.source === 'discogs'
              ? <p class="text-sm text-zinc-500 leading-relaxed">From your Discogs wantlist. Add records there (“Add to Wantlist” in the Discogs app) and they show here after the next <a href="/settings?update#shelf" class="text-kikyo-600 dark:text-kikyo-400 underline underline-offset-4">update from Discogs</a>. Your own list is kept while this one shows.</p>
              : <WishForm values={draft ?? editing} editId={editing ? editId : undefined} error={error} />}
          </div>
        )}

        <!-- The same browser as the collection (user 2026-11-25): toolbar, shelf or list, search; each record opens its
             page. Starred ones ("Most wanted") come first in every order. Visitors see which are reserved (a tag on the
             sleeve); the owner never does. -->
        <section id="list" class="mt-10 !max-w-none scroll-mt-6" aria-label="Records on the wishlist">
          {data.items.length ? <RecordBrowser items={items} starAction={isOwner ? path : undefined} sort="az" /> : (
            <p class="text-zinc-500">
              {isOwner
                ? (data.source === 'discogs' ? 'Your Discogs wantlist is empty, or every record on it is already on your shelf.' : 'Nothing here yet. Paste a link above to add an album.')
                : `Nothing on ${first}’s wishlist yet.`}
            </p>
          )}
        </section>
      </>
    ) : (
      <SkippingRecord heading="Shelf not found">There’s no shelf here. <a href="/" class="text-kikyo-600 dark:text-kikyo-400 underline underline-offset-4">See all shelves</a></SkippingRecord>
    )}
  </div>
</Layout>

