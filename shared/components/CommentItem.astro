---
// One comment: author, date, text with clickable links, and Reply / Edit / Delete on one line. Edit swaps the text
// for an editor in place; Reply opens a box under the comment. Both have Cancel (behaviour: src/scripts/comments.ts).
import { COMMENT_MAX, type Comment, type User } from '../lib/store';
import LinkedText from './LinkedText.astro';
import Avatar from './Avatar.astro';

interface Props {
  comment: Comment;
  user: User | null;
  canDelete: boolean;
  action?: string;
  hidden: Record<string, string>;
  small?: boolean;
}
const { comment: c, user, canDelete, action, hidden, small = false } = Astro.props;
const own = !!user && user.id === c.author_id;
const date = (s: number) => new Date(s * 1000).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const field = 'w-full rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-night-surface px-3.5 py-2.5 text-zinc-900 dark:text-white leading-relaxed focus:outline-none focus:border-kikyo-500 transition-colors resize-y';
const primary = 'btn-primary btn-sm';
const quiet = 'text-sm font-medium text-zinc-500 hover:text-zinc-900 dark:hover:text-white px-3 py-1.5 rounded-full transition-colors';
const act = 'text-zinc-500 hover:text-zinc-900 dark:hover:text-white transition-colors';
const hint = 'ml-auto hidden sm:inline text-xs text-zinc-400 dark:text-zinc-500';
---
<div id={`comment-${c.id}`} class="flex gap-3" data-comment>
  <Avatar photo={c.photo_url} name={c.name} px={small ? 28 : 36} lazy class={small ? 'w-7 h-7' : 'w-9 h-9'} />
  <div class="min-w-0 flex-grow">
    <div class="text-sm flex flex-wrap items-baseline gap-x-2">
      {c.username
        ? <a href={`https://t.me/${c.username}`} class="font-medium text-zinc-900 dark:text-white hover:text-kikyo-500 transition-colors">{c.name}</a>
        : <span class="font-medium text-zinc-900 dark:text-white">{c.name}</span>}
      <time class="text-zinc-500" datetime={new Date(c.created_at * 1000).toISOString()}>{date(c.created_at)}</time>
      {c.edited_at && <span class="text-zinc-400 dark:text-zinc-500 text-xs" title={`Edited ${date(c.edited_at)}`}>(edited)</span>}
    </div>

    <div data-view>
      <p class="mt-1 text-zinc-700 dark:text-zinc-300 whitespace-pre-line break-words"><LinkedText text={c.body} /></p>
      {user && (
        <div class="mt-1.5 flex items-center gap-4 text-sm">
          <button type="button" class={act} data-open="reply" aria-expanded="false" aria-controls={`reply-${c.id}`}>Reply</button>
          {own && <button type="button" class={act} data-open="edit" aria-expanded="false" aria-controls={`edit-${c.id}`}>Edit</button>}
          {canDelete && (
            <form method="post" action={action} class="inline-flex">
              {Object.entries(hidden).map(([k, v]) => <input type="hidden" name={k} value={v} />)}
              <input type="hidden" name="action" value="delete" />
              <input type="hidden" name="id" value={c.id} />
              <button class={`${act} hover:!text-red-600 dark:hover:!text-red-400`} onclick={`return confirm('Delete this comment${small ? '' : ' and its replies'}?')`}>Delete</button>
            </form>
          )}
        </div>
      )}
    </div>

    {own && (
      <form id={`edit-${c.id}`} method="post" action={action} data-panel="edit" hidden class="comment-panel mt-1.5 flex flex-col gap-2">
        {Object.entries(hidden).map(([k, v]) => <input type="hidden" name={k} value={v} />)}
        <input type="hidden" name="action" value="edit" />
        <input type="hidden" name="id" value={c.id} />
        <textarea name="body" rows="3" required maxlength={COMMENT_MAX} aria-label="Edit your comment" class={field}>{c.body}</textarea>
        <div class="flex items-center gap-1">
          <button class={primary} data-submit="Saving…">Save</button>
          <button type="button" class={quiet} data-cancel>Cancel</button>
          <span class={hint}>Esc cancels, ⌘/Ctrl + Enter saves</span>
        </div>
      </form>
    )}

    {user && (
      <form id={`reply-${c.id}`} method="post" action={action} data-panel="reply" hidden class="comment-panel mt-3 flex flex-col gap-2">
        {Object.entries(hidden).map(([k, v]) => <input type="hidden" name={k} value={v} />)}
        <input type="hidden" name="parent_id" value={c.id} />
        <textarea name="body" rows="2" required maxlength={COMMENT_MAX} aria-label={`Reply to ${c.name}`} placeholder={`Reply to ${c.name}…`} class={field}></textarea>
        <div class="flex items-center gap-1">
          <button class={primary} data-submit="Sending…">Reply</button>
          <button type="button" class={quiet} data-cancel>Cancel</button>
          <span class={hint}>Esc cancels, ⌘/Ctrl + Enter sends</span>
        </div>
      </form>
    )}
  </div>
</div>
