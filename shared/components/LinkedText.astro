---
// Text someone wrote, with its links clickable (comments). Every link opens in a new tab without passing on the page
// (nofollow ugc: written by people, not vouched for).
import { linkify } from '../lib/lib';

interface Props { text: string }
const { text } = Astro.props;
---
{linkify(text).map((part) => 'url' in part
  ? <a href={part.url} target="_blank" rel="nofollow ugc noopener noreferrer" class="text-kikyo-600 dark:text-kikyo-400 underline decoration-kikyo-500/30 hover:decoration-kikyo-500 underline-offset-4 break-all">{part.url}</a>
  : part.text)}
