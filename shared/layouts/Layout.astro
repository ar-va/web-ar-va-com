---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Props as HeaderProps } from '../components/Header.astro';

// Slots: `head` (extra tags in <head>), `header-actions` (before the theme switch).
interface Props {
  title: string;
  description?: string;
  /** Pages that shouldn't be in search engines (private links, admin pages). */
  noindex?: boolean;
  header?: HeaderProps;
}
const { title, description, noindex = false, header = {} } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Extra tags first, before anything loads: a referrer policy (anon) must apply to the font requests too. -->
    <slot name="head" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- ARVA brand fonts: Brygada 1918 (titles), IBM Plex Sans (text), IBM Plex Mono (aligned numbers). All with Cyrillic. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Brygada+1918:wght@400..700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    {description && <meta name="description" content={description} />}
    {description && <meta property="og:description" content={description} />}
    <meta property="og:title" content={title} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <script is:inline>
      // Back / Forward can restore a page exactly as it was left, with a pressed button still switched off ("Sending…",
      // "Opening Discogs…"): a page left through a form, or marked busy (`data-busy` on <html>), loads fresh instead.
      // Other pages are kept as they were, so going back animates (the cover's move below).
      addEventListener('submit', () => { document.documentElement.dataset.busy = '1'; });
      addEventListener('pageshow', (e) => { if (e.persisted && document.documentElement.dataset.busy) location.reload(); });

      // Between pages the record's cover moves into its new place (global.css, `@view-transition`): on both pages the
      // cover of the record on the other page is named `cover`; on an album page (no link to the other page's record)
      // its hero's cover. Only for the move: the name comes off once it's done (a theme switch would move it again).
      const coverFor = (url) => {
        if (!url) return null;
        const path = new URL(url, location.href).pathname;
        const linked = [...document.querySelectorAll('a .sleeve')].find((s) => s.closest('a').pathname === path && s.checkVisibility?.() !== false);
        return linked ?? (document.querySelector('[data-spin-cover] .sleeve'));
      };
      const named = (el, t) => {
        if (!el || !t) return;
        el.style.viewTransitionName = 'cover';
        t.finished.finally(() => { el.style.viewTransitionName = ''; });
      };
      addEventListener('pageswap', (e) => named(coverFor(e.activation?.entry?.url), e.viewTransition));
      addEventListener('pagereveal', (e) => named(coverFor(window.navigation?.activation?.from?.url ?? document.referrer), e.viewTransition));
    </script>
    
    <!-- Single, optimized theme script to prevent flashing -->
    <script is:inline>
      const theme = (() => {
        // A cookie for the whole site (ar-va.com and music.ar-va.com), set by ThemeToggle; then the older per-site choice.
        const saved = document.cookie.match(/(?:^|; )theme=(dark|light)/);
        if (saved) return saved[1];
        try { if (localStorage.getItem('theme')) return localStorage.getItem('theme'); } catch {}
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="bg-paper text-zinc-900 transition-colors duration-300 dark:bg-zinc-950 dark:text-zinc-300 antialiased min-h-screen flex flex-col">
    <Header {...header}><slot name="header-actions" slot="actions" /></Header>
    <div class="flex-grow flex flex-col">
      <slot />
    </div>
    <Footer />
    <script>import '../scripts/grow';</script>
  </body>
</html>