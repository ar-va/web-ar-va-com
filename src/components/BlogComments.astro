---
// Comments under a blog post. Rendered per request as a server island (the post itself stays pre-rendered).
import CommentThread from './CommentThread.astro';
import LoginButton from './LoginButton.astro';
import { loginHref } from '../music/lib';
import { canDeleteComment, currentUser, listComments } from '../music/store';

interface Props { slug: string }
const { slug } = Astro.props;
const thread = { slug };
const [user, comments] = await Promise.all([currentUser(Astro.cookies), listComments(thread)]);

// Set by /api/comments when a comment was refused; shown once.
const error = Astro.cookies.get('comment_error')?.value ?? null;
if (error) Astro.cookies.delete('comment_error', { path: '/' });

const page = `${Astro.url.origin}/blog/${encodeURIComponent(slug)}#comments`;
---
<CommentThread comments={comments} user={user} canDelete={(id) => canDeleteComment(thread, id, user)}
  action="/api/comments" hidden={{ slug }} error={error}>
  <LoginButton slot="login" href={loginHref(Astro.url, page)} />
</CommentThread>
