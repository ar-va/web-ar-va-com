---
// Comments list + form, shared by music record pages and blog posts. The "login" slot shows when logged out.
import { COMMENT_MAX, type Comment, type User } from '../music/store';
import CommentItem from './CommentItem.astro';

interface Props {
  comments: Comment[];
  user: User | null;
  canDelete: (authorId: number) => boolean;
  action?: string;
  hidden?: Record<string, string>;
  error?: string | null;
  draft?: string;
}
const { comments, user, canDelete, action, hidden = {}, error = null, draft = '' } = Astro.props;
const top = comments.filter((c) => !c.parent_id);
const replies = (id: number) => comments.filter((c) => c.parent_id === id);
---
<h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-6">Comments{comments.length > 0 && <span class="text-zinc-500 font-normal"> ({comments.length})</span>}</h2>

{top.length > 0 && (
  <ul class="flex flex-col gap-7 mb-10">
    {top.map((c) => (
      <li>
        <CommentItem comment={c} user={user} canDelete={canDelete(c.author_id)} action={action} hidden={hidden} />
        {replies(c.id).length > 0 && (
          <ul class="mt-4 ml-12 flex flex-col gap-4 border-l border-zinc-200 dark:border-zinc-800 pl-4">
            {replies(c.id).map((r) => (
              <li><CommentItem comment={r} user={user} canDelete={canDelete(r.author_id)} action={action} hidden={hidden} small /></li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
)}

{user ? (
  <form method="post" action={action} class="flex flex-col gap-3">
    {Object.entries(hidden).map(([k, v]) => <input type="hidden" name={k} value={v} />)}
    <label for="comment-body" class="text-sm text-zinc-500">Comment as {user.name}</label>
    <textarea id="comment-body" name="body" rows="3" required maxlength={COMMENT_MAX}
      class="w-full rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-night-surface px-4 py-3 text-zinc-900 dark:text-white focus:outline-none focus:border-blue-violet-500 transition-colors"
      aria-describedby={error ? 'comment-error' : undefined}>{draft}</textarea>
    {error && <p id="comment-error" class="text-sm text-red-600 dark:text-red-400" role="alert">{error}</p>}
    <div><button class="bg-blue-violet-500 text-white text-sm font-medium px-6 py-2.5 rounded-full hover:bg-blue-violet-600 transition-colors">Post comment</button></div>
  </form>
) : (
  <div class="flex flex-col gap-3">
    <p class="text-sm text-zinc-500">Log in with Telegram to leave a comment.</p>
    <slot name="login" />
  </div>
)}
