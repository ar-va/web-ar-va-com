---
import ThemeToggle from './ThemeToggle.astro';

// On music.ar-va.com the main site's links must leave the subdomain.
const onMusic = Astro.url.hostname.startsWith('music.');
const main = onMusic ? 'https://ar-va.com' : '';
const link = 'text-zinc-500 hover:text-blue-violet-500 transition-colors dark:text-zinc-400 dark:hover:text-blue-violet-400 aria-[current=page]:text-blue-violet-600 dark:aria-[current=page]:text-blue-violet-400';
// The section the visitor is in stays highlighted: Home on /, Blog on /blog and its posts, Music on music.ar-va.com.
const path = Astro.url.pathname;
const current = (on: boolean) => (on ? 'page' : undefined);
---

<!-- Three frosted-glass pills across the page width: logo left, menu centred, account + theme right. Not pinned:
     it scrolls away with the page (user, 2026-10-29). -->
<nav id="site-header" class="relative z-50 mt-3 max-w-5xl mx-auto px-3 sm:px-6 w-full flex justify-between items-center gap-2 sm:grid sm:grid-cols-[1fr_auto_1fr]">
  <a href={`${main}/`} class="glass shrink-0 justify-self-start h-11 rounded-full flex items-center px-3.5 sm:px-5" aria-label="ARVA home">
    <!-- Brand logo files (two-tone: Moss leaf, wordmark in the text colour), ink on light and washi on dark: the horizontal logo (24 px) from 640 px up; on phones the
         small leaf mark (the brand's file for sizes under 32 px), since the full logo doesn't fit beside the menu. -->
    <img src="/brand/arva-horizontal-ink-moss.svg" alt="ARVA" width="100" height="24" class="h-6 w-auto hidden sm:block dark:sm:hidden" />
    <img src="/brand/arva-horizontal-washi-moss.svg" alt="ARVA" width="100" height="24" class="h-6 w-auto hidden dark:sm:block" />
    <img src="/brand/arva-mark-small-ink-moss.svg" alt="ARVA" width="24" height="24" class="h-6 w-6 sm:hidden dark:hidden" />
    <img src="/brand/arva-mark-small-washi-moss.svg" alt="ARVA" width="24" height="24" class="h-6 w-6 hidden dark:block dark:sm:hidden" />
  </a>
  <div class="glass shrink-0 h-11 rounded-full flex items-center px-4 sm:px-6">
    <div class="flex items-center gap-4 sm:gap-6 text-sm font-medium">
      <a href={`${main}/`} class={`${link} hidden sm:inline`} aria-current={current(!onMusic && path === '/')}>Home</a>
      <a href={`${main}/blog`} class={link} aria-current={current(!onMusic && path.startsWith('/blog'))}>Blog</a>
      <a href={onMusic ? '/' : 'https://music.ar-va.com/'} class={link} aria-current={current(onMusic)}>Music</a>
    </div>
  </div>
  <div class="glass shrink-0 justify-self-end h-11 rounded-full flex items-center gap-1.5 p-1.5 text-sm font-medium">
    <a id="account" href="https://ar-va.com/login" title="Log in with Telegram"
      class="flex items-center gap-1.5 h-8 rounded-full bg-zinc-900 dark:bg-white pl-2.5 pr-3.5 text-white dark:text-zinc-900 hover:bg-zinc-700 dark:hover:bg-zinc-200 transition-colors">
      <svg class="w-4 h-4 text-[#2aabee] shrink-0" viewBox="0 0 48 48" fill="currentColor" aria-hidden="true"><path d="M41.4193 7.30899C41.4193 7.30899 45.3046 5.79399 44.9808 9.47328C44.8729 10.9883 43.9016 16.2908 43.1461 22.0262L40.5559 39.0159C40.5559 39.0159 40.3401 41.5048 38.3974 41.9377C36.4547 42.3705 33.5408 40.4227 33.0011 39.9898C32.5694 39.6652 24.9068 34.7955 22.2086 32.4148C21.4531 31.7655 20.5897 30.4669 22.3165 28.9519L33.6487 18.1305C34.9438 16.8319 36.2389 13.8019 30.8426 17.4812L15.7331 27.7616C15.7331 27.7616 14.0063 28.8437 10.7686 27.8698L3.75342 25.7055C3.75342 25.7055 1.16321 24.0823 5.58815 22.459C16.3807 17.3729 29.6555 12.1786 41.4193 7.30899Z"/></svg>
      <span class="whitespace-nowrap">Log in</span>
    </a>
    <ThemeToggle />
  </div>
</nav>

<script is:inline>
  // Runs before paint, so there's no flash of "Log in" for someone already logged in.
  // The `who` cookie (first name + photo, set at login on ar-va.com) is display-only; the session cookie stays HttpOnly.
  (() => {
    const a = document.getElementById('account');
    const base = location.hostname.replace(/^music\./, '') + (location.port ? ':' + location.port : '');
    const m = document.cookie.match(/(?:^|; )who=([^;]*)/);
    let who = null;
    try { who = m && JSON.parse(decodeURIComponent(m[1])); } catch {}
    if (!who || typeof who.n !== 'string') {
      if (location.pathname !== '/login') a.href = `${location.protocol}//${base}/login?return=${encodeURIComponent(location.href)}`;
      return;
    }
    a.href = `${location.protocol}//music.${base}/settings`;
    a.title = 'Your account';
    a.className = 'flex items-center gap-2 h-8 pl-1 pr-2 text-zinc-600 dark:text-zinc-300 hover:text-blue-violet-500 dark:hover:text-blue-violet-400 transition-colors';
    const pic = typeof who.p === 'string' && who.p.startsWith('https://') ? Object.assign(document.createElement('img'), { src: who.p, alt: '', width: 24, height: 24, referrerPolicy: 'no-referrer', className: 'w-6 h-6 rounded-full object-cover' })
      : Object.assign(document.createElement('span'), { textContent: who.n.charAt(0), className: 'w-6 h-6 rounded-full bg-blue-violet-500 text-white text-xs grid place-items-center' });
    const name = Object.assign(document.createElement('span'), { textContent: who.n, className: 'sr-only sm:not-sr-only' });
    a.replaceChildren(pic, name);
  })();
</script>
