---
// "⇅ Sort" button with a small menu. Choosing an option fires a `sort` event (detail: new | old | az | za) on the
// element with the given id; the page reorders its own list.
interface Props { id: string }
const { id } = Astro.props;
const options = [['new', 'Newest first'], ['old', 'Oldest first'], ['az', 'A–Z'], ['za', 'Z–A']];
---
<div id={id} class="relative" data-sort-menu>
  <button type="button" aria-haspopup="true" aria-expanded="false"
    class="ctl group pl-2.5">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 20V4M3.5 7.5 7 4l3.5 3.5M17 4v16M13.5 16.5 17 20l3.5-3.5" /></svg>
    Sort
    <svg class="w-3.5 h-3.5 transition-transform group-aria-expanded:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" /></svg>
  </button>
  <ul hidden role="menu" class="glass absolute left-0 top-full mt-2 z-30 min-w-44 rounded-2xl p-1.5">
    {options.map(([key, label]) => (
      <li role="none">
        <button type="button" role="menuitemradio" aria-checked={key === 'new' ? 'true' : 'false'} data-sort={key}
          class="group w-full flex items-center justify-between gap-4 text-left text-sm px-3 py-2 rounded-xl text-zinc-700 dark:text-zinc-300 hover:bg-zinc-900/5 dark:hover:bg-white/10 aria-checked:text-blue-violet-600 dark:aria-checked:text-blue-violet-400">
          {label}
          <svg class="w-4 h-4 invisible group-aria-checked:visible" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
        </button>
      </li>
    ))}
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-sort-menu]').forEach((menu) => {
    const button = menu.querySelector<HTMLButtonElement>(':scope > button')!;
    const list = menu.querySelector('ul')!;
    const open = (yes: boolean) => { list.hidden = !yes; button.setAttribute('aria-expanded', String(yes)); };
    button.addEventListener('click', () => open(list.hidden));
    document.addEventListener('click', (e) => { if (!menu.contains(e.target as Node)) open(false); });
    menu.addEventListener('keydown', (e) => { if (e.key === 'Escape') { open(false); button.focus(); } });
    list.querySelectorAll<HTMLElement>('[data-sort]').forEach((item) => item.addEventListener('click', () => {
      list.querySelectorAll('[data-sort]').forEach((x) => x.setAttribute('aria-checked', String(x === item)));
      open(false);
      menu.dispatchEvent(new CustomEvent('sort', { detail: item.dataset.sort }));
    }));
  });
</script>
