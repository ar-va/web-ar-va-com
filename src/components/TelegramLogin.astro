---
// Official Telegram Login Widget, used only on ar-va.com/login. The bot's domain must be ar-va.com (@BotFather /setdomain).
import { env } from 'cloudflare:workers';
interface Props { returnTo: string }
const { returnTo } = Astro.props;
const authUrl = `https://${Astro.url.host}/auth/telegram?return=${encodeURIComponent(returnTo)}`;
---
{env.TELEGRAM_BOT_NAME ? (
  <script is:inline async src="https://telegram.org/js/telegram-widget.js?22"
    data-telegram-login={env.TELEGRAM_BOT_NAME} data-size="large" data-radius="999" data-auth-url={authUrl}
    data-request-access="write"></script>
) : (
  <p class="text-sm text-zinc-500">Telegram login isn’t set up yet.</p>
)}
