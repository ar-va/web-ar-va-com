---
// Header slot on the music site: "Log in", or the signed-in person's avatar linking to settings.
import type { User } from '../../music/store';
import { loginHref } from '../../music/lib';

interface Props { user: User | null }
const { user } = Astro.props;
const link = 'text-zinc-500 hover:text-blue-violet-500 transition-colors dark:text-zinc-400 dark:hover:text-blue-violet-400';
---
{user ? (
  <a href="/settings" class={`${link} flex items-center gap-2`} title="Your settings">
    {user.photo_url
      ? <img src={user.photo_url} alt="" width="24" height="24" class="w-6 h-6 rounded-full object-cover" referrerpolicy="no-referrer" />
      : <span class="w-6 h-6 rounded-full bg-blue-violet-500 text-white text-xs grid place-items-center" aria-hidden="true">{user.name.charAt(0)}</span>}
    <span class="sr-only sm:not-sr-only">{user.name.split(' ')[0]}</span>
  </a>
) : (
  <a href={loginHref(Astro.url)} class={link}>Log in</a>
)}
