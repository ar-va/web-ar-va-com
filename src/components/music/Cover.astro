---
// A sleeve with the record inside (styles in global.css, "Music shelf"). The parent sets the width.
import type { ShelfRecord } from '../../music/lib';

interface Props { record: ShelfRecord; eager?: boolean; class?: string }
const { record, eager = false, class: className = '' } = Astro.props;
---
<div class={`sleeve relative aspect-square ${className}`} style={record.vinyl ? `--vinyl: ${record.vinyl}` : undefined}>
  <span class="disc" aria-hidden="true"></span>
  {record.cover ? (
    <img src={record.cover} alt="" width="600" height="600" loading={eager ? 'eager' : 'lazy'} decoding="async"
      referrerpolicy="no-referrer" class="sleeve-face relative w-full h-full object-cover" />
  ) : (
    <span class="sleeve-face relative w-full h-full flex flex-col justify-end p-3 bg-blue-violet-100 dark:bg-blue-violet-950 text-left">
      <span class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-1">{record.artist}</span>
      <span class="text-sm font-bold text-zinc-900 dark:text-white line-clamp-3 leading-snug">{record.title}</span>
    </span>
  )}
</div>
