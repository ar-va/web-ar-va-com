---
// The record's photos: the main cover first, then Discogs' photos. Clicking one opens it large (a <dialog> with
// previous / next and arrow keys); Esc or a click outside closes it.
interface Props { images: string[]; title: string }
const { images, title } = Astro.props;
---
{images.length > 1 && (
  <div class="mt-8">
    <h2 class="text-zinc-500 text-sm mb-2">Photos</h2>
    <ul class="flex flex-wrap gap-2" role="list" data-gallery>
      {images.map((src, i) => (
        <li>
          <button type="button" data-index={i} class="block w-16 h-16 rounded-lg overflow-hidden border border-zinc-200 dark:border-zinc-800 hover:border-blue-violet-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-violet-500 transition-colors" aria-label={`Open photo ${i + 1} of ${images.length}`}>
            <img src={src} alt="" width="64" height="64" loading="lazy" referrerpolicy="no-referrer" class="w-full h-full object-cover" />
          </button>
        </li>
      ))}
    </ul>
    <dialog data-lightbox aria-label={`Photos of ${title}`} class="m-auto max-w-[min(92vw,900px)] max-h-[92vh] bg-transparent p-0 backdrop:bg-black/80 backdrop:backdrop-blur-sm">
      <div class="relative">
        <img data-big src={images[0]} alt="" referrerpolicy="no-referrer" class="block max-w-full max-h-[86vh] rounded-xl object-contain mx-auto" />
        <button type="button" data-step="-1" aria-label="Previous photo" class="absolute left-2 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/50 text-white text-xl hover:bg-black/70">‹</button>
        <button type="button" data-step="1" aria-label="Next photo" class="absolute right-2 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/50 text-white text-xl hover:bg-black/70">›</button>
        <button type="button" data-close aria-label="Close" class="absolute right-2 top-2 w-9 h-9 rounded-full bg-black/50 text-white hover:bg-black/70">×</button>
        <p data-count class="mt-2 text-center text-sm text-white/80"></p>
      </div>
    </dialog>
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((list) => {
    const dialog = list.parentElement!.querySelector<HTMLDialogElement>('[data-lightbox]')!;
    const big = dialog.querySelector<HTMLImageElement>('[data-big]')!;
    const count = dialog.querySelector('[data-count]')!;
    const sources = [...list.querySelectorAll('img')].map((img) => img.src);
    let index = 0;
    const show = (i: number) => {
      index = (i + sources.length) % sources.length;
      big.src = sources[index];
      count.textContent = `${index + 1} / ${sources.length}`;
    };
    list.addEventListener('click', (e) => {
      const button = (e.target as HTMLElement).closest<HTMLElement>('[data-index]');
      if (!button) return;
      show(Number(button.dataset.index));
      dialog.showModal();
    });
    dialog.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === dialog || t.closest('[data-close]')) dialog.close();
      const step = t.closest<HTMLElement>('[data-step]');
      if (step) show(index + Number(step.dataset.step));
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
  });
</script>
