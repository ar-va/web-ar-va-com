---
// A whole shelf page (music.ar-va.com/<name>, and / for the admin's shelf) from shelfData()'s single round trip.
import Layout from '../../layouts/Layout.astro';
import Shelf from './Shelf.astro';
import { shelfSlug, type shelfData } from '../../music/store';

type Props = Awaited<ReturnType<typeof shelfData>>;
const { owner, records, shelves } = Astro.props;
---
<Layout title={owner ? `${owner.name}’s records - ARVA` : 'Not found - ARVA'} description={owner ? `${records.length} vinyl records on ${owner.name}’s shelf.` : undefined}>
  <div class="max-w-5xl mx-auto px-6 w-full flex-grow py-24">
    {owner ? (
      <Shelf owner={{ name: owner.name, slug: shelfSlug(owner), discogs_username: owner.discogs_username!, telegram: owner.username }} records={records} shelves={shelves.map((s) => ({ ...s, slug: shelfSlug(s) }))} />
    ) : (
      <p class="text-zinc-500">There’s no shelf here. <a href="/" class="text-blue-violet-600 dark:text-blue-violet-400 underline underline-offset-4">See all records →</a></p>
    )}
  </div>
</Layout>
