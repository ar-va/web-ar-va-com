---
// Official Telegram Login Widget. The bot's domain must be set to music.ar-va.com with @BotFather (/setdomain).
import { env } from 'cloudflare:workers';
import { musicPath } from '../../music/lib';

interface Props { returnTo?: string }
const returnTo = Astro.props.returnTo ?? musicPath(Astro.url) + Astro.url.search;
const authUrl = `https://${Astro.url.host}/auth/telegram?return=${encodeURIComponent(returnTo)}`;
---
{env.TELEGRAM_BOT_NAME ? (
  <script is:inline async src="https://telegram.org/js/telegram-widget.js?22"
    data-telegram-login={env.TELEGRAM_BOT_NAME} data-size="large" data-radius="999" data-auth-url={authUrl}></script>
) : (
  <p class="text-sm text-zinc-500">Telegram login isn’t set up yet.</p>
)}
