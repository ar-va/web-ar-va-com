---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { createCleanSlug } from '../utils/helpers';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts
  .filter(post => post.data.public)
  .sort((a, b) => b.data.public!.valueOf() - a.data.public!.valueOf());

const postsWithData = await Promise.all(sortedPosts.map(async (post) => {
  const { headings } = await render(post);
  const h1 = headings.find(h => h.depth === 1);
  return {
    ...post,
    displayTitle: h1 ? h1.text : 'Untitled Post'
  };
}));

// Grab the newest post for the "Latest" section
const latestPost = postsWithData[0];

// A static list of topics to match your reference design. 
// Later, these can be extracted dynamically from your Obsidian tags.
const topics = [
  "advice", "ai", "competition", "defaults", "design", "empathy", "evergreen", "friendship", "habits",
  "hardware", "humanism", "ideas", "learning", "leverage", "love", "manufacturing", "media",
  "minimalism", "money", "obsidian", "packaging", "perfectionism", "popular", "projects", "rituals",
  "startups", "synthography", "teaching", "tools", "writing"
];
---

<Layout title="Blog - ARVA">
  <div class="max-w-3xl mx-auto px-6 w-full flex-grow py-24 font-normal">
    
    <!-- Latest Section -->
    {latestPost && (
      <section class="mb-12">
        <h2 class="text-zinc-500 dark:text-zinc-500 text-sm mb-6">Latest</h2>
        <a href={`/blog/${createCleanSlug(latestPost.id)}`} class="group block">
          <h3 class="text-2xl text-zinc-900 dark:text-zinc-200 group-hover:text-blue-violet-600 dark:group-hover:text-white transition-colors mb-2">
            {latestPost.displayTitle}
          </h3>
          <p class="text-zinc-500 text-sm mb-4">
            {latestPost.data.public!.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })} · 1 minute read
          </p>
          <p class="text-zinc-600 dark:text-zinc-400 group-hover:text-zinc-900 dark:group-hover:text-zinc-300 transition-colors">
            It's hard to make a saw that cuts trees but not arms. Keep reading →
          </p>
        </a>
      </section>
    )}

    <hr class="border-zinc-200 dark:border-zinc-800/80 my-12" />

    <!-- Topics Section -->
    <section class="mb-12">
      <h2 class="text-zinc-500 dark:text-zinc-500 text-sm mb-6">Topics</h2>
      <div class="flex flex-wrap gap-x-1.5 gap-y-2 leading-relaxed text-base">
        {topics.map((topic, index) => (
          <div class="inline-flex">
            <a href="#" class="text-zinc-700 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white underline decoration-zinc-300 dark:decoration-zinc-700 hover:decoration-zinc-500 dark:hover:decoration-zinc-400 underline-offset-4 transition-colors">
              {topic}
            </a>
            {index < topics.length - 1 && <span class="text-zinc-400 dark:text-zinc-600 ml-0.5">,</span>}
          </div>
        ))}
      </div>
    </section>

    <hr class="border-zinc-200 dark:border-zinc-800/80 my-12" />

    <!-- Writing Section -->
    <section>
      <h2 class="text-zinc-500 dark:text-zinc-500 text-sm mb-6">Writing</h2>
      <div class="flex flex-col gap-4">
        {postsWithData.map((post) => (
          <div class="flex flex-col sm:flex-row sm:gap-6 items-baseline group">
            <time class="text-zinc-500 dark:text-zinc-500 text-sm tabular-nums shrink-0 sm:w-28 mb-1 sm:mb-0">
              {/* Formats the date to exact YYYY-MM-DD format */}
              {post.data.public!.toISOString().split('T')[0]}
            </time>
            <a href={`/blog/${createCleanSlug(post.id)}`} class="text-zinc-700 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white underline decoration-zinc-300 dark:decoration-zinc-700 hover:decoration-zinc-500 dark:hover:decoration-zinc-400 underline-offset-4 transition-colors text-base">
              {post.displayTitle}
            </a>
          </div>
        ))}
      </div>
    </section>
    
  </div>
</Layout>