---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogComments from '../../components/BlogComments.astro';
import { createCleanSlug } from '../../utils/helpers';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    // Tells Astro to use your frontmatter slug for the URL
    params: { slug: entry.data.slug || createCleanSlug(entry.id) }, 
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const h1 = headings.find(h => h.depth === 1);
const displayTitle = h1 ? h1.text : 'Untitled Post';
---

<style>
  :global(.hide-first-h1 h1:first-of-type) {
    display: none !important;
  }
  /* Absolutely forces Tailwind to remove blockquote quotation marks from nested elements */
  :global(.prose blockquote p:first-of-type::before),
  :global(.prose blockquote p:last-of-type::after) {
    content: none !important;
  }
</style>

<Layout title={`${displayTitle} - ARVA`}>
  <article class="max-w-5xl mx-auto px-6 w-full flex-grow pt-12 pb-24 *:max-w-3xl">
    <header class="mb-12 border-b border-zinc-200 dark:border-zinc-800 pb-8">
      <h1 class="text-4xl font-bold mb-4 text-zinc-900 dark:text-white leading-tight">{displayTitle}</h1>
      
      <div class="flex flex-wrap items-center gap-3 text-sm tracking-widest text-zinc-500">
        {entry.data.created && (
          <time>
            Published {entry.data.created.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}
          </time>
        )}
        
        {entry.data.modified && (
          <span class="flex items-center gap-3">
            <span class="w-1 h-1 rounded-full bg-zinc-300 dark:bg-zinc-700"></span>
            <span>
              Updated {entry.data.modified.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })} at {entry.data.modified.toLocaleTimeString('en-US', { hour12: false, hour: '2-digit', minute: '2-digit' })}
            </span>
          </span>
        )}
      </div>
    </header>
    
    <div class="prose prose-lg prose-zinc dark:prose-invert max-w-none hide-first-h1 font-normal
                prose-p:leading-relaxed prose-p:my-5 prose-p:font-normal prose-li:font-normal prose-blockquote:font-normal
                prose-headings:font-bold prose-headings:tracking-tight prose-headings:mt-0 prose-headings:mb-0
                prose-img:mx-auto prose-img:rounded-xl prose-img:border prose-img:border-zinc-200 dark:prose-img:border-zinc-800 prose-img:max-h-[550px] prose-img:w-auto prose-img:object-contain prose-img:shadow-sm
                prose-a:text-blue-violet-600 dark:prose-a:text-blue-violet-400 prose-a:decoration-blue-violet-500/30 hover:prose-a:decoration-blue-violet-500 prose-a:underline-offset-4 prose-a:font-medium transition-colors
                prose-blockquote:border-l-2 prose-blockquote:border-l-blue-violet-500 prose-blockquote:not-italic
                prose-code:text-blue-violet-600 dark:prose-code:text-blue-violet-400 prose-code:bg-zinc-100 dark:prose-code:bg-zinc-800/70 prose-code:px-1.5 prose-code:py-0.5 prose-code:font-medium prose-code:rounded-md prose-code:before:content-none prose-code:after:content-none
                prose-hr:border-zinc-200 dark:prose-hr:border-zinc-800 prose-hr:my-8">
      <Content />
    </div>

    <hr class="border-zinc-200 dark:border-zinc-800/80 my-12" />
    <section id="comments">
      <BlogComments server:defer slug={Astro.params.slug!}>
        <div slot="fallback" aria-busy="true" aria-label="Loading comments" class="flex flex-col gap-7">
          {[0, 1].map(() => (
            <div class="flex gap-3">
              <span class="skeleton w-9 h-9 rounded-full shrink-0"></span>
              <span class="flex-grow flex flex-col gap-2 pt-1">
                <span class="skeleton h-3 w-40 rounded-full"></span>
                <span class="skeleton h-3 w-full max-w-md rounded-full"></span>
                <span class="skeleton h-3 w-2/3 max-w-xs rounded-full"></span>
              </span>
            </div>
          ))}
        </div>
      </BlogComments>
    </section>
  </article>

  <script>
    // Parses Obsidian's > [!type] syntax securely and formats it into the design system
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.prose blockquote').forEach(quote => {
        const firstP = quote.querySelector('p');
        
        if (firstP && firstP.innerHTML.trim().startsWith('[!')) {
          let html = firstP.innerHTML.trim();
          
          // Isolate the very first line containing the [!type] declaration
          const brIndex = html.indexOf('<br>');
          const newlineIndex = html.indexOf('\n');
          let firstLineEnd = html.length;
          
          if (brIndex !== -1) firstLineEnd = brIndex;
          else if (newlineIndex !== -1) firstLineEnd = Math.min(firstLineEnd, newlineIndex);

          const firstLine = html.substring(0, firstLineEnd);
          const match = firstLine.match(/^\[!([a-zA-Z]+)\](.*)/);

          if (match) {
            const type = match[1];
            const rawTitle = match[2].trim();
            // Automatically fall back to capitalized type name if no custom title is provided
            const title = rawTitle || type.charAt(0).toUpperCase() + type.slice(1);
            
            // Extract the rest of the text and strip the leading <br> if it exists
            const remainingHtml = html.substring(firstLineEnd).replace(/^(<br>|\n)/, '').trim();

            // Inject the styled component
            firstP.innerHTML = `<strong class="block text-blue-violet-600 dark:text-blue-violet-400 mb-2 font-bold uppercase tracking-widest text-sm flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
                </svg>
                ${title}
              </strong>${remainingHtml}`;
          }
        }
      });
      // Auto-format external links with an icon and (domain)
    document.querySelectorAll('.prose a').forEach(link => {
      // Check if the link points to an external domain
      if (link.hostname && link.hostname !== window.location.hostname) {
        // Strip 'www.' for a cleaner display
        const domain = link.hostname.replace(/^www\./, '');
        
        // Prevent double-applying if the script runs multiple times
        if (!link.hasAttribute('data-formatted')) {
          link.setAttribute('data-formatted', 'true');
          
          // Improve UX by automatically opening external links in a new tab
          link.setAttribute('target', '_blank');
          link.setAttribute('rel', 'noopener noreferrer');
          
          // Using 'afterend' places this span OUTSIDE the <a> tag, 
          // keeping it completely isolated from the purple hover/underline styles.
          link.insertAdjacentHTML('afterend', `
            <span class="inline-flex items-center gap-0.5 mr-0.5 text-zinc-500 dark:text-zinc-500 text-[0.85em] font-normal tracking-normal whitespace-nowrap">
              <svg class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              <span>(${domain})</span>
            </span>
          `);
        }
      }
    });
    });
  </script>
  <script>
    // Reply / Edit for the comments island below (delegated, so it works once the island arrives).
    import '../../scripts/comments';
  </script>
</Layout>