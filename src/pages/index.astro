---
// ar-va.com: who I am and what I make (2026-11-28, user: the main domain is the landing page; brand.ar-va.com stays the
// reference for the design language and how the leaf is drawn). Written as Artur, in the first person. Positioning:
// .agents/product-marketing.md. The blog's list returns here when the blog is public again (shared/site.ts).
import Layout from '@shared/layouts/Layout.astro';
import Writing from '../components/Writing.astro';
import { MAIN_SITE_PUBLIC } from '@shared/site';

const products = [
  {
    name: 'music.ar-va.com', href: 'https://music.ar-va.com', status: '', line: 'Your records, on a shelf again',
    text: 'Discogs knows every pressing and catalogue number in a collection. A friend would rather see the covers and hear what you love. Here the collection stands on a shelf, and every record is a click away from playing.',
  },
  {
    name: 'vincent.ar-va.com', href: 'https://vincent.ar-va.com', status: '', line: 'Your colours, all through Nextcloud',
    text: 'Choose the colours you like and Vincent carries them across Nextcloud, in light and in dark, keeping every word readable. You leave with the exact settings to paste in.',
  },
  {
    name: 'anon.ar-va.com', href: 'https://anon.ar-va.com', status: '', line: 'Say it without your name',
    text: 'Some things are easier to write than to say out loud. anon is a single box that never asks who you are, and a private link brings back my reply.',
  },
  {
    name: 'Solaris', href: '', status: 'In progress', line: 'A studio’s day, in one place',
    text: 'Between the front desk and the chair, a tattoo studio runs on a hundred small tasks. I’m building Solaris to carry them quietly and to ask before it decides anything that matters.',
  },
];

const habits = [
  { title: 'Begin with the gap', text: 'I start where people have been making do: a tool built for experts, or no tool at all.' },
  { title: 'Design for the first visit', text: 'If someone new to the subject can use it on the first try, it is ready. If not, I keep going.' },
  { title: 'Keep the engineering out of sight', text: 'Most of the work never shows. The record on the shelf turns at a true 33⅓ rpm, and Vincent’s tests put about a thousand generated themes through every contrast check. All you should notice is that nothing gets in your way.' },
  { title: 'Leave the choices to you', text: 'The software takes the chores. Your colours, your words and your studio stay your call.' },
];

const link = 'text-kikyo-600 dark:text-kikyo-400 underline underline-offset-3 hover:text-zinc-900 dark:hover:text-white';
const body = 'text-lg text-zinc-700 dark:text-zinc-300 text-pretty';
const h2 = 'font-bold text-2xl sm:text-3xl text-zinc-900 dark:text-white';
---
<Layout title="ARVA: what was missing, made well" description="I’m Artur, and ARVA is the name I build under: a record shelf for friends who don’t collect, Nextcloud in your own colours, a box for saying things without your name, and soon Solaris, for tattoo studios.">
  <main class="max-w-5xl mx-auto px-6 w-full pt-12 pb-24">
    <header class="max-w-3xl">
      <div>
        <h1 class="font-bold text-5xl sm:text-6xl leading-[1.05] text-zinc-900 dark:text-white text-balance">What was missing, made well</h1>
        <p class={`mt-6 max-w-2xl text-xl text-zinc-700 dark:text-zinc-300 text-pretty`}>
          I’m Artur, and ARVA is the name I build under. I make software for the gaps other tools leave behind: calm to
          use, precise in how it works, and meant to stay useful long after the season it arrived in.
        </p>
      </div>
    </header>

    <section class="mt-20" aria-labelledby="work">
      <h2 id="work" class={h2}>The work</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {products.map((p) => (
          <li class:list={['relative rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-night-surface p-6', p.href && 'hover:border-zinc-500 has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2 has-[a:focus-visible]:outline-kikyo-500']}>
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h3 class="font-bold text-xl text-zinc-900 dark:text-white">
                {p.href ? <a href={p.href} class="after:absolute after:inset-0 focus-visible:outline-none">{p.name}</a> : p.name}
              </h3>
              {p.status && <span class="rounded-md bg-zinc-100 dark:bg-zinc-800 px-2 py-0.5 text-xs font-medium text-zinc-600 dark:text-zinc-300">{p.status}</span>}
            </div>
            <p class="mt-1 font-medium text-zinc-800 dark:text-zinc-200">{p.line}</p>
            <p class="mt-3 text-zinc-600 dark:text-zinc-400 text-pretty">{p.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-20" aria-labelledby="habits">
      <h2 id="habits" class={h2}>How I work</h2>
      <dl class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2 max-w-4xl">
        {habits.map((w) => (
          <div>
            <dt class="font-medium text-lg text-zinc-900 dark:text-white">{w.title}</dt>
            <dd class="mt-1.5 text-zinc-600 dark:text-zinc-400 text-pretty">{w.text}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="mt-20 max-w-3xl" aria-labelledby="leaf">
      <h2 id="leaf" class={h2}>The leaf</h2>
      <p class={`mt-4 ${body}`}>
        My sign is a <i>kashiwa</i> leaf, from the Japanese oak that holds its leaves through winter and lets them go only
        when new ones are ready. I want what I make to last like that.
      </p>
      <p class={`mt-4 ${body}`}>
        <a class={link} href="https://brand.ar-va.com/story">How the leaf is drawn from 18 circles</a> and <a class={link} href="https://brand.ar-va.com/">the rules all my products follow</a> are on brand.ar-va.com.
      </p>
    </section>

    {MAIN_SITE_PUBLIC && <div class="mt-20"><Writing /></div>}
  </main>
</Layout>
