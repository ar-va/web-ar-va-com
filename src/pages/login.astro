---
// The one login page (ar-va.com/login). Left: why to join (a community of collectors: what you can do, who's here,
// "Request a shelf"); right: the Telegram login. Names the page the visitor came from when it can.
export const prerender = false;
import { getCollection } from 'astro:content';
import { MAIN_SITE_PUBLIC } from '@shared/site';
import Layout from '@shared/layouts/Layout.astro';
import TelegramLogin from '../components/TelegramLogin.astro';
import Cover from '@shared/components/Cover.astro';
import { createCleanSlug } from '../utils/helpers';
import { env } from 'cloudflare:workers';
import { safeReturnPath, telegramAuthUrl } from '@shared/lib/lib';
import { adminShelfOwner, currentUser, directory, hasPendingInvite, shelfOwner, shelfRecord, shelfRecords, shelfSlug } from '@shared/lib/store';

const returnTo = safeReturnPath(Astro.url.searchParams.get('return'), Astro.url.hostname);
const failed = Astro.url.searchParams.has('failed');

const musicOrigin = `${Astro.url.protocol}//music.${Astro.url.host}`;
const back = new URL(returnTo, Astro.url);
const titleOf = (body = '') => body.match(/^#\s+(.+)$/m)?.[1].trim();
// A malformed escape (%zz) in a hand-typed or cut-off link names nothing, rather than breaking the page.
const decode = (s: string) => { try { return decodeURIComponent(s); } catch { return ''; } };
const [, shelfUser, instance] = back.hostname.startsWith('music.') ? back.pathname.match(/^\/([^/]+)\/(\d+)/) ?? [] : [];

// The database is read in two rounds, not one trip after another: this is the first page new people see.
// Who's here (every collector's shelf: faces and totals), the admin's shelf, and the shelf of the record they came from.
const [user, recordOwner, admin, shelves, allPosts] = await Promise.all([
  currentUser(Astro.cookies),
  shelfUser && decode(shelfUser) ? shelfOwner(decode(shelfUser)) : null,
  adminShelfOwner(),
  directory(4),
  getCollection('blog'),
]);
if (user) return Astro.redirect(returnTo);
// A small shelf to show what music.ar-va.com is: the record they came from first, then the latest additions.
const [fromRecord, latest] = await Promise.all([
  recordOwner ? shelfRecord(recordOwner.id, Number(instance)) : null,
  admin ? shelfRecords(admin.id) : [],
]);

// Where they came from: a blog post or a record gets named in the headline.
const posts = allPosts.filter((p) => p.data.created).sort((a, b) => b.data.created!.valueOf() - a.data.created!.valueOf());
const fromSlug = back.hostname === Astro.url.hostname && back.pathname.match(/^\/blog\/([^/]+)/)?.[1];
const fromPost = fromSlug ? posts.find((p) => (p.data.slug || createCleanSlug(p.id)) === decode(fromSlug)) : undefined;
const shelf = [...(fromRecord ? [fromRecord] : []), ...latest.filter((r) => r.instanceId !== fromRecord?.instanceId)].slice(0, 4);
const shelfOwnerName = (fromRecord ? recordOwner : admin) ? shelfSlug((fromRecord ? recordOwner : admin)!) : null;
const showShelf = shelf.length > 0 && !!shelfOwnerName;

const about = fromRecord ? `${fromRecord.title} by ${fromRecord.artist}` : fromPost ? titleOf(fromPost.body) : null;

const records = shelves.reduce((n, x) => n + x.count, 0);
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
// "Request a shelf": log in (Telegram's window, staying here), then settings sends the request (?request).
const requestNext = `${musicOrigin}/settings?request`;
const botId = env.TELEGRAM_BOT_TOKEN?.split(':')[0];
const requestAuth = botId ? telegramAuthUrl(botId, Astro.url.origin, requestNext) : undefined;
// Someone who opened an invite link first doesn't need to ask: logging in accepts it (auth/telegram.ts).
const invited = hasPendingInvite(Astro.cookies);
const joins = [
  { icon: 'M7.5 8.5h9M7.5 12.5h6M5 19.5V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H8z', title: 'Talk records', text: 'Comment on any shelf or album and reply to others. Telegram tells you when someone answers.' },
  { icon: 'M4 6h16M4 12h16M4 18h10', title: 'Put your shelf up', text: 'Connect Discogs and your collection appears with covers, tracklists, listening links and your own notes. Free.' },
  { icon: 'M16 19v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 4 17.5V19M10 10.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM20 19v-1.5a3.5 3.5 0 0 0-2.5-3.35M15.5 4.6a3 3 0 0 1 0 5.8', title: 'Grow it together', text: 'Every collector can invite friends, so each shelf here belongs to someone you can talk to.' },
];
const ring = (width: string) => `rounded-full ${width} ring-white dark:ring-night-surface`;

const perks = [
  { icon: 'M13 10V3L4 14h7v7l9-11h-7z', text: 'No password, no email, no new account to make.' },
  { icon: 'M9 12.75 11.25 15 15 9.75M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9z', text: 'Telegram shares your name, @username and photo. Never your phone number.' },
  { icon: 'M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244', text: 'One login for ar-va.com and music.ar-va.com. Log out any time.' },
];
---
<Layout title="Log in - ARVA" description={`Join a community of record collectors: log in with Telegram to comment on ${MAIN_SITE_PUBLIC ? 'articles, shelves and records' : 'shelves and records'}, or ask for a shelf of your own.`}>
  <!-- Explanation on the left, the action on the right (phones: headline, action, then the previews). -->
  <div class="max-w-5xl mx-auto px-6 w-full flex-grow pt-12 pb-16 md:pb-24 grid grid-cols-1 md:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] gap-x-16 gap-y-10 md:content-center">

    <section class="md:col-start-1 md:row-start-1">
      <h1 class="text-5xl sm:text-6xl font-bold mb-5 tracking-tight text-zinc-900 dark:text-white leading-[1.05]">Records are better shared</h1>
      <p class="text-lg leading-relaxed max-w-xl text-zinc-600 dark:text-zinc-300">
        {about && <>You were looking at <span class="text-zinc-900 dark:text-white font-medium">{about}</span>. </>}
        A small, friendly home for vinyl collections: real shelves, real people and the stories behind the records.
        Log in to join in.
      </p>
    </section>

    <section aria-labelledby="login-heading" class="md:col-start-2 md:row-start-1 md:row-span-2 md:self-center">
      <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-night-surface p-7 sm:p-8 shadow-sm dark:shadow-none">
        <div class="w-12 h-12 rounded-full bg-[#2aabee] text-white grid place-items-center mb-5" aria-hidden="true">
          <svg class="w-6 h-6 -ml-0.5" viewBox="0 0 48 48" fill="currentColor"><path d="M41.4193 7.30899C41.4193 7.30899 45.3046 5.79399 44.9808 9.47328C44.8729 10.9883 43.9016 16.2908 43.1461 22.0262L40.5559 39.0159C40.5559 39.0159 40.3401 41.5048 38.3974 41.9377C36.4547 42.3705 33.5408 40.4227 33.0011 39.9898C32.5694 39.6652 24.9068 34.7955 22.2086 32.4148C21.4531 31.7655 20.5897 30.4669 22.3165 28.9519L33.6487 18.1305C34.9438 16.8319 36.2389 13.8019 30.8426 17.4812L15.7331 27.7616C15.7331 27.7616 14.0063 28.8437 10.7686 27.8698L3.75342 25.7055C3.75342 25.7055 1.16321 24.0823 5.58815 22.459C16.3807 17.3729 29.6555 12.1786 41.4193 7.30899Z"/></svg>
        </div>
        <h2 id="login-heading" class="text-xl font-bold text-zinc-900 dark:text-white mb-1">Log in with Telegram</h2>
        <p class="text-sm text-zinc-500 mb-6">Telegram asks you to confirm, then brings you right back.</p>

        {failed && <p class="text-sm text-red-600 dark:text-red-400 mb-4" role="alert">That login didn’t work. Please try again.</p>}
        <div class="min-h-[46px]"><TelegramLogin returnTo={returnTo} /></div>

        <ul class="mt-7 pt-6 border-t border-zinc-100 dark:border-zinc-800 flex flex-col gap-3.5">
          {perks.map((p) => (
            <li class="flex gap-3 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              <svg class="w-5 h-5 shrink-0 text-kikyo-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={p.icon} /></svg>
              {p.text}
            </li>
          ))}
        </ul>

        <details class="group mt-6 rounded-xl bg-zinc-50 dark:bg-white/[0.03] px-4 py-3 text-sm">
          <summary class="cursor-pointer list-none flex items-center justify-between gap-3 font-medium text-zinc-700 dark:text-zinc-300 [&::-webkit-details-marker]:hidden">
            New to Telegram? Why it’s safe
            <svg class="w-4 h-4 shrink-0 text-zinc-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
          </summary>
          <div class="mt-3 flex flex-col gap-2.5 text-zinc-600 dark:text-zinc-400 leading-relaxed">
            <p>Telegram is a free messaging app for phones and computers, used by more than a billion people.</p>
            <p>When you log in, Telegram asks you to confirm it’s you inside the app. This site never sees your phone number, password, contacts or messages: it receives a confirmation signed by Telegram with your public name, @username and photo, and checks that signature before trusting it.</p>
            <p>You can log out here with one click, and disconnect this site at any time in Telegram’s settings.</p>
            <a href="https://telegram.org/" target="_blank" rel="noopener noreferrer" class="self-start font-medium text-[#2aabee] hover:underline underline-offset-4">Get Telegram</a>
          </div>
        </details>
      </div>
      <p class="mt-5 text-sm text-zinc-500 text-center">
        <a href={returnTo} class="hover:text-kikyo-500 dark:hover:text-kikyo-400 transition-colors">← Back without logging in</a>
      </p>
    </section>

    <!-- What logging in lets you do, who's already here, and asking for a shelf of your own. -->
    <section aria-label="What you can do after logging in" class="md:col-start-1 md:row-start-2 flex flex-col gap-8">
      <ul class="flex flex-col gap-5" role="list">
        {joins.map((j) => (
          <li class="flex gap-4">
            <span class="shrink-0 w-10 h-10 rounded-full grid place-items-center bg-(--on-bg) text-(--on-text)">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={j.icon} /></svg>
            </span>
            <span>
              <span class="block font-medium text-zinc-900 dark:text-white">{j.title}</span>
              <span class="block mt-0.5 text-zinc-600 dark:text-zinc-400 leading-relaxed">{j.text}</span>
            </span>
          </li>
        ))}
      </ul>

      <div class="rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white/60 dark:bg-night-surface p-6">
        <div class="flex flex-wrap items-center gap-3">
          <span class="flex -space-x-2.5" aria-hidden="true">
            {shelves.slice(0, 5).map((x) => x.photo_url?.startsWith('https://')
              ? <img src={x.photo_url} alt="" width="32" height="32" referrerpolicy="no-referrer" class={`w-8 h-8 object-cover ${ring('ring-2')}`} />
              : <span class={`w-8 h-8 text-xs grid place-items-center bg-(--on-bg) text-(--on-text) font-semibold ${ring('ring-2')}`}>{x.name.slice(0, 1)}</span>)}
          </span>
          <a href={`${musicOrigin}/`} class="text-sm text-zinc-600 dark:text-zinc-400 hover:text-kikyo-600 dark:hover:text-kikyo-400 transition-colors">
            {plural(shelves.length, 'collector')} sharing {plural(records, 'record')}
          </a>
        </div>
        {showShelf && (
          <ul class="shelf mt-2" style="--gap: 0.6rem; grid-template-columns: repeat(4, minmax(0, 1fr)); row-gap: 0; padding-bottom: 0.5rem" role="list">
            {shelf.map((r) => (
              <li class="shelf-slot">
                <a href={`${musicOrigin}/${encodeURIComponent(shelfOwnerName!)}/${r.instanceId}`} class="shelf-record block" title={`${r.artist} – ${r.title}`}>
                  <Cover record={r} />
                  <span class="sr-only">{r.artist} – {r.title}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
        <div class="mt-6 pt-5 border-t border-zinc-100 dark:border-zinc-800 flex flex-wrap items-center justify-between gap-4">
          {invited ? (
            <div class="min-w-0 max-w-sm">
              <p class="font-medium text-zinc-900 dark:text-white">You have an invite</p>
              <p class="mt-0.5 text-sm text-zinc-600 dark:text-zinc-400">Log in with Telegram and it’s accepted: next you connect Discogs and your shelf fills itself.</p>
            </div>
          ) : (<>
          <div class="min-w-0 max-w-sm">
            <p class="font-medium text-zinc-900 dark:text-white">Have records on Discogs?</p>
            <p class="mt-0.5 text-sm text-zinc-600 dark:text-zinc-400">Shelves are invite-only. Ask for one and your invite link comes on Telegram.</p>
          </div>
          <div>
            <a href={`/login?return=${encodeURIComponent(requestNext)}`} data-tg-auth={requestAuth} data-tg-next={requestNext}
              class="inline-flex items-center h-10 px-5 rounded-full text-sm font-semibold bg-kikyo-600 dark:bg-kikyo-400 text-white dark:text-zinc-950 hover:bg-kikyo-700 dark:hover:bg-kikyo-300 transition-colors">Request a shelf</a>
            <p data-tg-hint hidden class="mt-2 text-xs text-zinc-500">Window closed? Log in on the right, then use “Request a shelf” in settings.</p>
          </div>
          </>)}
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  import '@shared/scripts/telegram-popup';
</script>
