---
// The one login page (ar-va.com/login). It shows what logging in is for, using the page the visitor came from when it can.
export const prerender = false;
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import TelegramLogin from '../components/TelegramLogin.astro';
import Cover from '../components/music/Cover.astro';
import { createCleanSlug } from '../utils/helpers';
import { safeReturnPath } from '../music/lib';
import { adminShelfOwner, currentUser, shelfOwner, shelfRecord, shelfRecords, shelfSlug } from '../music/store';

const returnTo = safeReturnPath(Astro.url.searchParams.get('return'), Astro.url.hostname);
if (await currentUser(Astro.cookies)) return Astro.redirect(returnTo);
const failed = Astro.url.searchParams.has('failed');

const musicOrigin = `${Astro.url.protocol}//music.${Astro.url.host}`;
const back = new URL(returnTo, Astro.url);
const titleOf = (body = '') => body.match(/^#\s+(.+)$/m)?.[1].trim();

// Where they came from: a blog post or a record gets named in the headline.
const posts = (await getCollection('blog')).filter((p) => p.data.created).sort((a, b) => b.data.created!.valueOf() - a.data.created!.valueOf());
const fromSlug = back.hostname === Astro.url.hostname && back.pathname.match(/^\/blog\/([^/]+)/)?.[1];
const fromPost = fromSlug ? posts.find((p) => (p.data.slug || createCleanSlug(p.id)) === decodeURIComponent(fromSlug)) : undefined;
const post = fromPost ?? posts[0];
const [, shelfUser, instance] = back.hostname.startsWith('music.') ? back.pathname.match(/^\/([^/]+)\/(\d+)/) ?? [] : [];
const recordOwner = shelfUser ? await shelfOwner(decodeURIComponent(shelfUser)) : null;
const fromRecord = recordOwner ? await shelfRecord(recordOwner.id, Number(instance)) : null;

// A small shelf to show what music.ar-va.com is: the record they came from first, then the latest additions.
const admin = await adminShelfOwner();
const latest = admin ? await shelfRecords(admin.id) : [];
const shelf = [...(fromRecord ? [fromRecord] : []), ...latest.filter((r) => r.instanceId !== fromRecord?.instanceId)].slice(0, 4);
const shelfOwnerName = (fromRecord ? recordOwner : admin) ? shelfSlug((fromRecord ? recordOwner : admin)!) : null;
const showShelf = shelf.length > 0 && !!shelfOwnerName;

const about = fromRecord ? `${fromRecord.title} by ${fromRecord.artist}` : fromPost ? titleOf(fromPost.body) : null;
const promptTitle = fromRecord?.title ?? titleOf(post?.body) ?? 'this';

const perks = [
  { icon: 'M13 10V3L4 14h7v7l9-11h-7z', text: 'No password, no email, no new account to make.' },
  { icon: 'M9 12.75 11.25 15 15 9.75M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9z', text: 'Telegram shares your name, @username and photo. Never your phone number.' },
  { icon: 'M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244', text: 'One login for ar-va.com and music.ar-va.com. Log out any time.' },
];
---
<Layout title="Log in - ARVA" description="Log in with Telegram to comment on articles and records at ar-va.com.">
  <!-- Explanation on the left, the action on the right (phones: headline, action, then the previews). -->
  <div class="max-w-6xl mx-auto px-6 w-full flex-grow py-16 md:py-24 grid grid-cols-1 md:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] gap-x-16 gap-y-10 md:content-center">

    <section class="md:col-start-1 md:row-start-1">
      <div class="flex items-center gap-4 mb-4">
        <div class="w-6 h-[2px] bg-blue-violet-500"></div>
        <span class="text-xs font-bold tracking-widest uppercase text-zinc-500 dark:text-zinc-400">Comments on ar-va.com</span>
      </div>
      <h1 class="text-5xl sm:text-6xl font-bold mb-5 tracking-tight text-zinc-900 dark:text-white leading-[1.05]">
        Join the conversation<span class="text-blue-violet-500">.</span>
      </h1>
      <p class="text-lg leading-relaxed max-w-xl text-zinc-600 dark:text-zinc-300">
        {about
          ? <>Say what you think about <span class="text-zinc-900 dark:text-white font-medium">{about}</span>, and comment on every other article and record here.</>
          : <>Comment on the articles here and on the records in my collection, with the Telegram account you already have.</>}
      </p>
    </section>

    <section aria-labelledby="login-heading" class="md:col-start-2 md:row-start-1 md:row-span-2 md:self-center">
      <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#1a1a1a] p-7 sm:p-8 shadow-sm dark:shadow-none">
        <div class="w-12 h-12 rounded-full bg-[#2aabee] text-white grid place-items-center mb-5" aria-hidden="true">
          <svg class="w-6 h-6 -ml-0.5" viewBox="0 0 48 48" fill="currentColor"><path d="M41.4193 7.30899C41.4193 7.30899 45.3046 5.79399 44.9808 9.47328C44.8729 10.9883 43.9016 16.2908 43.1461 22.0262L40.5559 39.0159C40.5559 39.0159 40.3401 41.5048 38.3974 41.9377C36.4547 42.3705 33.5408 40.4227 33.0011 39.9898C32.5694 39.6652 24.9068 34.7955 22.2086 32.4148C21.4531 31.7655 20.5897 30.4669 22.3165 28.9519L33.6487 18.1305C34.9438 16.8319 36.2389 13.8019 30.8426 17.4812L15.7331 27.7616C15.7331 27.7616 14.0063 28.8437 10.7686 27.8698L3.75342 25.7055C3.75342 25.7055 1.16321 24.0823 5.58815 22.459C16.3807 17.3729 29.6555 12.1786 41.4193 7.30899Z"/></svg>
        </div>
        <h2 id="login-heading" class="text-xl font-bold text-zinc-900 dark:text-white mb-1">Log in with Telegram</h2>
        <p class="text-sm text-zinc-500 mb-6">Telegram asks you to confirm, then brings you right back.</p>

        {failed && <p class="text-sm text-red-600 dark:text-red-400 mb-4" role="alert">That login didn’t work. Please try again.</p>}
        <div class="min-h-[46px]"><TelegramLogin returnTo={returnTo} /></div>

        <ul class="mt-7 pt-6 border-t border-zinc-100 dark:border-zinc-800 flex flex-col gap-3.5">
          {perks.map((p) => (
            <li class="flex gap-3 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              <svg class="w-5 h-5 shrink-0 text-blue-violet-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={p.icon} /></svg>
              {p.text}
            </li>
          ))}
        </ul>

        <details class="group mt-6 rounded-xl bg-zinc-50 dark:bg-white/[0.03] px-4 py-3 text-sm">
          <summary class="cursor-pointer list-none flex items-center justify-between gap-3 font-medium text-zinc-700 dark:text-zinc-300 [&::-webkit-details-marker]:hidden">
            New to Telegram? Why it’s safe
            <svg class="w-4 h-4 shrink-0 text-zinc-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
          </summary>
          <div class="mt-3 flex flex-col gap-2.5 text-zinc-600 dark:text-zinc-400 leading-relaxed">
            <p>Telegram is a free messaging app for phones and computers, used by more than a billion people.</p>
            <p>When you log in, Telegram asks you to confirm it’s you inside the app. This site never sees your phone number, password, contacts or messages: it receives a confirmation signed by Telegram with your public name, @username and photo, and checks that signature before trusting it.</p>
            <p>You can log out here with one click, and disconnect this site at any time in Telegram’s settings.</p>
            <a href="https://telegram.org/" target="_blank" rel="noopener noreferrer" class="self-start font-medium text-[#2aabee] hover:underline underline-offset-4">Get Telegram →</a>
          </div>
        </details>
      </div>
      <p class="mt-5 text-sm text-zinc-500 text-center">
        <a href={returnTo} class="hover:text-blue-violet-500 dark:hover:text-blue-violet-400 transition-colors">← Back without logging in</a>
      </p>
    </section>

    <!-- What logging in unlocks, drawn from the real site. Decorative: nothing in it is a working form. -->
    <section aria-label="What you can do after logging in" class:list={["md:col-start-1 md:row-start-2 grid grid-cols-1 gap-5 items-start", { "lg:grid-cols-2": showShelf }]}>
      <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white/60 dark:bg-[#161616] p-6">
        <div class="flex items-center gap-2 text-xs font-bold tracking-widest uppercase text-zinc-500 dark:text-zinc-400 mb-3">
          <div class="w-2 h-2 rounded-full bg-blue-violet-500"></div>
          {fromRecord ? 'On the shelf' : 'On the blog'}
        </div>
        {fromRecord ? (
          <p class="font-bold text-zinc-900 dark:text-white leading-snug mb-5">{fromRecord.title}<span class="block text-sm font-normal text-zinc-500">{fromRecord.artist}</span></p>
        ) : post && (
          <a href={`/blog/${post.data.slug || createCleanSlug(post.id)}`} class="block font-bold text-zinc-900 dark:text-white leading-snug mb-5 hover:text-blue-violet-500 transition-colors">{titleOf(post.body)}</a>
        )}
        <div class="flex gap-3" aria-hidden="true">
          <span class="w-8 h-8 rounded-full bg-linear-to-br from-[#2aabee] to-blue-violet-500 text-white text-[10px] font-bold grid place-items-center shrink-0">You</span>
          <div class="flex-grow min-w-0">
            <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 px-3 py-2.5 text-zinc-400 dark:text-zinc-500 text-sm truncate">Your thoughts on “{promptTitle}”…</div>
            <div class="mt-2.5 flex justify-end"><span class="bg-blue-violet-500/90 text-white text-xs font-medium px-4 py-1.5 rounded-full">Post</span></div>
          </div>
        </div>
      </div>

      {showShelf && (
        <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white/60 dark:bg-[#161616] p-6 pb-7">
          <div class="flex items-center justify-between gap-3 mb-4">
            <div class="flex items-center gap-2 text-xs font-bold tracking-widest uppercase text-zinc-500 dark:text-zinc-400">
              <div class="w-2 h-2 rounded-full bg-blue-violet-500"></div>
              And every record
            </div>
            <a href={`${musicOrigin}/${encodeURIComponent(shelfOwnerName)}`} class="text-sm font-medium text-blue-violet-600 dark:text-blue-violet-400 hover:underline underline-offset-4" aria-label="Open music.ar-va.com">→</a>
          </div>
          <ul class="shelf" style="--gap: 0.6rem; grid-template-columns: repeat(4, minmax(0, 1fr)); row-gap: 0; padding-bottom: 0.5rem" role="list">
            {shelf.map((r) => (
              <li class="shelf-slot">
                <a href={`${musicOrigin}/${encodeURIComponent(shelfOwnerName)}/${r.instanceId}`} class="shelf-record block" title={`${r.artist} – ${r.title}`}>
                  <Cover record={r} />
                  <span class="sr-only">{r.artist} – {r.title}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-5 text-xs text-zinc-500">{latest.length} records at <a href={`${musicOrigin}/${encodeURIComponent(shelfOwnerName)}`} class="hover:text-blue-violet-500 transition-colors">music.ar-va.com</a></p>
        </div>
      )}
    </section>
  </div>
</Layout>
