---
// One record: Discogs details (with the owner's edits), public Discogs fields, tracklist with listening links, comments.
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import RecordHero from '../../../components/music/RecordHero.astro';
import Gallery from '../../../components/music/Gallery.astro';
import LoginButton from '../../../components/LoginButton.astro';
import CommentThread from '../../../components/CommentThread.astro';
import Listen from '../../../components/music/Listen.astro';
import { commentNotices, displayDate, formatReleased, gallery, loginHref, musicPath, recordDefaults, recordValues, shelfView, textToTracklist, withSideHeadings } from '../../../music/lib';
import { cachedRelease } from '../../../music/discogs';
import { addComment, canDeleteComment, currentUser, deleteComment, editComment, listComments, recordOverrides, releaseMatch, shelfOwner, shelfRecord, shelfSlug } from '../../../music/store';
import { notify } from '../../../music/notify';

const instanceId = Number(Astro.params.record);
const [user, owner] = await Promise.all([currentUser(Astro.cookies), shelfOwner(Astro.params.user!)]);
const record = owner && Number.isSafeInteger(instanceId) ? await shelfRecord(owner.id, instanceId) : null;
const path = musicPath(Astro.url);
const thread = { shelfId: owner?.id ?? 0, instanceId };

let error: string | null = null;
let draft = '';
if (owner && record && Astro.request.method === 'POST') {
  if (!user) return Astro.redirect(loginHref(Astro.url), 303);
  const form = await Astro.request.formData();
  const action = form.get('action');
  const id = Number(form.get('id'));
  if (action === 'delete') {
    await deleteComment(thread, id, user);
    return Astro.redirect(`${path}#comments`, 303);
  }
  if (action === 'edit') {
    error = await editComment(thread, id, user, String(form.get('body') ?? ''));
    if (!error) return Astro.redirect(`${path}#comment-${id}`, 303);
  } else {
    draft = String(form.get('body') ?? '');
    const saved = await addComment(thread, user, draft, Number(form.get('parent_id')) || null);
    if ('error' in saved) {
      error = saved.error;
    } else {
      const title = (await recordOverrides(owner.id, instanceId)).title ?? record.title;
      Astro.locals.cfContext.waitUntil(notify(commentNotices({
        authorId: user.id, authorName: user.name, ownerId: owner.id, parentAuthorId: saved.parentAuthorId,
        title, body: draft.trim(), url: `${Astro.url.origin}${path}#comment-${saved.id}`,
      })));
      return Astro.redirect(`${path}#comment-${saved.id}`, 303);
    }
  }
}

if (!owner || !record) Astro.response.status = 404;
const [detail, comments, overrides, match] = owner && record
  ? await Promise.all([cachedRelease(record.releaseId), listComments(thread), recordOverrides(owner.id, instanceId), releaseMatch(record.releaseId)])
  : [null, [], {}, null];
const v = record ? recordValues(recordDefaults(record, detail, match), overrides) : {};
const tracks = record ? withSideHeadings(textToTracklist(v.tracklist)) : [];
const hero = record ? shelfView(record, detail, overrides, match) : null;
const photos = record ? gallery(hero!.cover, record.cover, detail?.images) : [];
const isOwner = !!user && user.id === owner?.id;

const shelfPath = owner ? `/${encodeURIComponent(shelfSlug(owner))}` : '/';

const rows: [string, string | null | undefined][] = record ? [
  ['Artist', v.artist],
  ['Album', v.title],
  ['Released', displayDate(v.released)],
  ['Vinyl release', displayDate(v.vinylRelease)],
  ['Genre', v.genre],
  ['Style', v.style],
  ['Label', v.label],
  ['Format', v.format],
  ['Country', v.country],
  ['Added to collection', formatReleased(record.added.slice(0, 10))],
  ...Object.entries(v).filter(([k]) => k.startsWith('field:')).map(([k, value]) => [k.slice(6), value] as [string, string]),
] : [];
const link = 'text-blue-violet-600 dark:text-blue-violet-400 underline decoration-blue-violet-500/30 hover:decoration-blue-violet-500 underline-offset-4 transition-colors';
---
<Layout title={record ? `${v.title} by ${v.artist} - ARVA` : 'Not found - ARVA'} description={record ? `${v.artist} – ${v.title}${v.released ? ` (${displayDate(v.released)})` : ''}, on ${owner!.name}’s shelf.` : undefined}>
  {!record || !owner ? (
    <div class="max-w-3xl mx-auto px-6 w-full flex-grow py-24">
      <p class="text-zinc-500">This record isn’t on the shelf (any more). <a href={shelfPath} class={link}>Back to the shelf →</a></p>
    </div>
  ) : (
    <article class="max-w-3xl mx-auto px-6 w-full flex-grow py-24">
      <div class="flex items-center justify-between gap-4">
        <a href={shelfPath} class="text-sm text-zinc-500 hover:text-blue-violet-500 dark:hover:text-blue-violet-400 transition-colors">← {owner.name}’s records</a>
        {isOwner && <a href={`${path}/edit`} class="text-sm font-medium text-blue-violet-600 dark:text-blue-violet-400 hover:bg-blue-violet-50 dark:hover:bg-blue-violet-500/15 px-4 py-2 rounded-full transition-colors">Edit</a>}
      </div>
      {isOwner && <p id="sync-progress" class="text-xs text-zinc-500 empty:hidden mt-2" role="status" aria-live="polite"></p>}

      <header class="mt-10 mb-12 border-b border-zinc-200 dark:border-zinc-800 pb-12">
        <RecordHero record={hero!} artist={hero!.artist} title={hero!.title} released={hero!.released} genres={hero!.genres} trackCount={hero!.trackCount} links={hero!.links} />
        <Gallery images={photos} title={hero!.title} />
      </header>

      <dl class="grid grid-cols-1 sm:grid-cols-[11rem_1fr] gap-x-8 gap-y-1 sm:gap-y-3">
        {rows.filter(([, v]) => v).map(([k, v]) => (
          <>
            <dt class="text-sm text-zinc-500 sm:pt-0.5 mt-2 sm:mt-0">{k}</dt>
            <dd class="text-zinc-800 dark:text-zinc-200 whitespace-pre-line break-words">{v}</dd>
          </>
        ))}
      </dl>

      {tracks.length > 0 ? (
        <section class="mt-12">
          <h2 class="text-zinc-500 text-sm mb-2">Tracklist</h2>
          <ol>
            {tracks.map((t) => t.heading ? (
              <li class="pt-5 pb-1 text-xs font-bold tracking-widest uppercase text-zinc-500">{t.title}</li>
            ) : (
              <li class="flex gap-4 py-2.5 border-b border-zinc-100 dark:border-zinc-800/40 last:border-none">
                <span class="w-8 shrink-0 text-sm text-zinc-500 tabular-nums pt-0.5">{t.position}</span>
                <span class="flex-grow min-w-0 text-zinc-800 dark:text-zinc-200">{t.title}</span>
                {t.duration && <span class="text-sm text-zinc-500 tabular-nums pt-0.5">{t.duration}</span>}
                <Listen query={`${v.artist} ${t.title}`} label={`Listen to ${t.title}`} links={t.links} kind="track" />
              </li>
            ))}
          </ol>
        </section>
      ) : (
        <p class="mt-12 text-sm text-zinc-500">The tracklist arrives with the next sync from Discogs.</p>
      )}

      <p class="mt-8 text-sm text-zinc-500">
        <a href={detail?.uri ?? `https://www.discogs.com/release/${record.releaseId}`} class={link}>View this release on Discogs</a>
        <span class="mx-1">·</span>Data from Discogs.
      </p>

      <hr class="border-zinc-200 dark:border-zinc-800/80 my-10" />

      <section id="comments" class="scroll-mt-24">
        <CommentThread comments={comments} user={user} canDelete={(id) => canDeleteComment(thread, id, user)} error={error} draft={draft}>
          <LoginButton slot="login" href={loginHref(Astro.url, `${Astro.url.origin}${path}#comments`)} />
        </CommentThread>
      </section>
    </article>
  )}
</Layout>

<script>
  // The owner's visit finishes any missing tracklists (see src/music/sync.ts); others skip it quickly.
  import '../../../scripts/comments';
  import { autoSync } from '../../../music/sync';
  const progress = document.getElementById('sync-progress');
  if (progress) autoSync((message) => (progress.textContent = message));

</script>
