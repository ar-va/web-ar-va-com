---
// One record: Discogs details (with the owner's edits), public Discogs fields, tracklist with listening links, comments.
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import RecordHero from '../../../components/music/RecordHero.astro';
import Gallery from '../../../components/music/Gallery.astro';
import LoginButton from '../../../components/LoginButton.astro';
import CommentThread from '../../../components/CommentThread.astro';
import Listen from '../../../components/music/Listen.astro';
import { commentNotices, displayDate, formatReleased, gallery, loginHref, musicPath, recordDefaults, recordValues, runtime, shelfView, textToTracklist, withSideHeadings } from '../../../music/lib';
import { addComment, canDeleteComment, currentUser, deleteComment, editComment, recordData, shelfSlug } from '../../../music/store';
import { notify } from '../../../music/notify';

const instanceId = Number(Astro.params.record);
const [user, { owner, record, overrides, detail, match, comments }] = await Promise.all([
  currentUser(Astro.cookies),
  recordData(Astro.params.user!, Number.isSafeInteger(instanceId) ? instanceId : 0),
]);
const path = musicPath(Astro.url);
const thread = { shelfId: owner?.id ?? 0, instanceId };

let error: string | null = null;
let draft = '';
if (owner && record && Astro.request.method === 'POST') {
  if (!user) return Astro.redirect(loginHref(Astro.url), 303);
  const form = await Astro.request.formData();
  const action = form.get('action');
  const id = Number(form.get('id'));
  if (action === 'delete') {
    await deleteComment(thread, id, user);
    return Astro.redirect(`${path}#comments`, 303);
  }
  if (action === 'edit') {
    error = await editComment(thread, id, user, String(form.get('body') ?? ''));
    if (!error) return Astro.redirect(`${path}#comment-${id}`, 303);
  } else {
    draft = String(form.get('body') ?? '');
    const saved = await addComment(thread, user, draft, Number(form.get('parent_id')) || null);
    if ('error' in saved) {
      error = saved.error;
    } else {
      const title = overrides.title ?? record.title;
      Astro.locals.cfContext.waitUntil(notify(commentNotices({
        authorId: user.id, authorName: user.name, ownerId: owner.id, parentAuthorId: saved.parentAuthorId,
        title, body: draft.trim(), url: `${Astro.url.origin}${path}#comment-${saved.id}`,
      })));
      return Astro.redirect(`${path}#comment-${saved.id}`, 303);
    }
  }
}

if (!owner || !record) Astro.response.status = 404;
const v = record ? recordValues(recordDefaults(record, detail, match), overrides) : {};
const tracks = record ? withSideHeadings(textToTracklist(v.tracklist)) : [];
const totalTime = runtime(tracks);
const hero = record ? shelfView(record, detail, overrides, match) : null;
const photos = record ? gallery(hero!.cover, record.cover, detail?.images) : [];
const isOwner = !!user && user.id === owner?.id;

const shelfPath = owner ? `/${encodeURIComponent(shelfSlug(owner))}` : '/';

const rows: [string, string | null | undefined][] = record ? [
  ['Artist', v.artist],
  ['Album', v.title],
  ['Released', displayDate(v.released)],
  ['Vinyl release', displayDate(v.vinylRelease)],
  ['Genre', v.genre],
  ['Style', v.style],
  ['Label', v.label],
  ['Format', v.format],
  ['Country', v.country],
  ['Added to collection', formatReleased(record.added.slice(0, 10))],
  ...Object.entries(v).filter(([k]) => k.startsWith('field:')).map(([k, value]) => [k.slice(6), value] as [string, string]),
] : [];
const link = 'text-blue-violet-600 dark:text-blue-violet-400 underline decoration-blue-violet-500/30 hover:decoration-blue-violet-500 underline-offset-4 transition-colors';
---
<Layout title={record ? `${v.title} by ${v.artist} - ARVA` : 'Not found - ARVA'} description={record ? `${v.artist} – ${v.title}${v.released ? ` (${displayDate(v.released)})` : ''}, on ${owner!.name}’s shelf.` : undefined}>
  {!record || !owner ? (
    <div class="max-w-5xl mx-auto px-6 w-full flex-grow py-24 *:max-w-3xl">
      <p class="text-zinc-500">This record isn’t on the shelf (any more). <a href={shelfPath} class={link}>Back to the shelf →</a></p>
    </div>
  ) : (
    <article class="max-w-5xl mx-auto px-6 w-full flex-grow py-24 *:max-w-3xl">
      <!-- The top row and the hero use the whole frame; details, tracklist and comments keep the reading measure. -->
      <div class="flex items-center justify-between gap-4 !max-w-none">
        <a href={shelfPath} class="text-sm text-zinc-500 hover:text-blue-violet-600 dark:hover:text-blue-violet-400 transition-colors">← {owner.name}’s records</a>
        {isOwner && (
          <a href={`${path}/edit`} class="ctl pl-2.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16.9 4.1a2.1 2.1 0 0 1 3 3L8.5 18.5 4 20l1.5-4.5z" /></svg>
            Edit
          </a>
        )}
      </div>
      {isOwner && <p id="sync-progress" class="text-xs text-zinc-500 empty:hidden mt-2" role="status" aria-live="polite"></p>}

      <header class="mt-10 mb-14 !max-w-none">
        <RecordHero record={hero!} artist={hero!.artist} title={hero!.title} released={hero!.released} genres={hero!.genres} trackCount={hero!.trackCount} links={hero!.links} runtime={totalTime ?? undefined}>
          <Gallery images={photos} title={hero!.title} />
        </RecordHero>
      </header>

      <!-- The divider under the hero carries the details toggle: label at the left, then the line, all in the line's colour (brighter on
           hover / focus). Native <details>: keyboard and screen readers included. -->
      <details class="group/details !max-w-none">
        <summary class="flex items-center gap-3 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden text-sm text-zinc-200 dark:text-zinc-800 hover:text-zinc-500 dark:hover:text-zinc-500 focus-visible:text-zinc-500 focus-visible:outline-none transition-colors">
          <span class="group-open/details:hidden">Show details</span><span class="hidden group-open/details:inline">Hide details</span>
          <svg class="w-3.5 h-3.5 transition-transform group-open/details:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" /></svg>
          <span class="h-px flex-1 bg-current" aria-hidden="true"></span>
        </summary>
        <dl class="mt-8 grid grid-cols-2 sm:grid-cols-3 gap-x-8 gap-y-6">
          {rows.filter(([, v]) => v).map(([k, v]) => (
            <div class="min-w-0">
              <dt class="text-sm text-zinc-500">{k}</dt>
              <dd class="mt-1 text-zinc-800 dark:text-zinc-200 whitespace-pre-line break-words">{v}</dd>
            </div>
          ))}
        </dl>
      </details>

      {tracks.length > 0 ? (
        <section class="mt-14">
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-white">Tracklist</h2>
          <!-- Rows light up on hover; their listening icons show on hover or focus (always on touch screens). -->
          <ol class="mt-4 -mx-3">
            {tracks.map((t) => t.heading ? (
              <li class="px-3 pt-6 pb-2 first:pt-1 text-xs font-bold tracking-widest uppercase">{t.title}</li>
            ) : (
              <li class="group flex items-center gap-4 px-3 py-2.5 rounded-xl hover:bg-zinc-100 dark:hover:bg-white/[0.04] focus-within:bg-zinc-100 dark:focus-within:bg-white/[0.04] transition-colors">
                <span class="w-7 shrink-0 font-mono text-sm text-zinc-500 tabular-nums">{t.position}</span>
                <span class="flex-grow min-w-0 text-zinc-800 dark:text-zinc-200">{t.title}</span>
                <span class="sm:opacity-0 sm:group-hover:opacity-100 sm:group-focus-within:opacity-100 transition-opacity">
                  <Listen query={`${v.artist} ${t.title}`} label={`Listen to ${t.title}`} links={t.links} kind="track" />
                </span>
                {t.duration && <span class="w-12 shrink-0 text-right font-mono text-sm text-zinc-500 tabular-nums">{t.duration}</span>}
              </li>
            ))}
          </ol>
        </section>
      ) : (
        <p class="mt-12 text-sm text-zinc-500">The tracklist arrives with the next sync from Discogs.</p>
      )}

      <p class="mt-8 text-sm text-zinc-500">
        <a href={detail?.uri ?? `https://www.discogs.com/release/${record.releaseId}`} class={link}>View this release on Discogs</a>
        <span class="mx-1">·</span>Data from Discogs.
      </p>

      <hr class="border-zinc-200 dark:border-zinc-800/80 my-10" />

      <section id="comments">
        <CommentThread comments={comments} user={user} canDelete={(id) => canDeleteComment(thread, id, user)} error={error} draft={draft}>
          <LoginButton slot="login" href={loginHref(Astro.url, `${Astro.url.origin}${path}#comments`)} />
        </CommentThread>
      </section>
    </article>
  )}
</Layout>

<script>
  // The owner's visit finishes any missing tracklists (see src/music/sync.ts); others skip it quickly.
  import '../../../scripts/comments';
  import { autoSync } from '../../../music/sync';
  const progress = document.getElementById('sync-progress');
  if (progress) autoSync((message) => (progress.textContent = message));

</script>
