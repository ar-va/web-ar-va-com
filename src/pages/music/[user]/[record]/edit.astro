---
// The owner's edit form for one record. Discogs' values stay underneath: each edited field shows the Discogs value
// (to the owner only) with a Revert button. An empty field means "use Discogs".
export const prerender = false;
import Layout from '../../../../layouts/Layout.astro';
import { loginHref, musicPath, recordDefaults, safeCoverUrl, safeStreamingUrl, type Overrides } from '../../../../music/lib';
import { cachedRelease } from '../../../../music/discogs';
import { currentUser, recordOverrides, releaseMatch, saveOverrides, shelfOwner, shelfRecord } from '../../../../music/store';

const instanceId = Number(Astro.params.record);
const [user, owner] = await Promise.all([currentUser(Astro.cookies), shelfOwner(Astro.params.user!)]);
const recordPath = musicPath(Astro.url).replace(/\/edit$/, '');
if (!user) return Astro.redirect(loginHref(Astro.url));
const record = owner && user.id === owner.id && Number.isSafeInteger(instanceId) ? await shelfRecord(owner.id, instanceId) : null;
if (!record) return Astro.redirect(recordPath);

const [detail, match] = await Promise.all([cachedRelease(record.releaseId), releaseMatch(record.releaseId)]);
const defaults = recordDefaults(record, detail, match);
let overrides: Overrides = await recordOverrides(owner!.id, instanceId);
const errors: Record<string, string> = {};
const links = { spotify: 'Spotify', apple: 'Apple Music', youtube: 'YouTube Music' } as const;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const revert = String(form.get('revert') ?? '');
  const next: Overrides = {};
  if (revert !== '*') {
    for (const key of Object.keys(defaults)) {
      const value = String(form.get(key) ?? '').replace(/\r\n/g, '\n').trim().slice(0, 5000);
      if (!value || value === defaults[key] || key === revert) continue;
      if (key === 'cover' && !safeCoverUrl(value)) continue;
      if (key in links && !safeStreamingUrl(value, key as keyof typeof links)) {
        errors[key] = `Paste a link from ${links[key as keyof typeof links]} (https://…).`;
        continue;
      }
      next[key] = value;
    }
  }
  if (Object.keys(errors).length === 0) {
    await saveOverrides(owner!.id, instanceId, next);
    return Astro.redirect(`${recordPath}/edit?saved`, 303);
  }
  overrides = next;
}

const values = { ...defaults, ...overrides };
// Cover choices: Discogs' photo (the default), Apple Music's official artwork (suggested), then Discogs' other photos.
const appleArt = match?.apple?.artwork ?? null;
const covers = [...new Map([
  ...(defaults.cover ? [[defaults.cover, 'Discogs photo']] : []),
  ...(appleArt ? [[appleArt, 'Apple Music artwork']] : []),
  ...(detail?.images ?? []).slice(1).map((src, i) => [src, `Discogs photo ${i + 2}`]),
] as [string, string][])];
const fields: { key: string; label: string; hint?: string; multiline?: boolean }[] = [
  { key: 'artist', label: 'Artist' },
  { key: 'title', label: 'Album' },
  { key: 'released', label: 'Released', hint: 'When the album first came out. A date like 2016-01-08 is shown as “January 8, 2016”; anything else as typed.' },
  { key: 'vinylRelease', label: 'Vinyl release', hint: 'When this pressing came out.' },
  { key: 'genre', label: 'Genre', hint: 'Comma-separated; used by the Genres filter on the shelf.' },
  { key: 'style', label: 'Style' },
  { key: 'label', label: 'Label' },
  { key: 'format', label: 'Format' },
  { key: 'country', label: 'Country' },
  ...Object.keys(defaults).filter((k) => k.startsWith('field:')).map((k) => ({ key: k, label: k.slice(6), hint: 'One of your Discogs collection fields.', multiline: defaults[k].length > 60 })),
  { key: 'tracklist', label: 'Tracklist', hint: 'Position, title, length and, under “Links”, the track on each service. Positions like A1, B1 are shown as Side A, Side B.', multiline: true },
  ...Object.entries(links).map(([key, name]) => ({ key, label: `${name} link`, hint: defaults[key] ? `Found automatically. Paste another ${name} album link if it’s the wrong one.` : `The album on ${name}. Empty: the ${name} icon searches for it.` })),
];
const input = 'w-full rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#1a1a1a] px-4 py-2.5 text-zinc-900 dark:text-white focus:outline-none focus:border-blue-violet-500 transition-colors';
const edited = Object.keys(overrides).length;
const dated = new Set(['released', 'vinylRelease']);
---
<Layout title={`Edit ${values.title} - ARVA`}>
  <div class="max-w-3xl mx-auto px-6 w-full flex-grow py-24">
    <a href={recordPath} class="text-sm text-zinc-500 hover:text-blue-violet-500 dark:hover:text-blue-violet-400 transition-colors">← Back to the record</a>
    <h1 class="mt-6 text-2xl font-bold text-zinc-900 dark:text-white">Edit {values.title}<span class="text-blue-violet-500">.</span></h1>
    <p class="mt-2 mb-8 text-sm text-zinc-600 dark:text-zinc-400 max-w-xl">Everything starts from Discogs and the automatic Apple Music / Spotify matches. What you change here is what visitors see; the default stays underneath (only you see it) so you can go back any time.</p>

    {Astro.url.searchParams.has('saved') && Object.keys(errors).length === 0 && (
      <p class="mb-6 rounded-xl border border-blue-violet-200 dark:border-blue-violet-900 bg-blue-violet-50 dark:bg-blue-violet-500/10 px-4 py-3 text-sm text-zinc-700 dark:text-zinc-300" role="status">Saved. <a href={recordPath} class="underline underline-offset-4">See the record →</a></p>
    )}

    <form method="post" class="flex flex-col gap-6">
      <!-- Enter in a field submits with the form's first button: make that Save, not a Revert. -->
      <button class="sr-only" tabindex="-1" aria-hidden="true">Save</button>

      {covers.length > 1 && (
        <fieldset>
          <legend class="flex items-center gap-2 text-sm font-medium text-zinc-800 dark:text-zinc-200 mb-2">
            Cover
            {'cover' in overrides && <span class="text-[10px] font-bold tracking-widest uppercase text-blue-violet-600 dark:text-blue-violet-400">Edited</span>}
          </legend>
          <div class="flex flex-wrap gap-3">
            {covers.map(([src, label]) => (
              <label class="group cursor-pointer w-28">
                <input type="radio" name="cover" value={src} checked={values.cover === src} class="sr-only peer" />
                <img src={src} alt="" width="112" height="112" loading="lazy" referrerpolicy="no-referrer"
                  class="w-28 h-28 object-cover rounded-lg border-2 border-transparent peer-checked:border-blue-violet-500 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-blue-violet-500 group-hover:opacity-90" />
                <span class="mt-1 block text-xs text-zinc-500 peer-checked:text-blue-violet-600 dark:peer-checked:text-blue-violet-400">
                  {label}{src === appleArt && src !== values.cover && <span class="block text-blue-violet-600 dark:text-blue-violet-400">Suggested</span>}
                </span>
              </label>
            ))}
          </div>
          <div class="mt-1.5 flex items-start justify-between gap-4 text-xs text-zinc-500">
            <span>The main cover on the shelf and the record page; the others appear in its photo gallery.</span>
            {'cover' in overrides && <button name="revert" value="cover" class="shrink-0 font-medium text-blue-violet-600 dark:text-blue-violet-400 hover:underline underline-offset-4">Revert</button>}
          </div>
        </fieldset>
      )}
      {fields.map((f) => {
        const changed = f.key in overrides;
        const original = defaults[f.key];
        return (
          <div>
            <label for={`f-${f.key}`} class="flex items-center gap-2 text-sm font-medium text-zinc-800 dark:text-zinc-200 mb-1.5">
              {f.label}
              {changed && <span class="text-[10px] font-bold tracking-widest uppercase text-blue-violet-600 dark:text-blue-violet-400">Edited</span>}
            </label>
            {f.multiline
              ? <textarea id={`f-${f.key}`} name={f.key} rows={f.key === 'tracklist' ? Math.min(24, Math.max(6, values[f.key].split('\n').length + 1)) : 4} class={`${input} font-normal leading-relaxed ${f.key === 'tracklist' ? 'font-mono text-sm' : ''}`}>{values[f.key]}</textarea>
              : dated.has(f.key)
                ? (
                  <div class="flex gap-2">
                    <input id={`f-${f.key}`} name={f.key} value={values[f.key]} class={input} placeholder="YYYY-MM-DD, or just a year" />
                    <!-- A calendar for picking the date; typing stays possible (a year alone, "around 1975"). -->
                    <label class="relative shrink-0 grid place-items-center w-11 rounded-xl border border-zinc-200 dark:border-zinc-800 text-zinc-500 hover:text-blue-violet-500 hover:border-blue-violet-500 transition-colors cursor-pointer" title="Pick a date">
                      <svg class="w-5 h-5 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="2" /><path d="M3.5 9.5h17M8 3v4M16 3v4" stroke-linecap="round" /></svg>
                      <input type="date" data-date-for={`f-${f.key}`} class="absolute inset-0 opacity-0 cursor-pointer" aria-label={`Pick the ${f.label.toLowerCase()} date`}
                        value={/^\d{4}-\d{2}-\d{2}$/.test(values[f.key]) ? values[f.key] : undefined} />
                    </label>
                  </div>
                )
                : <input id={`f-${f.key}`} name={f.key} value={values[f.key]} class={input} inputmode={f.key in links ? 'url' : undefined} aria-invalid={errors[f.key] ? 'true' : undefined} />}
            {f.key === 'tracklist' && <div id="track-editor" class="hidden flex-col gap-2"></div>}
            {errors[f.key] && <p class="mt-1.5 text-sm text-red-600 dark:text-red-400" role="alert">{errors[f.key]}</p>}
            {changed ? (
              <div class="mt-1.5 flex items-start justify-between gap-4 text-xs text-zinc-500">
                <span class="min-w-0 whitespace-pre-line break-words line-clamp-4">Default: {original || '(empty)'}</span>
                <button name="revert" value={f.key} class="shrink-0 font-medium text-blue-violet-600 dark:text-blue-violet-400 hover:underline underline-offset-4">Revert</button>
              </div>
            ) : (
              f.hint && <p class="mt-1.5 text-xs text-zinc-500">{f.hint}</p>
            )}
          </div>
        );
      })}

      <template id="track-row">
        <div class="track rounded-xl border border-zinc-200 dark:border-zinc-800 p-2.5 flex flex-col gap-2">
          <div class="flex items-center gap-2">
            <input data-k="position" aria-label="Position" placeholder="A1" class="w-14 shrink-0 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#1a1a1a] px-2 py-1.5 text-sm text-zinc-900 dark:text-white focus:outline-none focus:border-blue-violet-500" />
            <input data-k="title" aria-label="Title" placeholder="Title" class="min-w-0 flex-grow rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#1a1a1a] px-2.5 py-1.5 text-sm text-zinc-900 dark:text-white focus:outline-none focus:border-blue-violet-500" />
            <input data-k="duration" aria-label="Length" placeholder="4:52" class="w-16 shrink-0 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#1a1a1a] px-2 py-1.5 text-sm tabular-nums text-zinc-900 dark:text-white focus:outline-none focus:border-blue-violet-500" />
            <button type="button" data-act="links" class="shrink-0 text-xs font-medium text-blue-violet-600 dark:text-blue-violet-400 hover:underline underline-offset-4 px-1">Links</button>
            <button type="button" data-act="remove" aria-label="Remove this line" class="shrink-0 w-7 h-7 grid place-items-center rounded-full text-zinc-400 hover:text-red-600 dark:hover:text-red-400">×</button>
          </div>
          <div data-links class="hidden grid-cols-1 sm:grid-cols-3 gap-2">
            <input data-k="spotify" type="url" aria-label="Spotify link" placeholder="Spotify link" class="rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#1a1a1a] px-2.5 py-1.5 text-xs text-zinc-900 dark:text-white focus:outline-none focus:border-blue-violet-500" />
            <input data-k="apple" type="url" aria-label="Apple Music link" placeholder="Apple Music link" class="rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#1a1a1a] px-2.5 py-1.5 text-xs text-zinc-900 dark:text-white focus:outline-none focus:border-blue-violet-500" />
            <input data-k="youtube" type="url" aria-label="YouTube Music link" placeholder="YouTube Music link" class="rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#1a1a1a] px-2.5 py-1.5 text-xs text-zinc-900 dark:text-white focus:outline-none focus:border-blue-violet-500" />
          </div>
        </div>
      </template>

      <div class="flex flex-wrap items-center gap-3 pt-4 border-t border-zinc-200 dark:border-zinc-800">
        <button class="bg-blue-violet-500 text-white text-sm font-medium px-6 py-2.5 rounded-full hover:bg-blue-violet-600 transition-colors">Save</button>
        {edited > 0 && <button name="revert" value="*" class="text-sm font-medium text-zinc-600 dark:text-zinc-300 hover:text-red-600 dark:hover:text-red-400 px-4 py-2 rounded-full transition-colors" onclick="return confirm('Undo all your edits to this record and use Discogs’ data again?')">Revert all ({edited})</button>}
        <a href={recordPath} class="text-sm text-zinc-500 hover:text-zinc-900 dark:hover:text-white px-2 transition-colors">Cancel</a>
      </div>
    </form>
  </div>
</Layout>

<script>
  import { textToTracklist, tracklistToText, type Track } from '../../../../music/lib';

  // Calendar buttons fill the text field next to them.
  document.querySelectorAll<HTMLInputElement>('input[data-date-for]').forEach((picker) => picker.addEventListener('change', () => {
    if (picker.value) (document.getElementById(picker.dataset.dateFor!) as HTMLInputElement).value = picker.value;
  }));

  // Row-by-row tracklist editor; the textarea underneath stays what the form sends (and the fallback without JS).
  const area = document.getElementById('f-tracklist') as HTMLTextAreaElement | null;
  const editor = document.getElementById('track-editor');
  const template = document.getElementById('track-row') as HTMLTemplateElement | null;
  if (area && editor && template) {
    const services = ['spotify', 'apple', 'youtube'] as const;
    const read = (row: HTMLElement) => {
      const get = (k: string) => (row.querySelector<HTMLInputElement>(`[data-k="${k}"]`)?.value ?? '').trim();
      if (row.dataset.heading) return { position: '', title: get('title'), duration: '', heading: true } as Track;
      const links = Object.fromEntries(services.map((s) => [s, get(s)]).filter(([, v]) => v));
      return { position: get('position'), title: get('title'), duration: get('duration'), heading: false, ...(Object.keys(links).length && { links }) } as Track;
    };
    const save = () => {
      area.value = tracklistToText([...editor.querySelectorAll<HTMLElement>('.track')].map(read).filter((t) => t.title));
    };
    const add = (t: Track, before?: Element | null) => {
      const row = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const set = (k: string, v = '') => { const el = row.querySelector<HTMLInputElement>(`[data-k="${k}"]`); if (el) el.value = v; };
      set('title', t.title);
      if (t.heading) {
        row.dataset.heading = '1';
        row.querySelectorAll('[data-k="position"], [data-k="duration"], [data-act="links"], [data-links]').forEach((el) => el.remove());
        row.querySelector('[data-k="title"]')!.setAttribute('placeholder', 'Heading, e.g. Side B');
        row.classList.add('bg-zinc-50', 'dark:bg-white/[0.03]');
      } else {
        set('position', t.position);
        set('duration', t.duration);
        services.forEach((s) => set(s, t.links?.[s]));
        const linkCount = services.filter((s) => t.links?.[s]).length;
        if (linkCount) row.querySelector('[data-act="links"]')!.textContent = `Links (${linkCount})`;
      }
      editor.insertBefore(row, before ?? null);
      return row;
    };
    textToTracklist(area.value).forEach((t) => add(t));

    const actions = document.createElement('div');
    actions.className = 'flex gap-4 text-sm';
    actions.innerHTML = '<button type="button" data-add="track" class="font-medium text-blue-violet-600 dark:text-blue-violet-400 hover:underline underline-offset-4">+ Add track</button><button type="button" data-add="heading" class="text-zinc-500 hover:text-zinc-900 dark:hover:text-white">+ Add heading</button>';
    editor.append(actions);
    actions.addEventListener('click', (e) => {
      const kind = (e.target as HTMLElement).closest<HTMLElement>('[data-add]')?.dataset.add;
      if (!kind) return;
      add({ position: '', title: '', duration: '', heading: kind === 'heading' }, actions).querySelector<HTMLInputElement>('[data-k="title"], [data-k="position"]')?.focus();
    });
    editor.addEventListener('input', save);
    editor.addEventListener('click', (e) => {
      const button = (e.target as HTMLElement).closest<HTMLElement>('[data-act]');
      const row = button?.closest<HTMLElement>('.track');
      if (!button || !row) return;
      if (button.dataset.act === 'remove') { row.remove(); save(); }
      if (button.dataset.act === 'links') { const l = row.querySelector('[data-links]')!; l.classList.toggle('hidden'); l.classList.toggle('grid'); }
    });

    area.classList.add('hidden');
    editor.classList.replace('hidden', 'flex');
  }
</script>
