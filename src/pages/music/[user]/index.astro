---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import Shelf from '../../../components/music/Shelf.astro';
import { listShelves, shelfOverrides, shelfOwner, shelfRecords, shelfReleases } from '../../../music/store';
import { shelfView } from '../../../music/lib';

const [owner, shelves] = await Promise.all([shelfOwner(Astro.params.user!), listShelves()]);
const [raw, overrides, releases] = owner ? await Promise.all([shelfRecords(owner.id), shelfOverrides(owner.id), shelfReleases(owner.id)]) : [[], new Map(), new Map()];
const records = raw.map((r) => shelfView(r, releases.get(r.releaseId) ?? null, overrides.get(r.instanceId) ?? {}));
if (!owner) Astro.response.status = 404;
---
<Layout title={owner ? `${owner.name}’s records - ARVA` : 'Not found - ARVA'} description={owner ? `${records.length} vinyl records on ${owner.name}’s shelf.` : undefined}>
  <div class="max-w-6xl mx-auto px-6 w-full flex-grow py-24">
    {owner ? (
      <Shelf owner={{ name: owner.name, discogs_username: owner.discogs_username! }} records={records} shelves={shelves} />
    ) : (
      <p class="text-zinc-500">There’s no shelf here. <a href="/" class="text-blue-violet-600 dark:text-blue-violet-400 underline underline-offset-4">See all records →</a></p>
    )}
  </div>
</Layout>
