---
// music.ar-va.com/ shows the admin's shelf; until that is connected, a list of shelves.
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import ShelfPage from '../../components/music/ShelfPage.astro';
import { shelfData, shelfSlug } from '../../music/store';

const data = await shelfData(null);
const { shelves } = data;
---
{data.owner ? <ShelfPage {...data} /> : (
<Layout title="Music - ARVA">
  <div class="max-w-5xl mx-auto px-6 w-full flex-grow pt-12 pb-24 *:max-w-3xl">
    <h1 class="text-2xl font-bold text-zinc-900 dark:text-white mb-4">Records</h1>
    {shelves.length === 0 ? (
      <p class="text-zinc-500">No shelves yet.</p>
    ) : (
      <ul class="leading-8">
        {shelves.map((s) => <li><a href={`/${encodeURIComponent(shelfSlug(s))}`} class="text-zinc-700 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white underline decoration-zinc-300 dark:decoration-zinc-700 underline-offset-4">{s.name}</a> <span class="text-zinc-500">({s.count})</span></li>)}
      </ul>
    )}
  </div>
</Layout>
)}
