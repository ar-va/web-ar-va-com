---
// music.ar-va.com/: every collector's shelf, most recently added to first. Each row is a small shelf of their latest
// records (five, three on phones) that opens their whole shelf.
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import Cover from '../../components/music/Cover.astro';
import { directory, shelfSlug } from '../../music/store';

const shelves = await directory();
const total = shelves.reduce((n, s) => n + s.count, 0);
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
---
<Layout title="Record shelves - ARVA" description={`${plural(shelves.length, 'collector')} and ${plural(total, 'vinyl record')} on music.ar-va.com.`}>
  <div class="max-w-5xl mx-auto px-6 w-full flex-grow pt-12 pb-24">
    <h1 class="text-3xl font-bold text-zinc-900 dark:text-white">Record shelves</h1>
    <p class="mt-3 text-zinc-500">{plural(shelves.length, 'collector')} · {plural(total, 'record')}</p>

    {shelves.length === 0 ? (
      <p class="mt-10 text-zinc-500">No shelves yet.</p>
    ) : shelves.map((s) => {
      const href = `/${encodeURIComponent(shelfSlug(s))}`;
      return (
        <section class="mt-12" aria-labelledby={`shelf-${s.id}`}>
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h2 id={`shelf-${s.id}`} class="text-xl font-bold text-zinc-900 dark:text-white">
              <a href={href} class="hover:text-blue-violet-600 dark:hover:text-blue-violet-400 transition-colors">{s.name}’s records</a>
            </h2>
            <a href={href} class="text-sm text-zinc-500 hover:text-blue-violet-600 dark:hover:text-blue-violet-400 transition-colors" aria-label={`Open ${s.name}’s shelf: ${plural(s.count, 'record')}`}>
              {plural(s.count, 'record')} →
            </a>
          </div>
          <!-- The covers open the shelf too (mouse and touch; keyboards use the heading's link). -->
          <ul class="shelf !grid-cols-3 sm:!grid-cols-5 !gap-y-0 !pt-12" role="list">
            {s.records.map((r, i) => (
              <li class:list={['shelf-slot', { 'max-sm:hidden': i >= 3 }]}>
                <a href={href} tabindex="-1" aria-hidden="true" class="shelf-record block" title={`${r.artist} – ${r.title}`}>
                  <Cover record={r} eager={i < 5} />
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })}

    <p class="mt-16 text-sm text-zinc-500">Shelves here are by invitation: every collector can invite someone from their settings.</p>
  </div>
</Layout>

<script>
  import { notesOnHover } from '../../scripts/notes';
  notesOnHover('.shelf .shelf-record');
</script>
