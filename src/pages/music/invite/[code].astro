---
// An invite link from a collector, built like a chat-app invite: who invites you, a peek at their shelf and at
// everyone already here, one big button, and below it what you get and why it's safe. Accepting makes you a
// collector (the link's own expiry and number of uses, set by its creator). Logged out, the button goes through Telegram and comes back with ?accept, which
// accepts right away; logged in, it's a form POST.
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Cover from '../../../components/music/Cover.astro';
import { acceptInvite, canCollect, currentUser, directory, inviteDetails, rememberInvite, shelfSlug } from '../../../music/store';
import { env } from 'cloudflare:workers';
import { loginHref, musicPath, siteDomain, telegramAuthUrl, timeLeft } from '../../../music/lib';

const code = Astro.params.code!;
const user = await currentUser(Astro.cookies);
if (user && canCollect(user)) return Astro.redirect(Astro.url.searchParams.has('accept') ? '/settings?welcome' : '/settings');
if (user && (Astro.request.method === 'POST' || Astro.url.searchParams.has('accept')) && (await acceptInvite(code, user))) {
  return Astro.redirect('/settings?welcome', 303);
}
const [invite, shelves] = await Promise.all([inviteDetails(code), directory(4)]);
if (invite && !user) rememberInvite(Astro.cookies, code, Astro.url.hostname);

const first = (name: string) => name.split(' ')[0];
const theirs = invite ? shelves.find((s) => s.id === invite.id) : undefined;
const others = shelves.filter((s) => s.id !== invite?.id);
const records = shelves.reduce((n, s) => n + s.count, 0);
// The link's terms, Discord-style: when it runs out, and whether it's nearly used up.
const terms = invite ? [invite.expires_at ? `Expires in ${timeLeft(invite.expires_at)}` : 'Never expires',
  invite.uses_left === 1 ? 'works once more' : invite.uses_left ? `${invite.uses_left} uses left` : null].filter(Boolean).join(' · ') : '';
const back = `${Astro.url.origin}${musicPath(Astro.url)}?accept`;
// Accepting logs in with Telegram's window over this page (its button can't sit on music.ar-va.com), then comes back
// to accept: the login page is only the fallback when the window is blocked.
const botId = env.TELEGRAM_BOT_TOKEN?.split(':')[0];
const tgAuth = botId ? telegramAuthUrl(botId, `${Astro.url.protocol}//${siteDomain(Astro.url.host)}`, back) : undefined;
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;

const perks = [
  { icon: 'M4 6h16M4 12h16M4 18h10', title: 'Your own shelf', text: 'A page at music.ar-va.com/your-name with every record: cover, tracklist, release dates and one-tap links to Spotify, Apple Music and YouTube Music.' },
  { icon: 'M4 4v6h6M20 20v-6h-6M5.5 15a7 7 0 0 0 12.4 2M18.5 9A7 7 0 0 0 6.1 7', title: 'Always up to date', text: 'Add a record on Discogs (the app scans barcodes) and it appears on your shelf. Nothing to type twice.' },
  { icon: 'M7.5 8.5h9M7.5 12.5h6M5 19.5V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H8z', title: 'Friends talk records', text: 'Comments and replies on your shelf and on each record. Telegram tells you when someone writes.' },
];
const safety = [
  { title: 'Telegram login', text: 'No password, no email, no new account. The site receives your name, @username and photo, never your phone number, contacts or chats.' },
  { title: 'Discogs, read only', text: 'The site only reads your collection to show it; nothing on Discogs is ever changed. Disconnect any time in settings.' },
];
const ring = (width: string) => `rounded-full ${width} ring-white dark:ring-night-surface`;
const initial = 'grid place-items-center bg-(--on-bg) text-(--on-text) font-semibold';
---
<Layout title={invite ? `${invite.name} invited you - ARVA` : 'Invitation - ARVA'}
  description={invite ? `${invite.name} invited you to put your record collection on music.ar-va.com.` : undefined}>
  <div class="max-w-5xl mx-auto px-6 w-full flex-grow pt-12 pb-24">
    <Breadcrumbs class="mb-8" items={[{ label: 'Shelves', href: '/' }, { label: 'Invitation' }]} />

    {invite ? (
      <div class="mx-auto max-w-lg">
        <!-- The invite card -->
        <section class="rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-night-surface px-6 pt-8 pb-7 sm:px-9 text-center shadow-sm dark:shadow-none" aria-labelledby="invite-title">
          <div class="flex justify-center">
            {invite.photo_url?.startsWith('https://')
              ? <img src={invite.photo_url} alt="" width="72" height="72" referrerpolicy="no-referrer" class={`w-18 h-18 object-cover ${ring('ring-4')}`} />
              : <span aria-hidden="true" class={`w-18 h-18 text-2xl ${initial} ${ring('ring-4')}`}>{invite.name.slice(0, 1)}</span>}
          </div>
          <p class="mt-4 text-sm text-zinc-500"><span class="font-medium text-zinc-800 dark:text-zinc-200">{invite.name}</span> invited you</p>
          <h1 id="invite-title" class="mt-1 text-2xl sm:text-3xl font-bold leading-tight text-zinc-900 dark:text-white">Your records are missing from the shelf</h1>
          <p class="mt-3 text-zinc-600 dark:text-zinc-400">Put your collection next to {first(invite.name)}’s{others.length > 0 && ` and ${plural(others.length, 'other collector')}’s`} on music.ar-va.com.</p>

          {theirs && theirs.records.length > 0 && (
            <a href={`/${encodeURIComponent(shelfSlug(theirs))}`} class="group/peek mt-6 block rounded-2xl bg-zinc-100/70 dark:bg-white/[0.04] px-4 pt-1 pb-3 text-left hover:bg-zinc-100 dark:hover:bg-white/[0.06] transition-colors">
              <ul class="shelf !grid-cols-4 !gap-y-0 !pt-8 !px-0" role="list" aria-hidden="true">
                {theirs.records.map((r) => <li class="shelf-slot"><span class="shelf-record block"><Cover record={r} /></span></li>)}
              </ul>
              <span class="mt-3 flex items-center justify-between text-sm text-zinc-500">
                <span>{first(invite.name)}’s shelf · {plural(theirs.count, 'record')}</span>
                <span class="text-blue-violet-600 dark:text-blue-violet-400 group-hover/peek:translate-x-0.5 transition-transform" aria-hidden="true">→</span>
              </span>
            </a>
          )}

          <!-- Everyone already here: a row of faces and the totals. -->
          <div class="mt-6 flex items-center justify-center gap-3">
            <span class="flex -space-x-2.5" aria-hidden="true">
              {shelves.slice(0, 5).map((s) => s.photo_url?.startsWith('https://')
                ? <img src={s.photo_url} alt="" width="32" height="32" referrerpolicy="no-referrer" class={`w-8 h-8 object-cover ${ring('ring-2')}`} />
                : <span class={`w-8 h-8 text-xs ${initial} ${ring('ring-2')}`}>{s.name.slice(0, 1)}</span>)}
            </span>
            <span class="text-sm text-zinc-500">{plural(shelves.length, 'collector')} · {plural(records, 'record')} shared</span>
          </div>

          {user ? (
            <form method="post" class="mt-7">
              <button class="w-full h-12 rounded-full text-base font-semibold bg-blue-violet-600 dark:bg-blue-violet-400 text-white dark:text-zinc-950 hover:bg-blue-violet-700 dark:hover:bg-blue-violet-300 transition-colors">Accept invite</button>
            </form>
          ) : (
            <>
            <a href={loginHref(Astro.url, back)} data-tg-auth={tgAuth} data-tg-next={back} class="mt-7 w-full h-12 inline-flex items-center justify-center gap-2.5 rounded-full text-base font-semibold bg-[#2aabee] text-white hover:bg-[#229ed9] transition-colors">
              <svg class="w-5 h-5" viewBox="0 0 48 48" fill="currentColor" aria-hidden="true"><path d="M41.4193 7.30899C41.4193 7.30899 45.3046 5.79399 44.9808 9.47328C44.8729 10.9883 43.9016 16.2908 43.1461 22.0262L40.5559 39.0159C40.5559 39.0159 40.3401 41.5048 38.3974 41.9377C36.4547 42.3705 33.5408 40.4227 33.0011 39.9898C32.5694 39.6652 24.9068 34.7955 22.2086 32.4148C21.4531 31.7655 20.5897 30.4669 22.3165 28.9519L33.6487 18.1305C34.9438 16.8319 36.2389 13.8019 30.8426 17.4812L15.7331 27.7616C15.7331 27.7616 14.0063 28.8437 10.7686 27.8698L3.75342 25.7055C3.75342 25.7055 1.16321 24.0823 5.58815 22.459C16.3807 17.3729 29.6555 12.1786 41.4193 7.30899Z"/></svg>
              Accept with Telegram
            </a>
            <p data-tg-hint hidden class="mt-3 text-sm text-zinc-600 dark:text-zinc-400">Window closed? <a href={loginHref(Astro.url, back)} class="font-medium text-blue-violet-600 dark:text-blue-violet-400 hover:underline underline-offset-4">Log in on the login page</a> instead, or try the button again.</p>
            </>
          )}
          <p class="mt-3 text-xs text-zinc-500">
            {user ? `You’re logged in as ${user.name}. ` : 'Then connect Discogs and your shelf fills itself. '}
            {terms}
          </p>
        </section>

        <!-- Why it's worth it, and why it's safe -->
        <section class="mt-10" aria-labelledby="perks-title">
          <h2 id="perks-title" class="font-sans text-sm font-medium text-zinc-800 dark:text-zinc-200">What you get</h2>
          <ul class="mt-4 flex flex-col gap-5" role="list">
            {perks.map((p) => (
              <li class="flex gap-4">
                <span class="shrink-0 w-9 h-9 rounded-full grid place-items-center bg-(--on-bg) text-(--on-text)">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={p.icon} /></svg>
                </span>
                <span>
                  <span class="block font-medium text-zinc-900 dark:text-white">{p.title}</span>
                  <span class="block mt-0.5 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">{p.text}</span>
                </span>
              </li>
            ))}
          </ul>
        </section>
        <section class="mt-8 rounded-2xl bg-zinc-100/70 dark:bg-white/[0.04] p-5" aria-labelledby="safe-title">
          <h2 id="safe-title" class="flex items-center gap-2 font-sans text-sm font-medium text-zinc-800 dark:text-zinc-200">
            <svg class="w-4 h-4 text-blue-violet-600 dark:text-blue-violet-400" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z" /><path d="m9 12 2 2 4-4" /></svg>
            Safe by design
          </h2>
          <dl class="mt-3 flex flex-col gap-3 text-sm">
            {safety.map((x) => (
              <div>
                <dt class="font-medium text-zinc-800 dark:text-zinc-200">{x.title}</dt>
                <dd class="mt-0.5 text-zinc-600 dark:text-zinc-400 leading-relaxed">{x.text}</dd>
              </div>
            ))}
          </dl>
        </section>
      </div>
    ) : (
      <section class="mx-auto max-w-lg rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-night-surface px-6 py-10 sm:px-9 text-center">
        <h1 class="text-2xl font-bold text-zinc-900 dark:text-white">This invite is no longer valid</h1>
        <p class="mt-3 text-zinc-600 dark:text-zinc-400">This link has expired, been used up or been switched off by whoever sent it. Ask them for a new one.</p>
        <a href="/" class="mt-6 inline-flex items-center h-10 px-5 rounded-full text-sm font-medium bg-(--well) text-zinc-800 dark:text-zinc-200 hover:bg-(--well-hover) transition-colors">Browse the shelves meanwhile →</a>
      </section>
    )}
  </div>
</Layout>

<script>
  import '../../../scripts/telegram-popup';
</script>
