---
// An invite link from the admin: logging in here makes you a collector.
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import LoginButton from '../../../components/LoginButton.astro';
import { acceptInvite, canCollect, currentUser } from '../../../music/store';
import { loginHref } from '../../../music/lib';

const user = await currentUser(Astro.cookies);
if (user && canCollect(user)) return Astro.redirect('/settings');
if (user && (await acceptInvite(Astro.params.code!, user))) return Astro.redirect('/settings?welcome');
---
<Layout title="Invitation - ARVA">
  <div class="max-w-3xl mx-auto px-6 w-full flex-grow py-24">
    <h1 class="text-2xl font-bold text-zinc-900 dark:text-white mb-2">Your own shelf<span class="text-blue-violet-500">.</span></h1>
    {user ? (
      <p class="text-zinc-600 dark:text-zinc-400 max-w-md">This invitation has been used or has expired. Ask for a new link.</p>
    ) : (
      <>
        <p class="text-zinc-600 dark:text-zinc-400 mb-6 max-w-md">You’ve been invited to show your record collection here. Log in with Telegram, then connect your Discogs account.</p>
        <LoginButton href={loginHref(Astro.url)} />
      </>
    )}
  </div>
</Layout>
