---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import TelegramLogin from '../../components/music/TelegramLogin.astro';
import { safeReturnPath } from '../../music/lib';
import { currentUser } from '../../music/store';

const returnTo = safeReturnPath(Astro.url.searchParams.get('return'));
if (await currentUser(Astro.cookies)) return Astro.redirect(returnTo);
const failed = Astro.url.searchParams.has('failed');
---
<Layout title="Log in - ARVA">
  <div class="max-w-3xl mx-auto px-6 w-full flex-grow py-24">
    <h1 class="text-2xl font-bold text-zinc-900 dark:text-white mb-2">Log in<span class="text-blue-violet-500">.</span></h1>
    <p class="text-zinc-600 dark:text-zinc-400 mb-6 max-w-md">Log in with Telegram to comment on records. Telegram shares your name, username and photo with this site, never your phone number.</p>
    {failed && <p class="text-sm text-red-600 dark:text-red-400 mb-4">That login didn’t work. Please try again.</p>}
    <TelegramLogin returnTo={returnTo} />
  </div>
</Layout>
