---
import Disclosure from '@shared/components/Disclosure.astro';
---
<section aria-labelledby="palette-title" class="space-y-3">
  <h2 id="palette-title" class="text-lg font-bold text-zinc-900 dark:text-white">Palette</h2>
  <div id="palette" class="grid grid-cols-4 gap-x-2 gap-y-3"></div>
  <p id="notes" class="text-xs text-zinc-600 dark:text-zinc-400" hidden></p>
  <Disclosure title="Contrast">
    <Fragment slot="preview"><span id="contrast-summary"></span></Fragment>
    <ul id="contrast-list" class="space-y-1 text-xs"></ul>
  </Disclosure>
</section>
