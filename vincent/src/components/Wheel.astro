---
// The colour wheel. app.ts paints it and places one handle per colour.
---
<div id="wheel" class="v-wheel">
  <canvas id="wheel-canvas" width="280" height="280" aria-hidden="true"></canvas>
  <svg id="wheel-lines" class="v-wheel-line" aria-hidden="true"></svg>
  <div id="wheel-handles"></div>
  <div id="wheel-loupe" class="v-loupe" aria-hidden="true" hidden></div>
</div>
