---
// The isolated page inside the tool's iframe. Every colour on it is a Nextcloud variable, set by the exported CSS.
import FilesView from '../preview/FilesView.astro';
import '../preview/base.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Vincent preview</title>
  </head>
  <body data-theme-light>
    <FilesView />
    <script>
      import '../preview/preview';
    </script>
  </body>
</html>
