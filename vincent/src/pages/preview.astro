---
// The isolated page inside the tool's iframe. Every colour on it is a Nextcloud variable, set by the exported CSS.
import '../preview/base.css';
import AdminView from '../preview/AdminView.astro';
import ComponentsView from '../preview/ComponentsView.astro';
import FilesView from '../preview/FilesView.astro';
import LoginView from '../preview/LoginView.astro';
import ShareView from '../preview/ShareView.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Vincent preview</title>
  </head>
  <body data-theme-light>
    <FilesView />
    <ShareView />
    <LoginView />
    <AdminView />
    <ComponentsView />
    <script>
      import '../preview/preview';
    </script>
  </body>
</html>
