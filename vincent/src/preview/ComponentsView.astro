---
import Icon from './Icon.astro';
import Shell from './Shell.astro';
import './components.css';
import {
  mdiAlertCircleOutline, mdiAlertOutline, mdiCheck, mdiCheckCircleOutline, mdiChevronDown, mdiClose, mdiContentCopy, mdiCreationOutline, mdiDeleteOutline, mdiDownload,
  mdiInformation, mdiInformationOutline, mdiPencil, mdiPlus, mdiShareVariant, mdiStar, mdiStarOutline,
} from './icons';

const kinds = [['Primary', 'btn-primary'], ['Secondary', 'btn-secondary'], ['Tertiary', 'btn-tertiary'], ['Success', 'btn-success'], ['Warning', 'btn-warning'], ['Error', 'btn-error'], ['Info', 'btn-info']];
const states = [['Rest', ''], ['Hover', 'is-hover'], ['Focus', 'is-focus']];
const notes = [['info', mdiInformation, 'A new version is ready to install.'], ['success', mdiCheckCircleOutline, 'Your settings have been saved.'], ['warning', mdiAlertOutline, 'Storage is almost full.'], ['error', mdiAlertCircleOutline, 'The upload could not finish.']];
const toasts = [['info', 'Link copied'], ['success', 'File moved to Archive'], ['warning', 'You are offline'], ['error', 'Could not delete file']];
const people = [['MK', 'Online', 'online'], ['JT', 'Away', 'away'], ['RS', 'Do not disturb', 'busy'], ['AL', 'Offline', 'offline']];
const dark = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cpath d='M12 2 2 22h20z'/%3E%3C/svg%3E";
const light = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cpath fill='%23fff' d='M12 2 2 22h20z'/%3E%3C/svg%3E";
---
<Shell view="components" app="Components">
  <div class="scroller gallery"><div class="gallery-columns">
    <section class="card card-wide">
      <h2>Buttons</h2>
      <div class="button-grid">
        <span></span>{states.map(([s]) => <small>{s}</small>)}<small>Disabled</small>
        {kinds.map(([name, cls]) => <>
          <small>{name}</small>
          {states.map(([, st]) => <button class:list={['btn', cls, st]}><Icon path={mdiPlus} size={18} /> {name}</button>)}
          <button class:list={['btn', cls]} disabled><Icon path={mdiPlus} size={18} /> {name}</button>
        </>)}
      </div>
    </section>

    <section class="card">
      <h2>Fields</h2>
      <label class="field field-legend"><span>Name</span><input readonly tabindex="-1" value="Annual report" /></label>
      <label class="field field-legend is-field-focus"><span>Focused</span><input readonly tabindex="-1" value="Typing here" /></label>
      <label class="field field-legend is-field-error"><span>With an error</span><input readonly tabindex="-1" value="not-an-email" /><Icon path={mdiAlertCircleOutline} /></label>
      <small class="text-error">Enter a valid email address.</small>
      <label class="field field-legend is-field-success"><span>Confirmed</span><input readonly tabindex="-1" value="maya@fernhill.example" /><Icon path={mdiCheck} /></label>
      <small class="text-success">This address is available.</small>
      <label class="field field-legend is-field-disabled"><span>Disabled</span><input readonly tabindex="-1" value="Locked by admin" /></label>
      <div class="mock-select"><span>Can edit</span><Icon path={mdiChevronDown} /></div>
    </section>

    <section class="card">
      <h2>Choices</h2>
      <div class="choice-grid">
        <span class="choice"><span class="check" role="checkbox" aria-checked="true" aria-label="Checked"></span> Checked</span>
        <span class="choice"><span class="check" role="checkbox" aria-checked="false" aria-label="Unchecked"></span> Unchecked</span>
        <span class="choice is-disabled"><span class="check" data-static aria-hidden="true"></span> Disabled</span>
      </div>
      <div class="choice-grid" role="radiogroup" aria-label="Sample options">
        <button class="radio-row" role="radio" aria-checked="true"><span class="radio"></span> Selected</button>
        <button class="radio-row" role="radio" aria-checked="false"><span class="radio"></span> Other</button>
      </div>
      <div class="choice-grid">
        <span class="choice"><button class="switch" role="switch" aria-checked="true" aria-label="On"></button> On</span>
        <span class="choice"><button class="switch" role="switch" aria-checked="false" aria-label="Off"></button> Off</span>
      </div>
      <h3>Tabs</h3>
      <div class="tabs" role="tablist"><button role="tab" aria-selected="true">Activity</button><button role="tab" aria-selected="false">Sharing</button><button role="tab" aria-selected="false">Versions</button></div>
      <h3>Progress</h3>
      <div class="progress"><span style="width:62%"></span></div>
      <div class="progress progress-gradient"><span style="width:38%"></span></div>
      <div class="loaders"><span class="spinner"></span><span class="skeleton skeleton-a"></span><span class="skeleton skeleton-b"></span></div>
    </section>

    <section class="card">
      <h2>Note cards</h2>
      {notes.map(([kind, icon, text]) => <div class={`notecard note-${kind} note-solo`}><Icon path={icon} /><span>{text}</span></div>)}
      <h3>Toasts</h3>
      {toasts.map(([kind, text]) => <div class={`toast toast-${kind}`}><span>{text}</span><Icon path={mdiClose} size={16} /></div>)}
    </section>

    <section class="card">
      <h2>People and tags</h2>
      <div class="people">{people.map(([initials, label, status]) => <span class="person"><span class="avatar">{initials}<i class={`status status-${status}`}></i></span><small>{label}</small></span>)}</div>
      <div class="tag-row"><span class="tag">Finance</span><span class="tag">Draft</span><span class="tag tag-on">Selected</span><span class="fav-inline"><Icon path={mdiStar} size={18} /></span><span class="muted-star"><Icon path={mdiStarOutline} size={18} /></span></div>
      <h3>Text</h3>
      <p>Body text with a <a class="link">link to a page</a>.</p>
      <p class="text-default">Secondary text, for dates and sizes.</p>
      <p>Search result with a <mark>highlighted word</mark>.</p>
      <p><span class="is-selected">Selected text on the page</span></p>
    </section>

    <section class="card">
      <h2>Menu and tooltip</h2>
      <div class="menu-static">
        <a><Icon path={mdiInformationOutline} /> Open details</a>
        <a class="is-menu-hover"><Icon path={mdiShareVariant} /> Share</a>
        <a><Icon path={mdiDownload} /> Download</a>
        <a><Icon path={mdiPencil} /> Rename</a>
        <hr />
        <a class="danger"><Icon path={mdiDeleteOutline} /> Delete file</a>
      </div>
      <span class="tooltip">Copy link</span>
    </section>

    <section class="card">
      <h2>Dialog</h2>
      <div class="dialog">
        <div class="dialog-head"><strong>Delete this file?</strong><Icon path={mdiClose} /></div>
        <p class="muted-text">Annual report.pdf moves to Deleted files for 30 days.</p>
        <div class="dialog-foot"><button class="btn btn-tertiary">Cancel</button><button class="btn btn-error-solid">Delete</button></div>
      </div>
      <div class="sticky-bar"><span>3 selected</span><button class="btn btn-secondary btn-small"><Icon path={mdiContentCopy} size={16} /> Copy</button></div>
      <div class="fade-list"><p>Older activity</p><p>Older activity</p><span></span></div>
    </section>

    <section class="card">
      <h2>Assistant</h2>
      <div class="assistant-box"><span class="assistant-icon"></span><p>Here is a short summary of the annual report.</p></div>
      <button class="btn btn-assistant"><Icon path={mdiCreationOutline} size={18} /> Generate</button>
      <h3>Page colours</h3>
      <div class="page-sample"><span>Header on the page background</span><img src={light} width="18" height="18" alt="" class="filter-page" /></div>
      <div class="gradient-sample">Primary gradient</div>
      <h3>Older icons</h3>
      <div class="legacy">
        <img src={dark} width="20" height="20" alt="" class="filter-dark" />
        <img src={light} width="20" height="20" alt="" class="filter-bright" />
        <span class="legacy-primary"><img src={light} width="20" height="20" alt="" class="filter-primary-bright" /></span>
        <span class="legacy-primary"><img src={dark} width="20" height="20" alt="" class="filter-primary-dark" /></span>
      </div>
    </section>
  </div></div>
</Shell>
