---
// A made-up company mark; the person's own logo replaces it locally (preview.setLogo).
interface Props { size?: number }
const { size = 30 } = Astro.props;
---
<span class="logo" style={`--logo-size:${size}px`}>
  <svg class="logo-sample" viewBox="0 0 32 32" width={size} height={size} fill="currentColor" aria-hidden="true"><path d="M16 3 3 25.5h6.2L16 14l6.8 11.5H29L16 3Zm0 16.2-3.7 6.3h7.4L16 19.2Z" /></svg>
  <img class="logo-own" alt="" hidden />
</span>
