---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { COMPANY } from './data';
import { mdiBellOutline, mdiDotsGrid, mdiDotsHorizontal, mdiDownload, mdiFolder, mdiCog, mdiMagnify, mdiAccountOutline } from './icons';

// The frame around a Nextcloud page. `public` is the header visitors get on a share link.
interface Props { view: string; app?: string; public?: boolean; shareName?: string }
const { view, app = 'Files', public: isPublic = false, shareName } = Astro.props;
---
<div class="view" data-view-panel={view} hidden>
  <header class="nc-header">
    <Logo />
    {isPublic ? <>
      <strong class="nc-share-name">{shareName}</strong>
      <span class="grow"></span>
      <button class="btn btn-primary"><Icon path={mdiDownload} /> Download</button>
      <button class="header-btn" aria-label="More"><Icon path={mdiDotsHorizontal} /></button>
      <span class="avatar avatar-guest">?</span>
    </> : <>
      <button class="header-btn" aria-label="Apps"><Icon path={mdiDotsGrid} /></button>
      <span class="nc-app"><Icon path={app === 'Files' ? mdiFolder : mdiCog} /> {app}</span>
      <span class="grow nc-search-wrap"><span class="nc-search"><Icon path={mdiMagnify} /> Apps, files, messages, and more <kbd>⌘</kbd><kbd>K</kbd></span></span>
      <button class="header-btn" aria-label="Notifications"><Icon path={mdiBellOutline} /><span class="dot"></span></button>
      <button class="header-btn" aria-label="Contacts"><Icon path={mdiAccountOutline} /></button>
      <span class="avatar" title={COMPANY}>FS</span>
    </>}
  </header>
  <div class="nc-body"><slot /></div>
</div>
